FROM debian:stable-slim

# Provision dev tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    wget \
    rsync \
    gawk \
    bison \
    python3 \
    patchelf \
    ca-certificates \
    git \
    qemu-system-arm \
    sudo

ENV LANG=C
ENV LC_ALL=C

# Provision user.
ARG HOST_UID
ARG HOST_GID
RUN groupdel dialout # Conflicts with macOS.
RUN groupadd --gid $HOST_GID lfs
# The home is not /mnt/lfs, the checkout: what a shell or a tool keeps there (.bash_history) would land in it.
RUN useradd --uid $HOST_UID --no-user-group --groups lfs --create-home lfs
RUN printf '%s\n' 'lfs ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/lfs && chmod 0440 /etc/sudoers.d/lfs

# Create mount points.
RUN mkdir -pv \
    /mnt/lfs/download \
    /mnt/lfs/image \
    /mnt/lfs/install \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/platform \
    /mnt/lfs/profile \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

# Docker copies this ownership into newly created named volumes.
RUN chown lfs:lfs \
    /mnt/lfs \
    /mnt/lfs/download \
    /mnt/lfs/image \
    /mnt/lfs/install \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/platform \
    /mnt/lfs/profile \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

USER lfs
WORKDIR /mnt/lfs
