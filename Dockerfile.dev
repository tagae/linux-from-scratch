FROM debian:stable-slim

ARG HOST_UID
ARG HOST_GID

# Provision user.
RUN groupdel dialout # Conflicts with macOS.
RUN groupadd --gid $HOST_GID lfs
RUN useradd --uid $HOST_UID --no-user-group --groups lfs --home-dir /mnt/lfs --no-create-home lfs

# Provision dev tools.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    wget \
    rsync \
    gawk \
    bison \
    python3 \
    patchelf \
    ca-certificates \
    qemu-system-arm \
    && rm -rf /var/lib/apt/lists/*

# Provision Docker from its own apt repository. Only the client side is needed, as the daemon is the
# host's, reached through the socket that docker-compose.yaml mounts.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc
RUN . /etc/os-release \
    && printf '%s\n' \
    'Types: deb' \
    'URIs: https://download.docker.com/linux/debian' \
    "Suites: $VERSION_CODENAME" \
    'Components: stable' \
    "Architectures: $(dpkg --print-architecture)" \
    'Signed-By: /etc/apt/keyrings/docker.asc' \
    > /etc/apt/sources.list.d/docker.sources
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    docker-ce-cli \
    docker-buildx-plugin \
    docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Create mount points.
RUN mkdir -pv \
    /mnt/lfs/download \
    /mnt/lfs/image \
    /mnt/lfs/install \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

# Docker copies this ownership into newly created named volumes.
RUN chown lfs:lfs \
    /mnt/lfs \
    /mnt/lfs/download \
    /mnt/lfs/image \
    /mnt/lfs/install \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

USER lfs
WORKDIR /mnt/lfs

RUN curl -fsSL https://opencode.ai/v2/install | bash
RUN curl -fsSL https://claude.ai/install.sh | bash

ENV PATH=/mnt/lfs/.opencode/bin:/mnt/lfs/.local/bin:$PATH
