# tests/probes/network.probe -- proves the "network" capability actually
# works end to end on a live guest, not just that its kernel fragment and
# systemd-networkd/-resolved config landed on disk (Stage 1 can't see any
# of this: it has no booted kernel to ask). Three layers, each guarding a
# real regression:
#   1. a DHCP lease actually arrives (QEMU's own slirp server always
#      hands out 10.0.2.15 to the first/only guest -- see
#      docs/design/capabilities.md and network-config.sh's systemd
#      .network file matching "en* eth*").
#   2. mDNS is enabled on the leased link (network-config.sh sets
#      MulticastDNS=yes in BOTH resolved.conf.d and the .network file --
#      either alone leaves it off, so this catches a half-applied config).
#      Checked via `resolvectl status IFACE`'s "Protocols:" line
#      (+mDNS/-mDNS) -- `resolvectl mdns IFACE` with no boolean argument
#      turns out NOT to be a query form in this systemd build (empirically
#      confirmed: it exits 1 with no output at all, bare interface name or
#      not; `status` is the form that actually reports live state).
#   3. a real DNS lookup + HTTP fetch succeeds (systemd-resolved's stub
#      resolver actually forwards to the DHCP-provided nameserver, and
#      egress actually reaches the internet through QEMU's user-mode NAT).
PROBE_KEY=systemd-busybox-virt+network
PROBE_TIMEOUT=180

probe_guest() {
    # Joined with " && " by printf itself, so this is one line with no
    # embedded newlines regardless of how it's wrapped for readability
    # here -- each piece is single-quoted (none contain a literal single
    # quote), so nothing here is host-shell-expanded before it reaches
    # the guest.
    printf '%s && %s && %s && %s' \
        'i=0; while [ $i -lt 15 ]; do ip addr show | grep -q 10.0.2.15 && break; i=$((i + 1)); sleep 1; done; ip addr show | grep -q 10.0.2.15' \
        'IFACE=$(ls /sys/class/net | grep -v "^lo$" | head -1)' \
        'resolvectl status "$IFACE" | grep -q "+mDNS"' \
        '[ "$(wget -qO- http://detectportal.firefox.com/success.txt)" = success ] && echo PROBE_OK_network'
}
