# tests/probes/ninep.probe -- proves the "9p" capability's project share
# actually mounts and is actually readable from inside a booted guest.
# Stage 1 can confirm 9p-config.sh shipped the fstab entry (etc/fstab
# with the "lfs" mount tag), but only a live boot proves the fstab
# generator (systemd) or `mount -a` (busybox) actually acted on it AND
# that QEMU's virtio-9p device on the host side actually served the
# project directory. /mnt/lfs/lfs is this project's own top-level `lfs`
# build script, present because the whole PROJECT_DIR is what's shared
# (see `lfs`'s qemu case, -fsdev local,path=$PROJECT_DIR) -- its presence
# proves the share is really PROJECT_DIR, not an empty/wrong mount.
PROBE_KEY=virt+9p
PROBE_TIMEOUT=180

probe_guest() {
    printf '%s && %s' \
        'mount | grep -q 9p' \
        '[ -f /mnt/lfs/lfs ] && echo PROBE_OK_ninep'
}
