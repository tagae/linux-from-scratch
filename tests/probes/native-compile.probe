# tests/probes/native-compile.probe -- proves self-hosting's central claim
# (docs/design/self-hosting.md): a natively-built gcc, running on this
# project's own natively-built system, can compile and run a program.
#
# Deliberately NOT image/selfhost-virt.img: that image is the OUTPUT of
# the guest's `image build` -- a plain bootable-systemd rootfs, same
# package set as any other build, with no compiler on it at all (offline-
# forensics-checked while writing this probe: no gcc/cc/ld/make anywhere
# under its tree). The native toolchain lives on the BUILDER guest's own
# live root instead -- image/virt+9p+loop.img, the CAPS="9p loop" image
# self-hosting.md describes booting to run the guest system build
# (confirmed offline: /usr/bin/gcc is present and dated from that build,
# delivered there as the native-toolchain archive tarball -- see
# self-hosting.md's "toolchain is delivered, not rebuilt"). PROBE_KEY
# names it directly (virt+9p+loop derives PLATFORM=virt, CAPS="9p loop"
# the same way every other probe's key does -- no special-casing needed).
PROBE_KEY=systemd-virt+9p+loop
PROBE_TIMEOUT=240

probe_guest() {
    # A single-line C program (no embedded newlines needed -- valid C
    # doesn't require them) returning a distinctive, non-trivial exit
    # code, so a compiler that merely "succeeds" without actually
    # producing a working, correctly-linked binary (e.g. silently
    # emitting a no-op / mis-linked stub) would still be caught: only a
    # correctly compiled-and-run binary yields exactly 42.
    printf '%s && %s && %s' \
        'printf "int main(void){return 42;}" > /tmp/hello.c' \
        'gcc -o /tmp/hello /tmp/hello.c' \
        '( /tmp/hello; [ $? -eq 42 ] ) && echo PROBE_OK_native-compile'
}
