#!/usr/bin/expect -f
# E2 + E3 driver: boot the systemd-virt+9p+loop builder guest and run the in-guest
# cross-build (tests/e2e/guest-build.sh) to completion. See
# docs/design/e2e-cross.md. Invoked by tests/e2e/run.sh.
#
# The guest build is driven as a single command that ends in a sentinel,
# matched in OUTPUT — no post-command prompt matching (bash bracketed-paste
# escapes after "# " break that). Login uses the glob "login:" that ./test
# proved reliable (an anchored regex fails: agetty appends a terminal-query
# escape after "login:").
log_user 1

# Big resources: the guest cross-builds glibc/gcc/systemd. Runs under HVF
# (near-native), unlike the pi0 BOOT in keygen.exp which is TCG. (Tcl keeps
# a $var substitution as one word - no shell-style re-splitting - so the
# embedded spaces reach env as single CAPS= / QEMU_EXTRA= arguments.)
set caps   "9p loop"
set qextra "-smp 8 -m 8192"
spawn env PLATFORM=virt INIT=systemd CAPS=$caps QEMU_EXTRA=$qextra ./lfs qemu

set timeout 600
expect {
    "login:" {}
    timeout { puts "\n### FAIL: builder guest no login prompt"; exit 1 }
    eof     { puts "\n### FAIL: builder guest exited before login"; exit 1 }
}
send "root\r"
set timeout 120
expect {
    "Password:" {
        send "root\r"
        expect { -re {[#$] $} {} timeout { puts "\n### FAIL: no shell"; exit 1 } }
    }
    -re {[#$] $} {}
    timeout { puts "\n### FAIL: no password/shell prompt"; exit 1 }
}

# Run the in-guest build; tee a log to the 9p share for post-mortem. Very
# long timeout: a full guest cross-toolchain + pi0 system build under HVF is
# bounded but measured in hours (fast-paths in minutes against a warm guest).
send "sh /mnt/lfs/tests/e2e/guest-build.sh 2>&1 | tee /mnt/lfs/work/e2e-guest-build.log\r"
set timeout 28800
expect {
    -re {E2E_GUEST_BUILD_OK\r}   { puts "\n### E2+E3 guest build OK" }
    -re {E2E_GUEST_BUILD_FAIL}   { puts "\n### FAIL: guest build reported failure"; set failed 1 }
    timeout { puts "\n### FAIL: guest build timed out"; set failed 1 }
    eof     { puts "\n### FAIL: builder guest exited before finishing"; exit 1 }
}

send "systemctl poweroff\r"
set timeout 180
expect { -re {Power down} {} eof {} timeout {} }

if {[info exists failed]} { exit 1 }
puts "\n### builder.exp done"
