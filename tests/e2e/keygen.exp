#!/usr/bin/expect -f
# E4 driver: boot the guest-cross-built pi0 image on the host and generate a
# keypair with SEPARATE encryption and authentication subkeys, proving the
# guest-built arm GnuPG runs. See docs/design/e2e-cross.md. Invoked by
# tests/e2e/run.sh. (Proven interactively 2026-07-26.)
#
# The pi0 boots under TCG (slow, single ARMv6 core). The keygen is ONE
# compound command whose verdict is a ''-split sentinel matched in OUTPUT,
# so no post-command prompt matching (which bash bracketed-paste escapes
# break). Login uses the glob "login:" ./test proved reliable. No detached
# signing (that hangs gpg-agent on the serial console, see
# tests/probes/gnupg-keygen.probe) - keygen + subkey structure only.
log_user 1

# The guest-built kernel/dtb sit at the canonical work/boot/systemd-pi0/ (guest-
# build.sh copies them there, superseding any container baseline), so the
# default WORK_DIR just works.
spawn env PLATFORM=pi0 ./lfs qemu image/e2e-pi0.img

set timeout 600
expect {
    "login:" {}
    timeout { puts "\n### FAIL: pi0 no login prompt"; exit 1 }
    eof     { puts "\n### FAIL: pi0 exited before login"; exit 1 }
}
send "root\r"
set timeout 120
expect {
    "Password:" {
        send "root\r"
        expect { -re {[#$] $} {} timeout { puts "\n### FAIL: no shell"; exit 1 } }
    }
    -re {[#$] $} {}
    timeout { puts "\n### FAIL: no password/shell prompt"; exit 1 }
}

# primary(cert) + cv25519 encryption subkey + ed25519 authentication subkey,
# then dump --with-colons between CBEGIN/CEND, then the verdict sentinel
# (CAPSTONE_OK only if one sub has capability `e` AND another has `a`).
send "GNUPGHOME=\$(mktemp -d); export GNUPGHOME; gpg --batch --pinentry-mode loopback --passphrase '' --quick-generate-key 'E2E <e2e@pi0>' ed25519 cert 0 && FPR=\$(gpg --list-keys --with-colons | awk -F: '/^fpr:/{print \$10; exit}') && gpg --batch --pinentry-mode loopback --passphrase '' --quick-add-key \$FPR cv25519 encr && gpg --batch --pinentry-mode loopback --passphrase '' --quick-add-key \$FPR ed25519 auth; echo CBEG''IN; gpg --list-keys --with-colons; echo CEN''D; E=\$(gpg --list-keys --with-colons | awk -F: '\$1==\"sub\"&&\$12~/e/'); A=\$(gpg --list-keys --with-colons | awk -F: '\$1==\"sub\"&&\$12~/a/'); if \[ -n \"\$E\" \] && \[ -n \"\$A\" \]; then echo CAPSTONE''_OK; else echo CAPSTONE''_FAIL; fi\r"

set timeout 900
expect {
    -re {CAPSTONE_OK\r}   { puts "\n### E4 CAPSTONE VERIFIED: separate encr + auth subkeys" }
    -re {CAPSTONE_FAIL\r} { puts "\n### FAIL: missing an encr or auth subkey"; set failed 1 }
    timeout { puts "\n### FAIL: keygen timed out"; set failed 1 }
    eof     { puts "\n### FAIL: pi0 exited before keygen verdict"; exit 1 }
}

send "systemctl poweroff\r"
set timeout 180
expect { -re {Power down} {} eof {} timeout {} }

if {[info exists failed]} { exit 1 }
puts "\n### keygen.exp done"
