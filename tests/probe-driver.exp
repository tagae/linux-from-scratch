#!/usr/bin/expect -f
# tests/probe-driver.exp -- boots ONE image, sends ONE self-powering-off
# guest command chain, and matches ONE success marker. This is the whole
# trick that keeps Stage 2 probes reliable: every extra expect/send round
# trip is another chance for the prompt-resync hangs that plagued earlier,
# chattier attempts at this (see `test`'s own log_user comment for the
# console-escape-echo half of that story). One login, one command line,
# one marker, one eof.
#
# Usage: probe-driver.exp IMAGE MARKER CHAIN_FILE
#   IMAGE       absolute path to the disk image to boot -- passed straight
#               to `./lfs qemu IMAGE` (see `lfs`'s qemu case).
#   MARKER      the exact string the guest chain echoes on success, e.g.
#               PROBE_OK_network (see tests/probes.sh).
#   CHAIN_FILE  path to a file holding the already-assembled guest shell
#               command line: a probe's probe_guest() output with
#               "; sync; poweroff" appended by tests/probes.sh. Read from
#               a FILE, not embedded in this script, so it's sent to the
#               guest as plain POSIX sh, verbatim -- expect's own $-
#               interpolation never touches it, which sidesteps the
#               \$-escaping trap entirely.
#
# PLATFORM/INIT/CAPS (and anything a capability's QEMU wiring needs, e.g.
# USB_DISK -- see `lfs`'s qemu case) must already be exported by the
# caller: `./lfs qemu` reads them itself, the same convention `test` uses.
# PROBE_TIMEOUT (seconds) overrides the default per-phase timeout, same
# spirit as `test`'s own TEST_TIMEOUT.
#
# Exit codes: 0 = marker seen and guest self-powered-off cleanly;
# 10 = no login prompt / login failed; 11 = timeout waiting for the
# marker or for the post-marker poweroff; 12 = QEMU exited before the
# marker appeared; 1 = bad usage.

if {[llength $argv] != 3} {
    puts "Usage: probe-driver.exp IMAGE MARKER CHAIN_FILE"
    exit 1
}
set image      [lindex $argv 0]
set marker     [lindex $argv 1]
set chain_file [lindex $argv 2]

set chain_fh [open $chain_file r]
set chain [read $chain_fh]
close $chain_fh
# The chain file may carry a trailing newline (most editors/printf add
# one); strip it so exactly one line reaches the guest -- an extra blank
# line sent afterward is harmless to a shell, but trimming keeps the
# transcript (and this script's own reasoning about "one send, one line")
# honest.
set chain [string trimright $chain "\r\n"]

set timeout [expr {[info exists env(PROBE_TIMEOUT)] ? $env(PROBE_TIMEOUT) : 180}]

# See `test`'s own comment on log_user 0 -- the same guest console
# escape-sequence-echo hazard (cursor-position/window-size queries
# answered too late by a real terminal) applies here.
log_user 0

spawn ./lfs qemu $image

expect {
    "login:" { }
    timeout   { puts "\nFAIL: timed out waiting for login prompt"; exit 10 }
    eof       { puts "\nFAIL: QEMU exited before login prompt"; exit 10 }
}

send "root\r"

expect {
    "Password:" {
        send "root\r"
        expect {
            -re {[#$] $} { }
            timeout { puts "\nFAIL: timed out after password"; exit 10 }
            eof     { puts "\nFAIL: QEMU exited after password"; exit 10 }
        }
    }
    -re {[#$] $} { }
    timeout { puts "\nFAIL: timed out after username"; exit 10 }
    eof     { puts "\nFAIL: QEMU exited after username"; exit 10 }
}

# One logical line, sent PACED: $chain is plain POSIX sh assembled by
# tests/probes.sh (probe_guest()'s output + "; sync; poweroff"). It is
# never Tcl-interpolated -- it came from a file, not an inline Tcl
# string -- so any "$" it contains (command substitutions, positional
# params, whatever a probe's guest chain needs) reaches the guest's shell
# completely unmolested.
#
# send -s (slow), not a plain send: a plain send blasts the entire line
# at the emulated console in one write, and past a few hundred bytes the
# console's input buffer overruns and silently DROPS characters mid-line
# -- confirmed the hard way against the ~1 KB gnupg-keygen chain, whose
# transcript showed the command truncated partway through (leaving an
# unterminated quote -> the guest shell sat at a PS2 "> " continuation
# prompt forever, never running the chain, never emitting the marker).
# Shorter chains (this project's other probes, all <400 bytes) happened
# to squeak under the overrun threshold, which is exactly why this stayed
# hidden until the longest one. send_slow pushes the line in small bursts
# with a brief pause between each, so the guest drains its buffer and no
# character is ever lost -- a few tens of ms total for a 1 KB line, and
# it makes the "one line, one send" contract actually robust rather than
# merely usually-lucky. Applies to the trailing \r too, harmlessly.
set send_slow {64 0.05}
send -s -- "$chain\r"

# CRITICAL: the marker must be matched as a REAL, freshly-printed output
# line, not as a substring of the terminal's own echo of what we just
# typed. A tty in canonical mode echoes input back as it's received --
# so the literal text "... && echo $marker; sync; poweroff" appears in
# the stream almost immediately after send, well before the guest chain
# has actually run (let alone succeeded). Matching bare $marker against
# that would make EVERY probe pass regardless of whether its assertions
# actually held -- confirmed the hard way, writing this driver: an
# intentionally-broken guest assertion still "passed" near-instantly,
# because expect matched the echoed command line itself. Anchoring on a
# newline immediately AFTER the marker rules that out: in the echoed
# input, $marker is followed by "; sync; poweroff" (no newline) since the
# whole chain is one line; only a real `echo $marker` actually executing
# emits $marker immediately followed by its own trailing newline.
# \r*\n, not \r?\n: this console's line endings are not a clean \r\n --
# confirmed empirically (od/cat -v on a captured transcript) they arrive
# as $marker\r\r\n, i.e. TWO carriage returns before the real newline.
# \r?  (zero-or-one) silently never matched that, which manifested as
# every probe "timing out"/hitting eof right after its real, successful
# marker line had already been printed -- a second, equally real bug
# found the hard way while chasing the first one above.
expect {
    -re "$marker\r*\n" { }
    timeout { puts "\nFAIL: timed out waiting for marker '$marker'"; exit 11 }
    eof     { puts "\nFAIL: QEMU exited before marker '$marker' appeared"; exit 12 }
}

# The guest's own "; sync; poweroff" tail is what ends the session --
# wait for QEMU to actually exit rather than trusting the marker alone
# (a marker seen just before a hang-on-shutdown would otherwise still
# read as a clean pass).
expect {
    eof     { }
    timeout { puts "\nFAIL: timed out waiting for QEMU to exit after poweroff"; exit 11 }
}

puts "PASS: marker '$marker' observed, guest powered off cleanly"
exit 0
