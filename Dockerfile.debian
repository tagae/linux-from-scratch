FROM debian:12-slim

RUN apt update
RUN apt install -y \
    m4 make \
    patch grep sed gawk perl texinfo \
    bison gcc g++ \
    tar bzip2 xz-utils \
    coreutils diffutils findutils \
    git wget rsync \
    python3 \
    file strace patchelf

COPY lfs /var/lfs/lfs
COPY lib /var/lfs/lib
COPY package /var/lfs/package
