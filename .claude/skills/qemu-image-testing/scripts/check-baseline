#!/bin/sh
# Runs the standard boot check (check-boot.cmd) and compares it with the recorded baseline of that
# system, so that "nothing new at warning level" is a diff and not a judgement.
#
# Usage: check-baseline [--save] KEY ["EXTRA QEMU ARGS"]
#   --save   record this run as the baseline of KEY (baselines/KEY.txt): do it for a known-good system
# Timestamps and process ids are removed before comparing. Prints "baseline OK" or the diff
# (`<` recorded, `>` this run). Without a baseline it prints the run and says how to save one.
# A baseline belongs to one key and the extra arguments it was recorded with (a stick adds a line).
set -eu
here=$(cd "$(dirname "$0")" && pwd)
save=no
if [ "${1:-}" = --save ]; then save=yes; shift; fi
key=${1:?Usage: check-baseline [--save] KEY [EXTRA QEMU ARGS]}
extra=${2:-}
file=$here/../baselines/$key.txt
now=$(mktemp "${TMPDIR:-/tmp}/baseline.XXXXXX")
trap 'rm -f "$now"' EXIT
"$here/qemu-check" "$key" "$extra" "$(cat "$here/check-boot.cmd")" \
    | sed -E 's/^\[ *[0-9]+\.[0-9]+\] //; s/^[A-Z][a-z]{2} [ 0-9]{2} [0-9:]{8} //; s/\[[0-9]+\]:/[]:/' > "$now"
if [ $save = yes ]; then
    mkdir -p "$(dirname "$file")"
    cp "$now" "$file"
    echo "saved $file"
elif [ ! -f "$file" ]; then
    cat "$now"
    echo "(no baseline for $key: check-baseline --save $key records this run)" >&2
elif diff "$file" "$now"; then
    echo "baseline OK ($key)"
else
    exit 1
fi
