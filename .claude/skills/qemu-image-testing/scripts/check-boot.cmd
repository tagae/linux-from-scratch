echo "state: $(systemctl is-system-running)"; systemctl --failed --no-pager --plain --no-legend | { n=0; while read -r _; do n=$((n+1)); done; echo "failed units: $n"; }; echo "--- dmesg, warnings and worse"; { dmesg --level=emerg,alert,crit,err,warn 2>/dev/null || journalctl -k -b --no-pager -p warning -o cat; } | while IFS= read -r l; do echo "${l:0:170}"; done; echo "--- journal, warnings and worse, not the kernel"; journalctl -b --no-pager -p warning | while IFS= read -r l; do case $l in *" kernel: "*) ;; *) echo "${l:0:200}" ;; esac; done
