#!/bin/sh

# The version of this project, as SemVer: `MAJOR.MINOR.PATCH` on the commit of a git tag of that
# name (annotated, with no prefix), as long as the tree is clean. Anywhere else, the version is a
# pre-release of the next one, named by the abbreviated hash of the top commit, as short as git
# finds unambiguous (`0.2.0-2c03742`), and ending in `-dirty` if the tree differs from its commit
# (`0.2.0-2c03742-dirty`). A hash of digits alone that starts with 0, which SemVer does not allow in
# a number, takes an "r" for revision (`0.2.0-r0123456`). The next version is that of the most
# recent tag, 0.0.0 if there is none, raised by the headlines of the commits since it
# (CONTRIBUTING.md, Versions and Commits). The highest bump among them applies, and sets the parts
# after it to 0:
#
#    feat!: and drop!:    the major version
#    feat: and drop:      the minor version
#    fix: and perf:       the patch
#    any other type       nothing: with only those, the pre-release is of the next patch
#
# Without git, there is no version.
#
# Usage: bin/version [--next]    --next: the next version, which bin/release tags; it fails if no
#                                commit makes one

set -o errexit -o nounset

cd "$(dirname "$0")/.."

git rev-parse --git-dir > /dev/null 2>&1 || exit 1

tag=$(git describe --tags --abbrev=0 --match '[0-9]*.[0-9]*.[0-9]*' 2> /dev/null || true)
last=${tag:-0.0.0}
range=${tag:+$tag..}HEAD

# The bump that the commits make: 3 the major version, 2 the minor, 1 the patch, 0 none.
level=$(git log --format=%s "$range" | awk '
    function raise(l) { if (l > level) level = l }
    /^(feat|drop)!: / { raise(3); next }
    /^(feat|drop): / { raise(2); next }
    /^(fix|perf): / { raise(1) }
    END { print level + 0 }')

# The version that a bump of the last version makes.
next() {
    major=${last%%.*}
    rest=${last#*.}
    minor=${rest%%.*}
    patch=${rest#*.}
    case $1 in
        3) major=$((major + 1)) minor=0 patch=0 ;;
        2) minor=$((minor + 1)) patch=0 ;;
        *) patch=$((patch + 1)) ;;
    esac
    echo "$major.$minor.$patch"
}

case "${1:-}" in
    '')
        dirty=$(git status --porcelain)
        top=$(git rev-parse HEAD)
        # A clean tree on the commit of the tag is the tag's release.
        if [ -n "$tag" ] && [ -z "$dirty" ] && [ "$(git rev-list -n 1 "$tag")" = "$top" ]; then
            echo "$tag"
            exit 0
        fi
        # Whatever else is on the way to the next release, which is at least a patch. SemVer has no
        # leading zero in a number, which a hash of digits alone is: it takes an "r", for revision.
        hash=$(git rev-parse --short "$top")
        case $hash in
            *[!0-9]*) ;;
            0*) hash=r$hash ;;
        esac
        version=$(next "$level")-$hash
        [ -z "$dirty" ] || version=$version-dirty
        echo "$version"
        ;;
    --next)
        [ "$level" -gt 0 ] || {
            echo "No commit since ${tag:-the start} makes a release" >&2
            exit 1
        }
        next "$level"
        ;;
    *)
        echo "Usage: $0 [--next]" >&2
        exit 2
        ;;
esac
