#!/bin/sh

# Prints the current project version in SemVer formate.
#
# When not in the `main` branch, the version is a pre-release of the next one, named by the
# abbreviated hash of the top commit, and ending in `-dirty` if the tree differs from its commit
# (`0.2.0-2c03742-dirty`). The next version is calculated by bumping the most recent tag, according
# to the commits more recent than the tag.
#
# Usage: bin/version [--next]    --next: the next version, which bin/release tags

set -o errexit -o nounset

cd "$(dirname "$0")/.."

[ -e .git ] || {
    echo 'The project must be versioned by Git.' >&2
    exit 1
}

command -v git > /dev/null 2>&1 || {
    echo 'The `git` command is needed to tell the version of a checkout.' >&2
    exit 2
}

# Git reads the project configuration, not the user's, so that it behaves the same for everyone,
# and trusts the checkout, whose directory a container can show as another user's.
export GIT_CONFIG_GLOBAL=$PWD/bin/gitconfig GIT_CONFIG_SYSTEM=/dev/null

git rev-parse --git-dir > /dev/null

tag=$(git describe --tags --abbrev=0 --match '[0-9]*.[0-9]*.[0-9]*' 2> /dev/null || true)
last=${tag:-0.0.0}
range=${tag:+$tag..}HEAD

# The bump that the commits make: 3 the major version, 2 the minor, 1 the patch, 0 none.
level=$(git log --format=%s "$range" | awk '
    function raise(l) { if (l > level) level = l }
    $1 ~ /^(Drop|Stop|Major)$/ { raise(3); next }
    $1 ~ /^(Add|Start|Minor)$/ { raise(2); next }
    $1 ~ /^(Fix|Optimize|Refactor|Patch)$/ { raise(1) }
    END { print level + 0 }')

# The version that a bump of the last version makes.
next() {
    major=${last%%.*}
    rest=${last#*.}
    minor=${rest%%.*}
    patch=${rest#*.}
    case $1 in
        3) major=$((major + 1)) minor=0 patch=0 ;;
        2) minor=$((minor + 1)) patch=0 ;;
        *) patch=$((patch + 1)) ;;
    esac
    echo "$major.$minor.$patch"
}

case "${1:-}" in
    '')
        dirty=$(git status --porcelain)
        top=$(git rev-parse HEAD)
        # A clean tree on the commit of the tag is the tag's release.
        if [ -n "$tag" ] && [ -z "$dirty" ] && [ "$(git rev-list -n 1 "$tag")" = "$top" ]; then
            echo "$tag"
            exit 0
        fi
        # Whatever else is on the way to the next release, which is at least a patch.
        hash=r$(git rev-parse --short "$top")
        version=$(next "$level")-$hash
        [ -z "$dirty" ] || version=$version-dirty
        echo "$version"
        ;;
    --next)
        [ "$level" -gt 0 ] || {
            echo "No commit since ${tag:-the start}" >&2
            exit 1
        }
        next "$level"
        ;;
    *)
        echo "Usage: $0 [--next]" >&2
        exit 3
        ;;
esac
