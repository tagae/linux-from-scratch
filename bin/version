#!/bin/sh

# Prints the version of the project's tree, in SemVer format (CONTRIBUTING.md, Versions and Commits).
#
# A clean tree on the commit of the most recent tag has the tag's version. Any other is a
# pre-release of the next version, named by `r` and the abbreviated hash of the top commit, and
# ending in `-dirty` if the tree differs from its commit (`0.2.0-r2c03742-dirty`). The next version
# is the most recent tag, bumped by the commits since it.
#
# Usage: bin/version [--next]    --next: the next version, which bin/release tags

set -o errexit -o nounset

cd "$(dirname "$0")/.."

[ -e .git ] || {
    echo 'The project must be versioned by Git.' >&2
    exit 1
}

command -v git > /dev/null 2>&1 || {
    echo 'The `git` command is needed to tell the version of a checkout.' >&2
    exit 2
}

# Git reads the project's configuration (bin/gitconfig), not the user's.
export GIT_CONFIG_GLOBAL=$PWD/bin/gitconfig GIT_CONFIG_SYSTEM=/dev/null

git rev-parse --git-dir > /dev/null

tag=$(git describe --tags --abbrev=0 --match '[0-9]*.[0-9]*.[0-9]*' 2> /dev/null || true)
last=${tag:-0.0.0}
range=${tag:+$tag..}HEAD

# The bump that the commits make, from the type that starts their summary lines (`feat:`,
# `drop!:`; see docs/commit-messages.md): 3 the major version (feat!, drop!), 2 the minor (feat), 1
# the patch (fix, upgrade, perf, refactor), 0 none (any other type).
level=$(git log --format=%s "$range" | awk '
    function raise(l) { if (l > level) level = l }
    $1 == "feat!:" || $1 == "drop!:" { raise(3); next }
    $1 == "feat:" { raise(2); next }
    $1 == "fix:" || $1 == "upgrade:" || $1 == "perf:" || $1 == "refactor:" { raise(1) }
    END { print level + 0 }')

# The version that a bump of the last version makes.
next() {
    major=${last%%.*}
    rest=${last#*.}
    minor=${rest%%.*}
    patch=${rest#*.}
    case $1 in
        3) major=$((major + 1)) minor=0 patch=0 ;;
        2) minor=$((minor + 1)) patch=0 ;;
        *) patch=$((patch + 1)) ;;
    esac
    echo "$major.$minor.$patch"
}

case "${1:-}" in
    '')
        dirty=$(git status --porcelain)
        top=$(git rev-parse HEAD)
        # A clean tree on the commit of the tag is the tag's release.
        if [ -n "$tag" ] && [ -z "$dirty" ] && [ "$(git rev-list -n 1 "$tag")" = "$top" ]; then
            echo "$tag"
            exit 0
        fi
        # Whatever else is on the way to the next release, which is at least a patch.
        hash=r$(git rev-parse --short "$top")
        version=$(next "$level")-$hash
        [ -z "$dirty" ] || version=$version-dirty
        echo "$version"
        ;;
    --next)
        [ "$level" -gt 0 ] || {
            echo "No commit since ${tag:-the start}" >&2
            exit 1
        }
        next "$level"
        ;;
    *)
        echo "Usage: $0 [--next]" >&2
        exit 3
        ;;
esac
