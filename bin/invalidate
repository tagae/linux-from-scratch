#!/bin/sh
#
# Deletes stale package archives.
#
# Archives record the state of the tree they were built from, in archive/<key>/.commit, and what
# changed since decides which of them to drop. Each key has a record of its own, so that archives
# that come from different places (CI restores the tools' from a cache apart from the profile's)
# keep the state that each was built from. That state is HEAD, or a commit of the working tree
# (uncommitted and new files included, ignored ones not) when it differs from HEAD, which
# refs/lfs/archive keeps from being collected. The packages built against one that changed are not
# dropped with it: the rules below name the package alone.
#
# Layout: archive/<key>/<package>[-<variant>]-<version>[-<revision>][-<component>].tar.xz, next to
# a .tar.xz.sha256. <package> is the path of the recipe under package/ without .sh, so that
# python/click is archive/<key>/python/click-<version>.tar.xz. The key is the name of the profile
# (pi0-pgp) for the toolchain and everything that the profile installs. The key is tools for the
# build tools, which every profile shares (-bootstrap- and -tools- in the name), except those that a
# profile installs, which are filed under its key.
#
# Only the inputs of the build can make an archive stale: lfs, lib/, package/, profile/ and
# platform/. Every other path (the Makefile, documentation, check/, .github/, .claude/, the
# Dockerfiles, docker-compose.yaml, bin/, ...) has no effect. With --docker, for the archives of the build
# through Docker Compose, Dockerfile.bootstrap, Dockerfile.scratch and docker-compose.yaml are
# inputs too, which drop every archive, as they make the machines that every package is built on.
# Every input path that changed between archive/<key>/.commit and the tree now is mapped by the
# first rule that fits:
#
#    1  lib/check.sh, lib/image.sh, lib/qemu.sh and lib/sbom.sh: no effect (nothing in them goes into
#       an archive). The Makefile has none either, as it holds no input of an archive: the release
#       that ends up in os-release is lfs's.
#    2  package/<path>: the archive/*/<recipe>-* of the recipe that the path belongs to. That is
#       the path itself when it is a recipe, existing or deleted (package/python/cffi.sh is
#       python/cffi, not python), else the longest directory of the path that has a recipe now
#       (package/python/yubikey-manager/usr/bin/ykman is python/yubikey-manager, and
#       package/linux/usb.config is linux, the kernel). A path that belongs to no recipe falls to
#       rule 8.
#    3  profile/<p>.sh: the archives under the key <p> of the packages that the profile installs,
#       which a change of its options or its order can affect. The toolchain, which it does not
#       name, stays.
#    4  lib/<c>.sh, the helpers of a package category <c> (a directory of package/ that holds
#       recipes now): everything under archive/*/<c>/.
#    5  lib/meson.sh: rule 2 for each recipe that calls meson_cross_file.
#    6  lib/system.sh: every archive but the build tools (-bootstrap- and -tools- in the name).
#    7  platform/<p>.sh: everything under the key of each profile that runs on the platform.
#    8  Any other input (lfs, lib/base.sh, lib/package.sh, lib/components.sh, lib/tools.sh, other
#       paths of profile/, platform/ and lib/): every archive, which makes a build from scratch.
#
# A pattern like archive/*/make-* also drops make-ca-*, as a rebuild of a few archives too many is
# cheaper than a stale one. download/ is never touched, as what it holds is checked by hash.
#
# Without archive/<key>/.commit, or with one that names a commit that this clone lacks (a shallow
# clone, or rewritten history), nothing says what the key's archives were built from: they all go.
# A CI checkout therefore fetches the whole history. Leftover *.tmp files of an interrupted archive
# step go in any case. The script ends by recording the state of the tree in the .commit of every
# key (the tools', each profile's, and any other directory of archive/), for the next run.

set -o errexit -o nounset

# Usage: bin/invalidate [--docker]
docker=
case ${1:-} in
    --docker) docker=yes ;;
    '') ;;
    *) echo "Usage: $0 [--docker]" >&2; exit 2 ;;
esac

# The paths of git and of the rules are those of the repository, wherever the script is run from.
cd "$(dirname "$0")/.."

# git reads the project's configuration, not the user's, so that it behaves the same for everyone,
# and trusts the checkout, whose directory a container can show as another user's.
export GIT_CONFIG_GLOBAL=$PWD/bin/gitconfig GIT_CONFIG_SYSTEM=/dev/null

readonly archive_dir=archive

# Prints the state of the tree: HEAD, or a commit of the working tree when that differs from it. The
# tree is made in an index of its own, which `add -A` fills as the working tree is, leaving out what
# git ignores.
tree_state() {
    local dir index tree
    dir=$(mktemp -d)
    index=$dir/index
    GIT_INDEX_FILE=$index git read-tree HEAD
    GIT_INDEX_FILE=$index git add -A
    tree=$(GIT_INDEX_FILE=$index git write-tree)
    rm -rf "$dir"
    if [ "$tree" = "$(git rev-parse 'HEAD^{tree}')" ]; then
        git rev-parse HEAD
    else
        GIT_AUTHOR_NAME=lfs GIT_AUTHOR_EMAIL=lfs@localhost \
            GIT_COMMITTER_NAME=lfs GIT_COMMITTER_EMAIL=lfs@localhost \
            git commit-tree --no-gpg-sign -p HEAD -m 'Working tree of the archives' "$tree"
    fi
}

state=$(tree_state)
readonly state

# The archives to delete, as lines of "<kind> <argument>" that stale() reads: all, package <recipe>,
# category <name>, profile <name>, profile_package <name> <recipe> and system.
selectors=
removed=0

# Runs a command on each line of the standard input, with the line as its last argument. The input
# comes from a here-document, as the commands run in this shell and set variables: both sides of a
# pipe run in a subshell.
each() {
    local line
    while read -r line; do
        [ -z "$line" ] || "$@" "$line"
    done
}

# Adds a selection of archives, with the reason for it.
select_archives() {
    echo "$1"
    selectors="$selectors
$2 ${3:-}"
}

# Deletes a file.
remove() {
    echo "    delete $1"
    rm -f -- "$1"
    removed=$((removed + 1))
}

# Succeeds when the selection includes the file at the given path, relative to the archive
# directory.
stale() {
    local key="${1%%/*}" name="${1#*/}" kind arg
    while read -r kind arg; do
        case $kind in
        all)
            return 0
            ;;
        package)
            # The name is anchored: the package python/cffi leaves python-* alone, and python leaves
            # python/cffi-* alone.
            case $name in "$arg"-*) return 0 ;; esac
            ;;
        category)
            case $name in "$arg"/*) return 0 ;; esac
            ;;
        profile)
            case $key in "$arg") return 0 ;; esac
            ;;
        profile_package)
            # The argument is the profile, then the recipe, anchored as for package.
            [ "$key" = "${arg%% *}" ] || continue
            case $name in "${arg#* }"-*) return 0 ;; esac
            ;;
        system)
            case ${name##*/} in
            *-bootstrap-*|*-tools-*) ;;
            *) return 0 ;;
            esac
            ;;
        esac
    done <<EOF
$selectors
EOF
    return 1
}

remove_if_stale() {
    if stale "${1#"$archive_dir"/}"; then
        remove "$1"
    fi
}

# Prints the recipe that a path under package/ belongs to, or nothing. A file with the suffix .sh
# is a recipe, as the files that packages ship have none.
recipe_of() {
    local rel="${1#package/}" dir
    case $rel in
    *.sh)
        echo "${rel%.sh}"
        return
        ;;
    esac
    dir=$rel
    while [ "$dir" != "${dir%/*}" ]; do
        dir=${dir%/*}
        if git cat-file -e "$state:package/$dir.sh" 2>/dev/null; then
            echo "$dir"
            return
        fi
    done
}

# Succeeds when a name is a package category: a directory of package/ that holds recipes.
is_category() {
    git ls-tree --name-only "$state" "package/$1/" 2>/dev/null | grep -q '\.sh$'
}

# Rule 3, for a recipe that the profile installs: a line of the loop in select_changed.
select_profile_package() {
    select_archives "profile/$profile.sh: rule 3, archives of $1 in $profile" \
        profile_package "$profile $1"
}

# Rule 8, for a path of profile/: the profile is selected if it runs on the platform that
# changed.
select_profile_of_platform() {
    local profile=${1#profile/}
    profile=${profile%.sh}
    [ "${profile%%-*}" != "$platform" ] \
        || select_archives "platform/$platform.sh: rule 7, archives of the profile $profile" \
            profile "$profile"
}

# Rule 5, for a line of the output of git grep.
select_meson_recipe() {
    local recipe
    recipe=$(recipe_of "${1#"$state":}")
    [ -z "$recipe" ] \
        || select_archives "lib/meson.sh: rule 5, archives of $recipe" package "$recipe"
}

# Maps a path that changed to the archives that it makes stale.
select_changed() {
    local path=$1 name callers
    case $path in
    lib/check.sh|lib/image.sh|lib/qemu.sh|lib/sbom.sh)
        echo "$path: rule 1, no effect"
        ;;
    package/*)
        name=$(recipe_of "$path")
        if [ -n "$name" ]; then
            select_archives "$path: rule 2, archives of $name" package "$name"
        else
            select_archives "$path: rule 8, in no recipe: every archive" all
        fi
        ;;
    profile/[!/]*.sh)
        profile=${path#profile/}
        profile=${profile%.sh}
        # The recipes that the profile installs, as its lines call lfs_system_install,
        # lfs_install_package (with a component after #) or lfs_tools_install. grep fails when
        # nothing matches.
        names=$(git show "$state:$path" 2>/dev/null \
            | grep -Eo '(lfs_system_install|lfs_install_package|lfs_tools_install) [^ #;)]+' \
            | sed 's/^[^ ]* //' | sort -u || true)
        each select_profile_package <<EOF
$names
EOF
        ;;
    lib/meson.sh)
        # git grep fails when nothing matches.
        callers=$(git grep -l -F meson_cross_file "$state" -- package || true)
        each select_meson_recipe <<EOF
$callers
EOF
        ;;
    lib/system.sh)
        select_archives "$path: rule 6, every archive but the build tools" system
        ;;
    platform/[!/]*.sh)
        platform=${path#platform/}
        platform=${platform%.sh}
        profiles=$(git ls-tree --name-only "$state" profile/)
        each select_profile_of_platform <<EOF
$profiles
EOF
        ;;
    lib/[!/]*.sh)
        name=${path#lib/}
        name=${name%.sh}
        if is_category "$name"; then
            select_archives "$path: rule 4, archives of the category $name" category "$name"
        else
            select_archives "$path: rule 8, every archive" all
        fi
        ;;
    lfs|lib/*|profile/*|platform/*)
        select_archives "$path: rule 8, every archive" all
        ;;
    Dockerfile.bootstrap|Dockerfile.scratch|docker-compose.yaml)
        if [ -n "$docker" ]; then
            select_archives "$path: the build's containers, every archive" all
        else
            echo "$path: no effect"
        fi
        ;;
    *)
        # Not an input of the build.
        echo "$path: no effect"
        ;;
    esac
}

# Drops the archives of a key that the changes since its record make stale, and records the state
# of the tree as theirs. What the key's archives were built from decides, so the selection is the
# key's alone.
invalidate_key() {
    local key=$1 files built= changed commit_file
    commit_file=$archive_dir/$key/.commit
    mkdir -p "$archive_dir/$key"
    selectors=
    files=$(find "$archive_dir/$key" -type f \( -name '*.tar.xz' -o -name '*.tar.xz.sha256' \) | sort)
    if [ -z "$files" ]; then
        echo "$archive_dir/$key holds no archive"
    else
        [ ! -f "$commit_file" ] || built=$(cat "$commit_file")
        case $built in
        '')
            select_archives "$commit_file is missing: every archive of $key" all
            ;;
        *[!0-9a-f]*)
            select_archives "$commit_file does not hold a commit: every archive of $key" all
            ;;
        *)
            if git rev-parse --verify --quiet "$built^{commit}" >/dev/null; then
                echo "archives of $key built from $built, the tree is $state"
                # Without renames, both the old and the new path of a moved file show.
                changed=$(git diff --no-renames --name-only "$built" "$state")
                each select_changed <<EOF
$changed
EOF
            else
                select_archives "$commit_file names $built, not in this clone: every archive of $key" all
            fi
            ;;
        esac
        if [ -n "$selectors" ]; then
            each remove_if_stale <<EOF
$files
EOF
        fi
    fi
    echo "$state" > "$commit_file"
}

mkdir -p "$archive_dir"

# Left by an archive step that was interrupted before it moved the archive into place.
leftovers=$(find "$archive_dir" -type f -name '*.tmp' | sort)
each remove <<EOF
$leftovers
EOF

# The keys that archives can be filed under: the tools', each profile's, and the directories that
# exist, which a profile that is gone may have left. A key whose directory is not there yet gets its
# record all the same, as the build that fills it comes next.
keys=$(
    {
        echo tools
        git ls-tree --name-only "$state" profile/ | sed -n 's|^profile/\(.*\)\.sh$|\1|p'
        for key_dir in "$archive_dir"/*/; do
            [ ! -d "$key_dir" ] || basename "$key_dir"
        done
    } | sort -u
)
each invalidate_key <<EOF
$keys
EOF

echo "deleted $removed files"

git update-ref refs/lfs/archive "$state"
