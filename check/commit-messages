#!/bin/sh

# Checks that each commit since the last version tag follows docs/commit-messages.md: the summary
# line is `<type>: <subject>`, of a type that the document lists, with a subject that starts with a
# lowercase imperative verb; it has at most 72 characters and no sentence-ending period; a blank
# line follows it; and the other lines have at most 72 characters, unless they hold a URL, code
# (indented, or fenced) or other atypical text. bin/version derives the next version from the type
# of each summary line. Merges, reverts, fixups and squashes are left alone.
#
# The mood of the verb is checked as far as a script can tell: it must not end in -ed or -ing, nor
# be the third person of one of the recommended verbs (adds, fixes...).
#
# With no tag, the whole history is checked.
#
# Usage, from the repository root: check/commit-messages [RANGE] (`make commit-lint`)
#        check/commit-messages --message FILE    for a commit-msg hook: the message in FILE
#                                                (git config core.hooksPath check/hooks)

set -o errexit -o nounset

# What the message on the standard input gets wrong, a line for each.
problems() {
    awk '
        BEGIN {
            types = " feat feat! fix perf refactor drop drop! docs style test build ci chore conf "
            verbs = " add drop fix bump make start stop remove move rename use keep leave let give"
            verbs = verbs " name set split install build run pin patch update document refactor "
        }
        function report(text) { print "    " text }
        NR == 1 {
            summary = $0
            if (length(summary) > 72)
                report("the summary has " length(summary) " characters: keep it within 72")
            if (!match(summary, /^[^ :]+: /)) {
                report("the summary is not <type>: <subject>")
                next
            }
            type = substr(summary, 1, RLENGTH - 2)
            if (!index(types, " " type " "))
                report("the summary has an unknown type: " type)
            summary = substr(summary, RLENGTH + 1)
            if (summary !~ /^[a-z]/)
                report("the subject does not start with a lowercase letter")
            last = summary
            sub(/^.* /, "", last)
            if (summary ~ /\.$/ && last !~ /\..*\.$/)
                report("the summary ends with a sentence-ending period")
            word = summary
            sub(/ .*$/, "", word)
            wrong = 0
            if (word ~ /ing$/ && word != "bring") wrong = 1
            else if (word ~ /ed$/ && word !~ /eed$/ && word != "embed") wrong = 1
            else if (word ~ /s$/) {
                plain = word
                sub(/s$/, "", plain)
                stem = word
                sub(/es$/, "", stem)
                if (index(verbs, " " plain " ") || index(verbs, " " stem " ")) wrong = 1
            }
            if (wrong)
                report("the summary does not start with an imperative verb: " word)
            next
        }
        NR == 2 && $0 != "" { report("the second line is not blank") }
        /^(```|~~~)/ { fenced = !fenced; next }
        fenced || /:\/\// || /^    / || /^\t/ { next }
        length($0) > 72 { report("line " NR " has " length($0) " characters: wrap it at 72") }
    '
}

usage_error() {
    echo "Usage: $0 [RANGE | --message FILE]" >&2
    exit 2
}

if [ "${1:-}" = --message ]; then
    [ $# -eq 2 ] || usage_error
    # What git keeps of the file: no comment lines, nor what follows the scissors, nor blank lines
    # at the start.
    message=$(awk '/^# -+ >8 -+$/ { exit } /^#/ { next } { print }' "$2" | sed '/./,$!d')
    case $message in
        Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
    esac
    found=$(printf '%s\n' "$message" | problems)
    [ -z "$found" ] || {
        echo "The commit message does not follow docs/commit-messages.md:" >&2
        echo "$found" >&2
        exit 1
    }
    exit 0
fi

[ $# -le 1 ] || usage_error
[ -d .git ] || [ -f .git ] || {
    echo "Run $0 from the repository root" >&2
    exit 2
}
command -v git > /dev/null 2>&1 || {
    echo "git is needed to read the commit messages" >&2
    exit 2
}

# git reads the project's configuration, not the user's, so that it behaves the same for everyone,
# and trusts the checkout, whose directory a container can show as another user's.
export GIT_CONFIG_GLOBAL=$PWD/bin/gitconfig GIT_CONFIG_SYSTEM=/dev/null

# A repository that git cannot read is an error, not a repository with no tags.
git rev-parse --git-dir > /dev/null

range=${1:-}
if [ -z "$range" ]; then
    tag=$(git describe --tags --abbrev=0 --match '[0-9]*.[0-9]*.[0-9]*' 2> /dev/null || true)
    range=${tag:+$tag..}HEAD
fi

failed=
for commit in $(git rev-list --reverse "$range"); do
    case $(git log -1 --format=%s "$commit") in
        Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) continue ;;
    esac
    found=$(git log -1 --format=%B "$commit" | problems)
    [ -z "$found" ] || {
        git log -1 --format='%h %s' "$commit"
        echo "$found"
        failed=yes
    }
done
[ -z "$failed" ] || {
    echo "These commit messages do not follow docs/commit-messages.md" >&2
    exit 1
}
