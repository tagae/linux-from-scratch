FROM alpine:3.22.1

RUN apk update

RUN apk add \
    build-base texinfo git rsync bison gawk python3 grep flex openssl-dev xz meson \
    sfdisk multipath-tools btrfs-progs dosfstools

ARG HOST_UID
ARG HOST_GID
RUN delgroup dialout && addgroup -g $HOST_GID lfs && adduser -D -H -u $HOST_UID -G lfs lfs

RUN mkdir -pv /var/lfs/tools /var/lfs/source /var/lfs/work /var/lfs/install
RUN chown lfs:lfs /var/lfs /var/lfs/tools /var/lfs/source /var/lfs/work /var/lfs/install

WORKDIR /var/lfs

USER lfs
