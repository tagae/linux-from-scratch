FROM alpine:3.22.1

RUN apk update

# Build tools
RUN apk add build-base
RUN apk add texinfo
RUN apk add git
RUN apk add rsync
RUN apk add bison
RUN apk add gawk
RUN apk add python3
RUN apk add grep
#RUN apk add make
RUN apk add flex
#RUN apk add gmp-dev
#RUN apk add mpfr-dev
#RUN apk add mpc1-dev

# Filesystem tools
RUN apk add sfdisk
RUN apk add multipath-tools
RUN apk add btrfs-progs
RUN apk add dosfstools
