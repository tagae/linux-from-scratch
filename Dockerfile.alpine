FROM alpine:3.22.1

RUN apk update

RUN apk add build-base linux-headers texinfo git rsync bison gawk python3 grep flex openssl-dev xz
RUN apk add sfdisk multipath-tools btrfs-progs dosfstools
RUN apk add ncurses ncurses-dev meson gperf ninja py3-jinja2
RUN apk add coreutils util-linux findutils
RUN apk add ripgrep wget pkgconf bzip2 sudo
# Build scripts use 'env bash' — wrapper that delegates to sh (busybox applet name detection prevents symlinking)
RUN printf '#!/bin/sh\nexec /bin/sh "$@"\n' > /usr/bin/bash && chmod +x /usr/bin/bash
RUN echo 'lfs ALL=(root) NOPASSWD: /sbin/losetup,/usr/sbin/kpartx,/sbin/sfdisk,/sbin/mkfs.btrfs,/sbin/mkfs.fat,/bin/mount,/bin/umount,/sbin/btrfs,/usr/bin/fallocate,/bin/cp,/bin/mkdir,/bin/tar' > /etc/sudoers.d/lfs && chmod 440 /etc/sudoers.d/lfs
RUN apk add qemu-system-arm qemu-system-aarch64

ARG HOST_UID
ARG HOST_GID
RUN delgroup dialout
RUN addgroup -g $HOST_GID lfs && adduser -D -H -u $HOST_UID -G lfs lfs

RUN mkdir -pv /var/lfs/download /var/lfs/tools /var/lfs/source /var/lfs/work /var/lfs/install /var/lfs/image
RUN chown lfs:lfs /var/lfs /var/lfs/download /var/lfs/tools /var/lfs/source /var/lfs/work /var/lfs/install /var/lfs/image

# Source code is copied into the image rather than bind-mounted.
# Colima cannot bind-mount individual files, and non-root bind-mount reads
# fail for directory mounts too. `docker compose run --build` keeps these in sync.
COPY lfs /var/lfs/lfs
COPY lib /var/lfs/lib
COPY package /var/lfs/package
RUN chmod +x /var/lfs/lfs && chown -R lfs:lfs /var/lfs/lfs /var/lfs/lib /var/lfs/package

WORKDIR /var/lfs

USER lfs
