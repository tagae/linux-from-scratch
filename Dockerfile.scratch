# Linux From Scratch
FROM scratch

ARG HOST_UID
ARG HOST_GID

# Bake these empty directories.
#COPY --chown=$HOST_UID:$HOST_GID work/bootstrap/empty/ /mnt/lfs/install/

# Enable execution of the #!/bin/sh and #!/bin/bash shebangs.
COPY work/bootstrap/bash /bin/sh
COPY work/bootstrap/bash /bin/bash

ENV LC_ALL=POSIX
ENV PATH=/mnt/lfs/tools/usr/bin
ENV HOME=/mnt/lfs

# There is no /tmp in this image, and nothing can create one at build time, so TMPDIR at an
# already-existing writable directory.
ENV TMPDIR=/mnt/lfs/work/tmp

# No /etc/passwd exists in this image, so USER must be numeric —a name would require a passwd
# lookup. Match the bootstrap user UID/GID so file ownership on the shared volumes lines up.
USER $HOST_UID:$HOST_GID
WORKDIR /mnt/lfs

# Once the container starts, mounted paths can be used.
CMD ["/mnt/lfs/tools/usr/bin/bash"]
