wget 1.25.0 calls SSLv3_client_method, which OpenSSL 4.0 does not provide and does not guard with
OPENSSL_NO_SSL3_METHOD. SSLv3 is deprecated and insecure regardless, so the dead code path goes.

--- a/src/openssl.c
+++ b/src/openssl.c
@@ -227,7 +227,6 @@
 
     case secure_protocol_sslv3:
 #ifndef OPENSSL_NO_SSL3_METHOD
-      meth = SSLv3_client_method ();
 #endif
       break;
 
