# Terminal utilities: clear and reset, which write terminal escape sequences, and resize, which
# asks the terminal for its size.
#
# Left out: chvt, deallocvt, fgconsole, kbd_mode, loadfont, loadkmap, dumpkmap, openvt,
# setconsole, setfont, setkeycodes, setlogcons and showkey drive virtual terminals (VT), which the
# kernels do not have: the console is a virtio or serial port.

# --- Applets ---
CONFIG_CLEAR=y
CONFIG_RESET=y
CONFIG_RESIZE=y

# --- Options (BusyBox's defaults) ---
CONFIG_FEATURE_RESIZE_PRINT=y
