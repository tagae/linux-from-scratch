# The runit supervision suite: every applet of the category. It works on directories and FIFOs
# alone.

# --- Applets ---
CONFIG_CHPST=y
CONFIG_ENVDIR=y
CONFIG_ENVUIDGID=y
CONFIG_RUNSV=y
CONFIG_RUNSVDIR=y
CONFIG_SETUIDGID=y
CONFIG_SOFTLIMIT=y
CONFIG_SV=y
CONFIG_SVC=y
CONFIG_SVLOGD=y
CONFIG_SVOK=y

# --- Options (BusyBox's defaults) ---
CONFIG_SV_DEFAULT_SERVICE_DIR="/var/service"
