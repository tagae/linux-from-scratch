# Processes and system status, read from /proc.
#
# Left out: sysctl reads /proc/sys (PROC_SYSCTL) and powertop reads timer statistics
# (TIMER_STATS).

# --- Applets ---
CONFIG_FREE=y
CONFIG_FUSER=y
CONFIG_IOSTAT=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_KILLALL5=y
CONFIG_LSOF=y
CONFIG_MINIPS=y
CONFIG_MPSTAT=y
CONFIG_NMETER=y
CONFIG_PGREP=y
CONFIG_PIDOF=y
CONFIG_PKILL=y
CONFIG_PMAP=y
CONFIG_PS=y
CONFIG_PSTREE=y
CONFIG_PWDX=y
CONFIG_SMEMCAP=y
CONFIG_TOP=y
CONFIG_UPTIME=y
CONFIG_VMSTAT=y
CONFIG_WATCH=y

# --- Options (BusyBox's defaults) ---
CONFIG_FEATURE_PIDOF_OMIT=y
CONFIG_FEATURE_PIDOF_SINGLE=y
CONFIG_FEATURE_PS_ADDITIONAL_COLUMNS=y
CONFIG_FEATURE_PS_TIME=y
CONFIG_FEATURE_SHOW_THREADS=y
CONFIG_FEATURE_TOPMEM=y
CONFIG_FEATURE_TOP_CPU_GLOBAL_PERCENTS=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FEATURE_TOP_DECIMALS=y
CONFIG_FEATURE_TOP_INTERACTIVE=y
CONFIG_FEATURE_TOP_SMP_CPU=y
CONFIG_FEATURE_TOP_SMP_PROCESS=y
