# The init system: PID 1, which starts the actions of /etc/inittab, and the commands that power
# off and restart the machine, which signal it.

# --- Applets ---
CONFIG_HALT=y
CONFIG_INIT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y

# --- Options (BusyBox's defaults) ---
CONFIG_FEATURE_INIT_MODIFY_CMDLINE=y
CONFIG_FEATURE_INIT_QUIET=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_WAIT_FOR_INIT=y
CONFIG_INIT_TERMINAL_TYPE="linux"
