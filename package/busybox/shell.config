# The shell: ash, which is /bin/sh and the shell of the accounts, and cttyhack, which gives a
# process a controlling terminal.

# --- Applets ---
# ash is the system shell: /bin/sh, and the shell of the accounts.
CONFIG_SH_IS_ASH=y
# No bash applet.
CONFIG_BASH_IS_NONE=y
CONFIG_ASH=y
CONFIG_CTTYHACK=y

# --- Options (BusyBox's defaults) ---
CONFIG_ASH_ALIAS=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_BASH_NOT_FOUND_HOOK=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_HELP=y
CONFIG_ASH_IDLE_TIMEOUT=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_MAIL=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_RANDOM_SUPPORT=y
CONFIG_ASH_TEST=y
CONFIG_FEATURE_SH_EMBEDDED_SCRIPTS=y
CONFIG_FEATURE_SH_EXTRA_QUIET=y
CONFIG_FEATURE_SH_HISTFILESIZE=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_SH_MATH_BASE=y
CONFIG_FEATURE_SH_READ_FRAC=y
