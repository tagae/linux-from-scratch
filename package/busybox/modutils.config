# Kernel modules: every applet of the category, for the modules that the kernel's MODULES option
# loads.

# --- Applets ---
CONFIG_DEPMOD=y
CONFIG_INSMOD=y
CONFIG_LSMOD=y
CONFIG_MODINFO=y
CONFIG_MODPROBE=y
CONFIG_RMMOD=y

# --- Options (BusyBox's defaults) ---
CONFIG_DEFAULT_DEPMOD_FILE="modules.dep"
CONFIG_DEFAULT_MODULES_DIR="/lib/modules"
CONFIG_FEATURE_CMDLINE_MODULE_OPTIONS=y
CONFIG_FEATURE_MODPROBE_SMALL_CHECK_ALREADY_LOADED=y
CONFIG_MODPROBE_SMALL=y
