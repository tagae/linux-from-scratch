# MIME messages: makemime and reformime, which work on files and pipes.
#
# Left out: popmaildir and sendmail talk to a mail server over a connection (NET).

# --- Applets ---
CONFIG_MAKEMIME=y
CONFIG_REFORMIME=y

# --- Options (BusyBox's defaults) ---
CONFIG_FEATURE_MIME_CHARSET="us-ascii"
CONFIG_FEATURE_REFORMIME_COMPAT=y
