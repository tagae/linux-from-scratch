# Miscellaneous utilities that need no hardware or kernel option beyond what the systems have.
#
# Left out: beep and conspy (VT), devfsd (devfs), devmem (DEVMEM), fbsplash (framebuffers), the
# flash, NAND and UBI tools (MTD), hdparm, lsscsi and raidautorun (ATA, SCSI and MD), the i2c
# tools (I2C), man (the systems have no manual pages), mim (embedded scripts), mt (tape drives),
# rfkill (RFKILL), runlevel (utmp), setserial (serial ports), volname (CD-ROMs) and watchdog
# (WATCHDOG).

# --- Applets ---
CONFIG_ADJTIMEX=y
CONFIG_ASCII=y
CONFIG_BBCONFIG=y
CONFIG_BC=y
CONFIG_CHAT=y
CONFIG_CROND=y
CONFIG_CRONTAB=y
CONFIG_DC=y
CONFIG_GETFATTR=y
CONFIG_HEXEDIT=y
CONFIG_INOTIFYD=y
CONFIG_LESS=y
CONFIG_MAKEDEVS=y
CONFIG_MICROCOM=y
CONFIG_PARTPROBE=y
CONFIG_READAHEAD=y
CONFIG_RX=y
CONFIG_SEEDRNG=y
CONFIG_SETFATTR=y
CONFIG_STRINGS=y
CONFIG_TIME=y
CONFIG_TREE=y
CONFIG_TS=y
CONFIG_TTYSIZE=y

# --- Options (BusyBox's defaults) ---
CONFIG_FEATURE_BC_INTERACTIVE=y
CONFIG_FEATURE_BC_LONG_OPTIONS=y
CONFIG_FEATURE_CHAT_CLR_ABORT=y
CONFIG_FEATURE_CHAT_IMPLICIT_CR=y
CONFIG_FEATURE_CHAT_NOFAIL=y
CONFIG_FEATURE_CHAT_SEND_ESCAPES=y
CONFIG_FEATURE_CHAT_SWALLOW_OPTS=y
CONFIG_FEATURE_CHAT_VAR_ABORT_LEN=y
CONFIG_FEATURE_COMPRESS_BBCONFIG=y
CONFIG_FEATURE_CROND_D=y
CONFIG_FEATURE_CROND_DIR="/var/spool/cron"
CONFIG_FEATURE_CROND_SPECIAL_TIMES=y
CONFIG_FEATURE_DC_BIG=y
CONFIG_FEATURE_LESS_ASK_TERMINAL=y
CONFIG_FEATURE_LESS_BRACKETS=y
CONFIG_FEATURE_LESS_DASHCMD=y
CONFIG_FEATURE_LESS_ENV=y
CONFIG_FEATURE_LESS_FLAGS=y
CONFIG_FEATURE_LESS_LINENUMS=y
CONFIG_FEATURE_LESS_MARKS=y
CONFIG_FEATURE_LESS_MAXLINES=9999999
CONFIG_FEATURE_LESS_RAW=y
CONFIG_FEATURE_LESS_REGEXP=y
CONFIG_FEATURE_LESS_TRUNCATE=y
CONFIG_FEATURE_LESS_WINCH=y
CONFIG_FEATURE_MAKEDEVS_TABLE=y

# --- Options that differ from BusyBox's defaults ---
# The system has no sendmail applet to send the output of jobs with.
# CONFIG_FEATURE_CROND_CALL_SENDMAIL is not set
