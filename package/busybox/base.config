# BusyBox configuration that every system gets, before the categories of applets that its profile
# names in `applets`. allnoconfig turns every option off, so each option a system needs is listed,
# with its reason: the options of BusyBox's libraries and the installation of the applets. The
# options of an applet are in the file of its category, with BusyBox's defaults for the options
# that the system can use.

# --- Applet links ---
# Relative symbolic links for the applets, which "make install" makes with this option.
CONFIG_INSTALL_APPLET_SYMLINKS=y

# --- Options (BusyBox's defaults) ---
CONFIG_BUSYBOX=y
CONFIG_DESKTOP=y
CONFIG_FEATURE_COMPRESS_USAGE=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_EDITING_HISTORY=200
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_EDITING_WINCH=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_FEATURE_NON_POSIX_CP=y
CONFIG_FEATURE_PIDFILE=y
CONFIG_FEATURE_REVERSE_SEARCH=y
CONFIG_FEATURE_RTMINMAX=y
CONFIG_FEATURE_RTMINMAX_USE_LIBC_DEFINITIONS=y
CONFIG_FEATURE_SHOW_SCRIPT=y
CONFIG_FEATURE_SUID=y
CONFIG_FEATURE_SUID_CONFIG=y
CONFIG_FEATURE_SUID_CONFIG_QUIET=y
CONFIG_FEATURE_SYSLOG=y
CONFIG_FEATURE_SYSLOG_INFO=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_USERNAME_COMPLETION=y
CONFIG_FEATURE_USE_SENDFILE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_FEATURE_VERSION=y
CONFIG_FLOAT_DURATION=y
CONFIG_IOCTL_HEX2STR_ERROR=y
CONFIG_LAST_SUPPORTED_WCHAR=767
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_MONOTONIC_SYSCALL=y
CONFIG_PID_FILE_PATH="/var/run"
CONFIG_SHA1_HWACCEL=y
CONFIG_SHA256_HWACCEL=y
CONFIG_SHOW_USAGE=y
CONFIG_STACK_OPTIMIZATION_386=y
CONFIG_SUBST_WCHAR=63
CONFIG_TIME64=y
CONFIG_UNICODE_SUPPORT=y
