# Console login and accounts: getty, login, su, sulogin, passwd and the commands that edit
# /etc/passwd, /etc/group and /etc/shadow.
#
# Left out: vlock locks a virtual terminal (VT).

# --- Applets ---
CONFIG_ADDGROUP=y
CONFIG_ADDUSER=y
CONFIG_ADD_SHELL=y
CONFIG_CHPASSWD=y
CONFIG_CRYPTPW=y
CONFIG_DELGROUP=y
CONFIG_DELUSER=y
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_MKPASSWD=y
CONFIG_PASSWD=y
CONFIG_REMOVE_SHELL=y
CONFIG_SU=y
CONFIG_SULOGIN=y

# --- Options (BusyBox's defaults) ---
CONFIG_FEATURE_ADDUSER_TO_GROUP=y
CONFIG_FEATURE_DEL_USER_FROM_GROUP=y
CONFIG_FEATURE_NOLOGIN=y
CONFIG_FEATURE_PASSWD_WEAK_CHECK=y
CONFIG_FEATURE_SECURETTY=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_FEATURE_SU_CHECKS_SHELLS=y
CONFIG_FEATURE_SU_SYSLOG=y
CONFIG_FIRST_SYSTEM_ID=100
CONFIG_LAST_ID=60000
CONFIG_LAST_SYSTEM_ID=999
CONFIG_LOGIN_SCRIPTS=y
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y

# --- Options that differ from BusyBox's defaults ---
# The password check uses the C library's crypt(3), whose SHA-512 hash (musl's has it) checks root's
# $6$ hash. BusyBox's own crypt would be used otherwise.
# CONFIG_USE_BB_CRYPT is not set
# New passwords are hashed with SHA-512, like those of useradd and the image's regular account.
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
