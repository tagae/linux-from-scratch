# Archives and compression. They work on files and pipes alone.
#
# Left out: dpkg, dpkg-deb, rpm and rpm2cpio (the system has no packages of those formats), and
# lzop, lzopcat and unlzop (nothing the system holds or makes uses lzop).

# --- Applets ---
CONFIG_AR=y
CONFIG_BUNZIP2=y
CONFIG_BZCAT=y
CONFIG_BZIP2=y
CONFIG_CPIO=y
CONFIG_GUNZIP=y
CONFIG_GZIP=y
CONFIG_LZCAT=y
CONFIG_LZMA=y
CONFIG_TAR=y
CONFIG_UNCOMPRESS=y
CONFIG_UNLZMA=y
CONFIG_UNXZ=y
CONFIG_UNZIP=y
CONFIG_XZ=y
CONFIG_XZCAT=y
CONFIG_ZCAT=y

# --- Options (BusyBox's defaults) ---
CONFIG_BZIP2_SMALL=8
CONFIG_FEATURE_AR_CREATE=y
CONFIG_FEATURE_AR_LONG_FILENAMES=y
CONFIG_FEATURE_BZIP2_DECOMPRESS=y
CONFIG_FEATURE_CPIO_IGNORE_DEVNO=y
CONFIG_FEATURE_CPIO_O=y
CONFIG_FEATURE_CPIO_P=y
CONFIG_FEATURE_CPIO_RENUMBER_INODES=y
CONFIG_FEATURE_GUNZIP_LONG_OPTIONS=y
CONFIG_FEATURE_GZIP_DECOMPRESS=y
CONFIG_FEATURE_GZIP_LONG_OPTIONS=y
CONFIG_FEATURE_SEAMLESS_BZ2=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_LZMA=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_FROM=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y
CONFIG_FEATURE_TAR_NOPRESERVE_TIME=y
CONFIG_FEATURE_TAR_OLDGNU_COMPATIBILITY=y
CONFIG_FEATURE_TAR_OLDSUN_COMPATIBILITY=y
CONFIG_FEATURE_TAR_TO_COMMAND=y
CONFIG_FEATURE_TAR_UNAME_GNAME=y
CONFIG_FEATURE_UNZIP_BZIP2=y
CONFIG_FEATURE_UNZIP_CDF=y
CONFIG_FEATURE_UNZIP_LZMA=y
CONFIG_FEATURE_UNZIP_XZ=y
