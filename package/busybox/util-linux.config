# Block devices, mounting, and system utilities that need no kernel option beyond what the systems
# have: mount and umount, blkid, fdisk, dmesg and the process tools.
#
# Left out: the tools of file systems that the kernels lack, mke2fs, mkfs.ext2, mkfs.minix,
# fsck.minix, mkfs.reiser, mkfs.vfat and mkdosfs, and little used ones: fsfreeze, rdev, and hd and
# xxd, as hexdump dumps files.
#
# Left out: acpid (INPUT), eject (CD-ROMs), fatattr (FAT), fbset (framebuffers), fdformat, fdflush
# and freeramdisk (floppies and RAM disks), hwclock and rtcwake (RTC_INTF_DEV), ipcs and ipcrm
# (SYSVIPC), last and wall (utmp), linux32 and linux64 (32-bit compatibility), losetup
# (BLK_DEV_LOOP), lsusb (USB), mdev and uevent (hotplug and NET), mkswap, swapon and swapoff
# (SWAP), nsenter and unshare (NAMESPACES), rdate (NET), readprofile (PROFILING), script and
# scriptreplay (UNIX98_PTYS), and switch_root and run-init (BLK_DEV_INITRD).

# --- Applets ---
CONFIG_BLKDISCARD=y
CONFIG_BLKID=y
CONFIG_BLOCKDEV=y
CONFIG_CAL=y
CONFIG_CHRT=y
CONFIG_DMESG=y
CONFIG_FALLOCATE=y
CONFIG_FDISK=y
CONFIG_FINDFS=y
CONFIG_FLOCK=y
CONFIG_FSTRIM=y
CONFIG_GETOPT=y
CONFIG_HEXDUMP=y
CONFIG_IONICE=y
CONFIG_LSBLK=y
CONFIG_LSPCI=y
CONFIG_MESG=y
CONFIG_MORE=y
CONFIG_MOUNT=y
CONFIG_MOUNTPOINT=y
CONFIG_NOLOGIN=y
CONFIG_PIVOT_ROOT=y
CONFIG_RENICE=y
CONFIG_REV=y
CONFIG_SETARCH=y
CONFIG_SETPRIV=y
CONFIG_SETSID=y
CONFIG_TASKSET=y
CONFIG_UMOUNT=y
CONFIG_UUIDGEN=y

# --- Options (BusyBox's defaults) ---
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_FEATURE_DMESG_PRETTY=y
CONFIG_FEATURE_FDISK_ADVANCED=y
CONFIG_FEATURE_FDISK_BLKSIZE=y
CONFIG_FEATURE_FDISK_WRITABLE=y
CONFIG_FEATURE_GETOPT_LONG=y
CONFIG_FEATURE_MESG_ENABLE_ONLY_GROUP=y
CONFIG_FEATURE_MOUNT_FAKE=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_FSTAB=y
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_FEATURE_MOUNT_OTHERTAB=y
CONFIG_FEATURE_MOUNT_VERBOSE=y
CONFIG_FEATURE_SETPRIV_CAPABILITIES=y
CONFIG_FEATURE_SETPRIV_CAPABILITY_NAMES=y
CONFIG_FEATURE_SETPRIV_DUMP=y
CONFIG_FEATURE_TASKSET_CPULIST=y
CONFIG_FEATURE_TASKSET_FANCY=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_FEATURE_VOLUMEID_BTRFS=y
CONFIG_VOLUMEID=y

# --- Options that differ from BusyBox's defaults ---
# blkid and mount (by label or UUID) recognise the file systems that the kernels have, btrfs alone,
# in place of the 26 that BusyBox knows: its other FEATURE_VOLUMEID_* options are off.
# The kernels have no loop devices (BLK_DEV_LOOP).
# CONFIG_FEATURE_MOUNT_LOOP is not set
# CONFIG_FEATURE_MOUNT_LOOP_CREATE is not set
# The kernels have no network file systems (NET).
# CONFIG_FEATURE_MOUNT_CIFS is not set
