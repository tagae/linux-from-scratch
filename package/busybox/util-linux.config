# Block devices, mounting, and system utilities that need no kernel option beyond what the systems
# have: mount and umount, blkid, fdisk, the mkfs tools (which make file systems on files and
# devices), dmesg and the process tools.
#
# Left out: acpid (INPUT), eject (CD-ROMs), fatattr (FAT), fbset (framebuffers), fdformat, fdflush
# and freeramdisk (floppies and RAM disks), hwclock and rtcwake (RTC_INTF_DEV), ipcs and ipcrm
# (SYSVIPC), last and wall (utmp), linux32 and linux64 (32-bit compatibility), losetup
# (BLK_DEV_LOOP), lsusb (USB), mdev and uevent (hotplug and NET), mkswap, swapon and swapoff
# (SWAP), nsenter and unshare (NAMESPACES), rdate (NET), readprofile (PROFILING), script and
# scriptreplay (UNIX98_PTYS), and switch_root and run-init (BLK_DEV_INITRD).

# --- Applets ---
CONFIG_BLKDISCARD=y
CONFIG_BLKID=y
CONFIG_BLOCKDEV=y
CONFIG_CAL=y
CONFIG_CHRT=y
CONFIG_DMESG=y
CONFIG_FALLOCATE=y
CONFIG_FDISK=y
CONFIG_FINDFS=y
CONFIG_FLOCK=y
CONFIG_FSCK_MINIX=y
CONFIG_FSFREEZE=y
CONFIG_FSTRIM=y
CONFIG_GETOPT=y
CONFIG_HD=y
CONFIG_HEXDUMP=y
CONFIG_IONICE=y
CONFIG_LSBLK=y
CONFIG_LSPCI=y
CONFIG_MESG=y
CONFIG_MKDOSFS=y
CONFIG_MKE2FS=y
CONFIG_MKFS_EXT2=y
CONFIG_MKFS_MINIX=y
CONFIG_MKFS_REISER=y
CONFIG_MKFS_VFAT=y
CONFIG_MORE=y
CONFIG_MOUNT=y
CONFIG_MOUNTPOINT=y
CONFIG_NOLOGIN=y
CONFIG_PIVOT_ROOT=y
CONFIG_RDEV=y
CONFIG_RENICE=y
CONFIG_REV=y
CONFIG_SETARCH=y
CONFIG_SETPRIV=y
CONFIG_SETSID=y
CONFIG_TASKSET=y
CONFIG_UMOUNT=y
CONFIG_UUIDGEN=y
CONFIG_XXD=y

# --- Options (BusyBox's defaults) ---
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_FEATURE_DMESG_PRETTY=y
CONFIG_FEATURE_FDISK_ADVANCED=y
CONFIG_FEATURE_FDISK_BLKSIZE=y
CONFIG_FEATURE_FDISK_WRITABLE=y
CONFIG_FEATURE_GETOPT_LONG=y
CONFIG_FEATURE_MESG_ENABLE_ONLY_GROUP=y
CONFIG_FEATURE_MINIX2=y
CONFIG_FEATURE_MOUNT_FAKE=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_FSTAB=y
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_FEATURE_MOUNT_OTHERTAB=y
CONFIG_FEATURE_MOUNT_VERBOSE=y
CONFIG_FEATURE_SETPRIV_CAPABILITIES=y
CONFIG_FEATURE_SETPRIV_CAPABILITY_NAMES=y
CONFIG_FEATURE_SETPRIV_DUMP=y
CONFIG_FEATURE_TASKSET_CPULIST=y
CONFIG_FEATURE_TASKSET_FANCY=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_FEATURE_VOLUMEID_BCACHE=y
CONFIG_FEATURE_VOLUMEID_BTRFS=y
CONFIG_FEATURE_VOLUMEID_CRAMFS=y
CONFIG_FEATURE_VOLUMEID_EROFS=y
CONFIG_FEATURE_VOLUMEID_EXFAT=y
CONFIG_FEATURE_VOLUMEID_EXT=y
CONFIG_FEATURE_VOLUMEID_F2FS=y
CONFIG_FEATURE_VOLUMEID_FAT=y
CONFIG_FEATURE_VOLUMEID_HFS=y
CONFIG_FEATURE_VOLUMEID_ISO9660=y
CONFIG_FEATURE_VOLUMEID_JFS=y
CONFIG_FEATURE_VOLUMEID_LFS=y
CONFIG_FEATURE_VOLUMEID_LINUXRAID=y
CONFIG_FEATURE_VOLUMEID_LINUXSWAP=y
CONFIG_FEATURE_VOLUMEID_LUKS=y
CONFIG_FEATURE_VOLUMEID_MINIX=y
CONFIG_FEATURE_VOLUMEID_NILFS=y
CONFIG_FEATURE_VOLUMEID_NTFS=y
CONFIG_FEATURE_VOLUMEID_OCFS2=y
CONFIG_FEATURE_VOLUMEID_REISERFS=y
CONFIG_FEATURE_VOLUMEID_ROMFS=y
CONFIG_FEATURE_VOLUMEID_SQUASHFS=y
CONFIG_FEATURE_VOLUMEID_SYSV=y
CONFIG_FEATURE_VOLUMEID_UBIFS=y
CONFIG_FEATURE_VOLUMEID_UDF=y
CONFIG_FEATURE_VOLUMEID_XFS=y
CONFIG_VOLUMEID=y

# --- Options that differ from BusyBox's defaults ---
# The kernels have no loop devices (BLK_DEV_LOOP).
# CONFIG_FEATURE_MOUNT_LOOP is not set
# CONFIG_FEATURE_MOUNT_LOOP_CREATE is not set
# The kernels have no network file systems (NET).
# CONFIG_FEATURE_MOUNT_CIFS is not set
