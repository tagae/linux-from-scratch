# which and start-stop-daemon.
#
# Left out: run-parts (nothing runs a directory of scripts) and pipe_progress (it only draws
# the progress of a pipe).

# --- Applets ---
CONFIG_START_STOP_DAEMON=y
CONFIG_WHICH=y

# --- Options (BusyBox's defaults) ---
CONFIG_FEATURE_START_STOP_DAEMON_FANCY=y
CONFIG_FEATURE_START_STOP_DAEMON_LONG_OPTIONS=y
