# Kernel configuration for zeroing every page and heap object when it is freed, so that the keys and
# passphrases that programs hold in memory do not outlive them in free memory. Every allocation
# pays for it, which is why hardening.config leaves out the matching zeroing on allocation: a system
# that handles secrets names this capability.

# --- Memory initialization ---
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
