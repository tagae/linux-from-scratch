# Kernel configuration for the opt-in "usb" capability (CAPS=usb): USB
# host stack + mass storage + vfat, for the air-gapped GPG key-to-USB
# persistence workflow (see SELF-HOST.md and GNUPG-YUBIKEY.md). Not part
# of any platform's default kernel — a build with CAPS unset gets none of
# this.
#
# Both USB host controllers are enabled so this ONE fragment serves every
# platform: xHCI/PCI is what QEMU's virt machine models (see lfs's qemu
# case — usb-storage attaches to a qemu-xhci controller there, this
# increment's proof target); DWC2 is the BCM2835 SoC's own OTG controller
# the pi0 platform will need to attach a real/emulated USB stick in a
# later increment (dwc2 QEMU/hardware attach is explicitly out of scope
# here — see SELF-HOST.md). An unused HCD driver simply never binds to any
# hardware present on a given machine — harmless dead weight on virt, not
# a functional risk.

# --- USB core ---
# USB_SUPPORT is a menuconfig bool gating the whole drivers/usb/Kconfig
# tree behind an "if USB_SUPPORT" block — allnoconfig forces it (like
# every menu-gating parent this project has hit before: NETDEVICES/
# NET_CORE in network.config, NETWORK_FILESYSTEMS in 9p.config) to n, and
# KCONFIG_ALLCONFIG cannot force a *child* symbol on while its own gating
# parent stays off. Confirmed in the resolved .config (see SELF-HOST.md/
# this increment's report): without this line, USB_STORAGE/XHCI/DWC2 all
# silently stayed unset despite being listed below.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y

# --- xHCI (virt: QEMU's PCI-attached qemu-xhci device — see lfs's qemu case) ---
# USB_XHCI_PCI itself `depends on USB_PCI` (drivers/usb/Kconfig) — a
# SEPARATE bool, also `default y` upstream, also zeroed by allnoconfig
# (same trap as USB_SUPPORT above, one menu level deeper: found by
# grepping the resolved .config, which had USB_XHCI_HCD=y but no
# USB_XHCI_PCI line AT ALL — not even "is not set" — meaning the symbol
# was invisible, not just off). CONFIG_PCI=y already comes from virt's own
# platform fragment (virtio-9p-pci/virtio-net-pci already need a PCI bus),
# but that alone doesn't imply USB_PCI.
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y

# --- DWC2 (pi0's BCM2835 SoC OTG controller — later increment; harmless on virt) ---
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y

# --- USB mass storage, and the SCSI stack it's built on top of ---
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# --- vfat filesystem for the stick, + the NLS tables it needs to mount
#     (both required — a vfat mount fails outright with only one of them,
#     the same two-symbols-needed shape as 9p.config's own gating trap) ---
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
