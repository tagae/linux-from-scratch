# Kernel configuration for the opt-in "usb" capability (CAPS=usb): USB
# host stack + mass storage + vfat, for the air-gapped GPG key-to-USB
# persistence workflow. Not part of any platform's default kernel — a
# build with CAPS unset gets none of this.
#
# Both USB host controllers are enabled so this ONE fragment serves every
# platform: xHCI/PCI is what QEMU's virt machine models (see lfs's qemu
# case — usb-storage attaches to a qemu-xhci controller there, this
# increment's proof target); DWC2 is the BCM2835 SoC's own OTG controller
# the pi0 platform will need to attach a real/emulated USB stick in a
# later increment (dwc2 QEMU/hardware attach is explicitly out of scope
# here). An unused HCD driver simply never binds to any hardware present
# on a given machine — harmless dead weight on virt, not a functional
# risk.

# --- USB core ---
# USB_SUPPORT is a menuconfig bool gating the whole drivers/usb/Kconfig
# tree behind an "if USB_SUPPORT" block — allnoconfig forces it (like
# every menu-gating parent) to n, and
# KCONFIG_ALLCONFIG cannot force a *child* symbol on while its own gating
# parent stays off. Confirmed empirically in the resolved .config: without
# this line, USB_STORAGE/XHCI/DWC2 all silently stayed unset despite being
# listed below.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y

# --- xHCI (virt: QEMU's PCI-attached qemu-xhci device — see lfs's qemu case) ---
# USB_XHCI_PCI itself `depends on USB_PCI` (drivers/usb/Kconfig) — a
# SEPARATE bool, also `default y` upstream, also zeroed by allnoconfig
# (same trap as USB_SUPPORT above, one menu level deeper: found by
# grepping the resolved .config, which had USB_XHCI_HCD=y but no
# USB_XHCI_PCI line AT ALL — not even "is not set" — meaning the symbol
# was invisible, not just off). CONFIG_PCI=y already comes from virt's own
# platform fragment, but that alone doesn't imply USB_PCI.
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y

# --- DWC2 (pi0's BCM2835 SoC OTG controller; harmless dead weight on virt,
#     which has no dwc2 hardware to bind to) ---
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y

# BCM2835's dwc2 devicetree node (arch/arm/boot/dts/broadcom/bcm283x.dtsi)
# points `phys = <&usbphy>` at a `compatible = "usb-nop-xceiv"` phy node —
# dwc2 won't finish probing without a driver bound to that phy (it just sits
# waiting/deferred forever, invisible in dmesg as an obvious failure). NOP_
# USB_XCEIV (drivers/usb/phy/phy-generic.c) is the driver matching that
# exact compatible string (confirmed by grepping it in the kernel source),
# and needs no separate menu-gating fix beyond USB_SUPPORT above (it's
# reached through the same "if USB_SUPPORT" tree drivers/usb/phy/Kconfig is
# sourced into) — but its own `select USB_PHY`/EXTCON chain is exactly the
# kind of thing the menu-gating trap silently drops if unverified, so this
# was confirmed present (not just "is not set") in the resolved .config for
# pi0+usb before trusting it. virt has no such devicetree node at all, so
# this driver simply never binds there — harmless.
CONFIG_NOP_USB_XCEIV=y

# --- USB mass storage, and the SCSI stack it's built on top of ---
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# --- vfat filesystem for the stick, + the NLS tables it needs to mount
#     (both required — a vfat mount fails outright with only one of them) ---
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
