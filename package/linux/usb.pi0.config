# The Pi Zero's USB host controller.

# --- USB host controller: the SoC's DWC2 OTG controller, in host mode, behind the micro-USB port
#     marked USB. Its devicetree node names a no-op transceiver, whose driver it waits for. ---
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_NOP_USB_XCEIV=y

# --- USB power: the controller's devicetree node names the firmware's USB power domain. This driver
#     provides it, switching the domain on through the firmware's mailbox. Without it, the
#     controller waits for a provider that never comes and probes only when the deferred-probe
#     timeout expires, about 10 s into the boot. Power domains are built on runtime PM. ---
CONFIG_PM=y
CONFIG_RASPBERRYPI_POWER=y
