# Kernel configuration for a serial line as the kernel's console (console= on its command line) and
# as its early console (earlycon=). The UART's driver is in the part for the architecture, and the
# terminal layer it needs comes from the console capability.

# --- Serial console ---
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
