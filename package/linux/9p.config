# Kernel configuration for the opt-in "9p" capability (CAPS=9p): mounts the
# project directory shared by QEMU's virtio-9p device (see lfs's qemu case)
# at /mnt/lfs in the guest — groundwork for a later self-hosted-build
# objective. Not part of any platform's default kernel — a build with CAPS
# unset gets none of this.

# --- Core networking (kernel prerequisite for the 9p network protocol, even
#     though the actual transport below is virtio, not IP) ---
CONFIG_NET=y

# --- 9p protocol + virtio transport ---
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# --- Network filesystems menu ---
# NETWORK_FILESYSTEMS `default y` upstream, but that default is exactly
# what allnoconfig overrides to n; fs/9p/Kconfig is sourced inside its
# `if NETWORK_FILESYSTEMS` block (fs/Kconfig), so KCONFIG_ALLCONFIG can't
# force 9P_FS on without this — same menu-gating pitfall as
# NETDEVICES/NET_CORE in network.config (see there for how this was found).
CONFIG_NETWORK_FILESYSTEMS=y

# --- 9p filesystem client ---
CONFIG_9P_FS=y
