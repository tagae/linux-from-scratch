# Kernel configuration for systemd, which the profiles that install it name.

# --- Binary formats ---
CONFIG_BINFMT_MISC=y # So proc-sys-fs-binfmt_misc.mount works without modules.

# --- Cgroups ---
# No controllers: systemd runs the unified hierarchy without any, and skips the resource limits of its
# units.
CONFIG_CGROUPS=y

# --- Namespaces ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
# PrivateIPC=yes of systemd-report-basic@.service and systemd-report-cgroup@.service. The namespace
# depends on System V IPC or POSIX message queues.
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PID_NS=y

# --- Unix domain sockets ---
CONFIG_NET=y # Kernel prerequisite for CONFIG_UNIX. This is local IPC, not IP networking.
CONFIG_UNIX=y

# --- Pseudo-terminals ---
# The /dev/pts that PrivateDevices=yes binds into the /dev of a unit: without it, such a unit
# (systemd-timesyncd) fails to set up its mount namespace.
CONFIG_UNIX98_PTYS=y

# --- Filesystems ---
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
# The automount units, such as proc-sys-fs-binfmt_misc.automount, which systemd loads autofs4 for.
CONFIG_AUTOFS_FS=m

# --- BPF / cgroup-bpf ---
# Needed for systemd's cgroup-bpf-based IP accounting and filtering
# (IPAddressAllow=/IPAddressDeny=, used by systemd-journald.service's
# default IPAddressDeny=any hardening; also RestrictNetworkInterfaces=,
# and cgroup v2 BPF-based device filtering, e.g. DeviceAllow=/DeviceDeny=).
# Without these, systemd silently drops the associated sandboxing rather
# than failing, but they're a no-op without kernel support.
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_JIT=y
# Only privileged processes load BPF programs, which always run compiled: the BPF interpreter
# itself is a known gadget for speculative-execution attacks.
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# --- Systemd compatibility ---
CONFIG_RT_GROUP_SCHED=n
CONFIG_SYMBOLIC_ERRNAME=y
