# Kernel self-protection, after the Kernel Self Protection Project's recommendations, without the
# options that cost run time: zeroing memory on allocation (INIT_ON_ALLOC_DEFAULT_ON) and panicking
# on detected corruption (BUG_ON_DATA_CORRUPTION). Architecture-specific protections are in
# hardening.<architecture>.config, and those that the platform's kernel names differently in
# hardening.<platform>.config.

# --- Stack ---
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_SCHED_STACK_END_CHECK=y

# --- Memory permissions: kernel code read-only, data not executable ---
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y

# --- Copies to and from user space ---
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_FORTIFY_SOURCE=y

# --- Heap layout and metadata ---
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_LIST_HARDENED=y
