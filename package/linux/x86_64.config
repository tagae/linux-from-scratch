# Kernel configuration specific to 64-bit x86 hardware.

# --- Firmware tables ---
# Powering off goes through ACPI; without it the guest halts but QEMU never exits.
CONFIG_ACPI=y

# --- 8250 UART (the PC's serial console, ttyS0) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- RTC (the PC's CMOS clock) ---
# HCTOSYS sets the system clock from it at boot.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
