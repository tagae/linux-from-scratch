# Kernel configuration for FAT file systems: the boot partition of the Pi layout, which is mounted
# at /boot, and sticks and card readers.

# --- FAT, with the code page and character set that mounting it takes by default ---
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
