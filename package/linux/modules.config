# Loadable modules: the kernel loads and unloads them, such as the autofs4 that the systemd
# capability builds as a module. A system whose kernel has everything built in, and no use for
# modules, leaves it out: the kernel then builds no modules and installs no /usr/lib/modules.

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# The memory of a module is, like the kernel's (the hardening capability), never both writable and
# executable.
CONFIG_STRICT_MODULE_RWX=y
