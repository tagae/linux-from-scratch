# Kernel configuration for the opt-in "network" capability (CAPS=network).
#
# Not part of any platform's default kernel — a build with CAPS unset gets
# none of this, matching a real network-less deployment (this project's own
# Pi Zero). This fragment wires up just enough for QEMU's virtio-net-pci
# device (see lfs's qemu case) to bring up DHCP. Real-hardware NIC drivers
# (Pi's genet/bcmgenet, USB Ethernet, ...) are separate, platform-specific
# additions for later — this capability's virtio path is virt-only for now.

# --- Core networking ---
CONFIG_NET=y # Also set by systemd.config, for AF_UNIX only — harmless duplicate; KCONFIG_ALLCONFIG tolerates repeats.
CONFIG_INET=y

# --- Local IPC (in case this fragment is ever combined with a flavor that
#     doesn't already carry it, e.g. a future non-systemd, non-busybox one) ---
CONFIG_UNIX=y

# --- AF_PACKET (DHCP clients need raw link-layer access before an address exists) ---
CONFIG_PACKET=y

# --- Network device support ---
# NETDEVICES and NET_CORE both `default y` upstream, but that default is
# exactly what allnoconfig overrides to n; they gate a menuconfig/if block
# that VIRTIO_NET sits inside (drivers/net/Kconfig), so KCONFIG_ALLCONFIG
# can't force VIRTIO_NET on without these — it's simply invisible/pinned
# off otherwise (found by testing: an earlier version of this fragment
# without them built a kernel with no network interface at all, only lo).
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y

# --- Virtio network device (QEMU's virtio-net-pci) ---
CONFIG_VIRTIO_NET=y
