CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y

# NLS: FAT's core (short/8.3 name) codepage defaults to cp437 regardless of FAT_DEFAULT_UTF8 (that
# only covers long-name lookups).  NLS_UTF8 is FAT_DEFAULT_UTF8's own runtime half.
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_UTF8=y

# The kernel's own default iocharset (CONFIG_NLS_DEFAULT) is consulted for the mount's IO charset
# regardless of FAT_DEFAULT_UTF8 (that only changes what long-name lookups PREFER, not the
# mount-time default charset probe).
CONFIG_NLS_ISO8859_1=y
