# Kernel configuration for USB mass storage devices, such as sticks, drives and card readers. The USB
# devices themselves come from the usb capability, and the FAT file system that sticks usually hold
# from the fat capability.

# --- USB mass storage, through the SCSI disk driver ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# --- Partition tables: MBR, and GPT, which disks over 2 TiB need ---
# PARTITION_ADVANCED gates the choice of tables, MBR among them: without it, the kernel decides.
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
