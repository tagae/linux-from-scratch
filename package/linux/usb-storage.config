# Kernel configuration for the usb-storage capability: USB mass storage devices, such as sticks
# and card readers, with a FAT file system. The machine's fragment names its USB host controller.

# --- USB ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y

# --- USB mass storage, through the SCSI disk driver ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# --- FAT, with the code page and character set that mounting it takes by default ---
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
