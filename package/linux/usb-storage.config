# Kernel configuration for USB mass storage devices, such as sticks and card readers, with a FAT
# file system, which the base system's mount(8) mounts. The USB devices themselves come from the usb
# fragment.

# --- USB mass storage, through the SCSI disk driver ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# --- FAT, with the code page and character set that mounting it takes by default ---
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
