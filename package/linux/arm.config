# Kernel configuration specific to 32-bit ARM (ARMv6) hardware, the layer that pi0 (BCM2835,
# ARM1176) builds on.

# --- CPU architecture (ARMv6 multiplatform) ---
# 32-bit ARM, unlike arm64, lets MMU be turned off, which allnoconfig does; ARCH_MULTIPLATFORM, on
# which the whole platform chain rests, needs it.
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V6=y
CONFIG_AEABI=y                 # EABI userspace (arm-*-gnueabihf)
CONFIG_VFP=y                   # hardware floating point (float=hard)
CONFIG_ARM_PATCH_PHYS_VIRT=y

# 32-bit time_t syscalls (futex_time64, clock_gettime64, ...). The option defaults to y for a 32-bit
# user space, but allnoconfig turns it off like any other user-selectable bool. Without it, the
# futex calls of glibc's pthread locks fail with EINVAL, which glibc takes as fatal ("The futex
# facility returned an unexpected error code."): systemd, PID 1, aborts at its first lock, and the
# kernel panics ("Attempted to kill init!").
CONFIG_COMPAT_32BIT_TIME=y

# The helper routines the kernel maps for user space at 0xffff0fxx (compare-and-exchange, memory
# barriers). GCC's libatomic, which OpenSSL's libraries link, chooses its implementations by
# reading the version of that page when it is bound, and faults without it. The option defaults
# to y, but allnoconfig turns it off like any other user-selectable bool.
CONFIG_KUSER_HELPERS=y

# --- Clock framework (required by drivers) ---
CONFIG_COMMON_CLK=y

# --- Interrupt controller framework ---
CONFIG_IRQCHIP=y
