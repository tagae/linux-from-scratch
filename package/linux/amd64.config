# Kernel configuration specific to the QEMU q35 machine (a 64-bit x86 PC).

# --- PCI Express (q35 puts its devices on it) ---
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_BLK_MQ_PCI=y

# --- Virtio device framework ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLK_MQ_VIRTIO=y

# --- Virtio devices ---
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- 8250 UART (serial console on ttyS0) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
