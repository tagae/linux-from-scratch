# Kernel configuration common to all systems.

# --- Core kernel ---
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y

# --- Modules ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_RT_MUTEXES=y

# --- Block layer ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# --- Binary formats ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- Device management ---
CONFIG_DEVTMPFS=y
CONFIG_INOTIFY_USER=y
CONFIG_UEVENT_HELPER_PATH=""

# --- VFS ---
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_SYSCTL=y
CONFIG_FILE_LOCKING=y
CONFIG_FSNOTIFY=y
CONFIG_KERNFS=y
CONFIG_EXPORTFS=y

# --- Filesystems ---
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
