# Minimal kernel config shared across all platforms.
# Contains only what is strictly required for systemd to boot and serve
# a serial console. Architecture-specific and optional settings go in
# platform configs (virt.config, pi.config, etc.).

# --- Core kernel ---
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BASE_FULL=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y

# --- Modules ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS_NONE=y
CONFIG_RT_MUTEXES=y

# --- Block layer ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# --- Binary formats ---
CONFIG_BINFMT_ELF=y
CONFIG_ELFCORE=y
CONFIG_BINFMT_SCRIPT=y
# Built-in so systemd's proc-sys-fs-binfmt_misc.mount works without modules
CONFIG_BINFMT_MISC=y

# --- Cgroups (required by systemd) ---
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y

# --- Namespaces (required by systemd) ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# --- Unix domain sockets (required by systemd for IPC) ---
# CONFIG_NET is a kernel prerequisite for CONFIG_UNIX; this is local IPC,
# not IP networking. IP networking belongs in platform configs.
CONFIG_NET=y
CONFIG_UNIX=y

# --- Device management ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_EXTRA_FIRMWARE=""

# --- TTY ---
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y

# --- Serial console ---
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# --- VFS ---
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_FILE_LOCKING=y
CONFIG_FSNOTIFY=y
CONFIG_FANOTIFY=y
CONFIG_KERNFS=y
CONFIG_EXPORTFS=y

# --- Filesystems ---
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CONFIGFS_FS=y
CONFIG_AUTOFS_FS=m

# --- POSIX message queues (systemd dev-mqueue.mount) ---
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# --- Debug filesystem (systemd sys-kernel-debug.mount) ---
CONFIG_DEBUG_FS=y
# Trace filesystem (systemd sys-kernel-tracing.mount)
CONFIG_TRACING=y
CONFIG_FTRACE=y

# --- Systemd compatibility ---
CONFIG_SYSFS_DEPRECATED=n
CONFIG_RT_GROUP_SCHED=n
CONFIG_SYMBOLIC_ERRNAME=y
