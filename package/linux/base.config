# Kernel configuration common to all systems.

# --- Core kernel ---
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
# The console shows errors and worse, not the informational messages that the default level (7) adds,
# such as USB devices found: they would land in the middle of what is typed or printed there, a
# passphrase included, whenever a device comes or goes. `dmesg` and the journal keep every message,
# and `loglevel=7` on the kernel command line shows them on the console again.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
# posix_fadvise and madvise, with which programs tell the kernel how they use files and memory:
# allocators hand memory back with madvise, and the programs of btrfs-progs warn without
# posix_fadvise.
CONFIG_ADVISE_SYSCALLS=y

# --- Locking ---
CONFIG_RT_MUTEXES=y

# --- Block layer ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# --- Binary formats ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- Device management ---
CONFIG_DEVTMPFS=y
CONFIG_INOTIFY_USER=y
CONFIG_UEVENT_HELPER_PATH=""

# --- VFS ---
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_SYSCTL=y
CONFIG_FILE_LOCKING=y
CONFIG_FSNOTIFY=y
CONFIG_KERNFS=y
CONFIG_EXPORTFS=y

# --- Filesystems ---
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
