# Minimal kernel config shared across all platforms.
#
# Contains the minimum requirements for systemd to boot and serve a serial console.

# --- Core kernel ---
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y

# --- Modules ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_RT_MUTEXES=y

# --- Block layer ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# --- Binary formats ---
CONFIG_BINFMT_ELF=y
CONFIG_ELFCORE=y
CONFIG_BINFMT_SCRIPT=y

# --- Device management ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_EXTRA_FIRMWARE=""

# --- TTY ---
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y

# --- Serial console ---
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# --- VFS ---
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
# The pi0's kernel selects SYSCTL through PROC_SYSCTL, which the others' kernel lacks.
CONFIG_PROC_SYSCTL=y
CONFIG_SYSCTL=y
CONFIG_FILE_LOCKING=y
CONFIG_FSNOTIFY=y
CONFIG_FANOTIFY=y
CONFIG_KERNFS=y
CONFIG_EXPORTFS=y

# --- Filesystems ---
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CONFIGFS_FS=y
CONFIG_AUTOFS_FS=m
