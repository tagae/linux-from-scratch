# Kernel configuration for the opt-in "loop" capability (CAPS=loop): loop
# block devices (/dev/loopN), so `losetup`/`image build` can attach a raw
# .img file as a block device from INSIDE the guest — needed for the guest
# to build its own bootable disk image natively (SELF-HOST.md M4). Not part
# of any platform's default kernel — a build with CAPS unset gets none of
# this (the container's own `image build` never needs this: it runs on the
# Debian host kernel, not this project's own).
CONFIG_BLK_DEV_LOOP=y
