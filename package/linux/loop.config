# Kernel configuration for the opt-in "loop" capability (CAPS=loop): loop
# block devices (/dev/loopN), so `losetup`/`image build` can attach a raw
# .img file as a block device from INSIDE the guest — needed for the
# in-guest system build to build its own bootable disk image natively. Not
# part of any platform's default kernel — a build with CAPS unset gets
# none of this (the container's own `image build` never needs this: it
# runs on the Debian host kernel, not this project's own).
CONFIG_BLK_DEV_LOOP=y

# VFAT: a "pi"-layout target image (lib/image.sh's IMAGE_LAYOUT=pi — pi0/
# pi4/pi5) has a FAT boot partition alongside the btrfs root, and
# populate_image() mounts it with the host's own `mount`, kernel-side —
# needed the hard way, cross-building pi0's GnuPG image FROM a guest (see
# docs/design/{e2e-cross,guest-cross-builder}.md): "unknown filesystem
# type 'vfat'" on a builder guest whose own kernel (base.config has no
# filesystem here beyond btrfs/tmpfs) had never needed to MOUNT a foreign
# fs before, only build one for a same-layout (single-partition) target of
# its own. FAT_FS is a plain `select` of VFAT_FS in the kernel's own
# Kconfig, not an independent leaf — no separate hidden parent gate the
# way NETWORK_FILESYSTEMS/USB_SUPPORT are (kernel-config.md's own
# allnoconfig trap) — confirmed by checking the resolved .config, per that
# doc's own rule, not assumed.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
# NLS: FAT's core (short/8.3 name) codepage defaults to cp437 regardless
# of FAT_DEFAULT_UTF8 (that only covers long-name lookups) — without it,
# every FAT mount hard-fails ("FAT-fs: codepage cp437 not found") even
# though VFAT_FS/FAT_FS themselves are correctly =y; confirmed the hard
# way, right after fixing the "unknown filesystem type" gap above.
# NLS_UTF8 is FAT_DEFAULT_UTF8's own runtime half.
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_UTF8=y
# The kernel's own default iocharset (CONFIG_NLS_DEFAULT, unset here ->
# "iso8859-1") is consulted for the mount's IO charset regardless of
# FAT_DEFAULT_UTF8 (that only changes what long-name lookups PREFER, not
# the mount-time default charset probe) — same "verify the resolved
# .config, don't assume" story as cp437 above: "FAT-fs: IO charset
# iso8859-1 not found" was the very next failure once cp437 was fixed.
CONFIG_NLS_ISO8859_1=y
