# Kernel configuration specific to 32-bit ARM (ARMv6) hardware.
# The arm64 analog is arch-arm64.config; this is the layer pi0 (BCM2835 / ARM1176)
# builds on.

# --- CPU architecture (ARMv6 multiplatform) ---
# MMU must be forced on: unlike arm64 (always MMU), 32-bit ARM makes CONFIG_MMU
# user-settable, so allnoconfig turns it off (no-MMU) — which then disables
# ARCH_MULTIPLATFORM (depends on MMU) and collapses the whole platform chain.
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V6=y
CONFIG_AEABI=y                 # EABI userspace (arm-*-gnueabihf)
CONFIG_VFP=y                   # hardware floating point (float=hard)
CONFIG_ARM_PATCH_PHYS_VIRT=y

# 32-bit time_t syscalls (futex_time64, clock_gettime64, ...): default is
# "!64BIT || COMPAT" (i.e. on for any 32-bit userspace, which is all this
# arch ever runs), but the symbol has no "if" guarding its prompt, so
# allnoconfig force-disables it like any other user-selectable bool,
# ignoring that default. Without it, glibc's NPTL futex calls (used by
# essentially every pthread lock, hit almost immediately by systemd as
# PID 1) get -EINVAL back from the kernel and glibc treats that as fatal:
# "The futex facility returned an unexpected error code." — immediately
# aborting PID 1 (visible as a SIGILL "Attempted to kill init!" panic,
# since glibc's abort() falls back to a trap instruction when a plain
# SIGABRT doesn't kill the process, which the kernel deliberately ignores
# for PID 1). arm64 (virt) never needs this: 64-bit userspace there
# uses the native 64-bit-time futex/clock syscalls directly, never the
# 32-bit-time compat variants gated by this option.
CONFIG_COMPAT_32BIT_TIME=y

# --- Clock framework (required by drivers) ---
CONFIG_COMMON_CLK=y

# --- Interrupt controller framework ---
CONFIG_IRQCHIP=y

# --- AMBA bus (required for the PL011 UART) ---
CONFIG_ARM_AMBA=y
