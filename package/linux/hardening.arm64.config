# Kernel self-protection specific to 64-bit ARM, added to hardening.config on that
# architecture.

# --- Self-protection ---
# Kernel address space layout randomization, seeded by the boot loader or the firmware.
CONFIG_RANDOMIZE_BASE=y
# Pointer authentication and branch target identification, on CPUs that have them. GCC cannot
# build the kernel itself with branch target identification (ARM64_BTI_KERNEL), only programs.
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y

# --- CPU vulnerability mitigations ---
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y
