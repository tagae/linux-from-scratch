# Kernel configuration for the yubikey capability: security keys on USB, such as the YubiKey. Their
# smart card (CCID) interface needs nothing more than USB, as GnuPG's scdaemon drives it from user
# space through /dev/bus/usb. Their FIDO2 interface is a HID device, read and written through
# /dev/hidraw*. The machine's fragment names its USB host controller.

# --- USB ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y

# --- HID devices on USB, exposed raw ---
CONFIG_INPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
CONFIG_USB_HID=y
