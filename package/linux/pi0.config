# Kernel configuration specific to the Raspberry Pi Zero (BCM2835, single-core ARM1176, ARMv6),
# taken from bcmrpi_defconfig and pared to what QEMU's raspi0 machine models: enough to boot to a
# serial console with the btrfs root on the SD card.

# --- SoC / board support ---
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y

# --- /proc/sys ---
# The Pi's kernel (6.18) has PROC_SYSCTL, which selects SYSCTL; later kernels have no such option.
CONFIG_PROC_SYSCTL=y

# --- BCM2835 system timer (ARMv6 has no generic arch timer) ---
CONFIG_BCM2835_TIMER=y

# --- GPIO + pin control (UART / SD pin muxing) ---
CONFIG_GPIOLIB=y
CONFIG_PINCTRL_BCM2835=y

# --- VideoCore firmware mailbox + clocks (gate the SD block coming up) ---
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_CLK_BCM2835=y

# --- SD / MMC: root is the 2nd partition of the SD card (-> mmcblk0p2).
#     raspi0 has a single controller, driven by the bcm2835 sdhost. ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y

# --- DMA: the SoC's controller moves the SD card's data, which spares the single core. The SD
#     driver also needs the peripherals in the DMA ranges of the board's device tree
#     (bcm2835-rpi-zero.patch). ---
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y

# --- Hardware random number generator: feeds the kernel's pool, which keys are made from. The SoC
#     has no cycle counter for the kernel to gather entropy from. ---
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_BCM2835=y

# --- Watchdog / PM: poweroff routes through the BCM2835 watchdog block ---
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y
