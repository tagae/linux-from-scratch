# Kernel configuration specific to the QEMU raspi0 machine (Raspberry Pi Zero,
# BCM2835, single-core ARM1176 / ARMv6). Minimal set — just enough to boot to
# a serial console with the btrfs root on the emulated SD card. Extracted from
# bcmrpi_defconfig, pared to what QEMU's raspi0 actually models.

# Drops CONFIG_DMADEVICES entirely, which makes the sdhost driver fall back to PIO and never
# execute the kernel's regressed DMA path at all (incidentally, it also avoid QEMU's broken DMA
# emulation for the Pi Zero).

# --- SoC / board support ---
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y

# --- BCM2835 system timer (ARMv6 has no generic arch timer) ---
CONFIG_BCM2835_TIMER=y

# --- PL011 UART (ttyAMA0, our serial console) ---
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- GPIO + pin control (UART / SD pin muxing) ---
CONFIG_GPIOLIB=y
CONFIG_PINCTRL_BCM2835=y

# --- VideoCore firmware mailbox + clocks (gate the SD block coming up) ---
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_CLK_BCM2835=y

# --- SD / MMC: root is the 2nd partition of the SD card (-> mmcblk0p2).
#     raspi0 has a single controller, driven by the bcm2835 sdhost. ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y

# --- DMA: deliberately left OFF. QEMU's raspi0 machine models the
#     bcm2835-dma controller incompletely for the sdhost SD path — the
#     guest driver (drivers/mmc/host/bcm2835.c) requests a DMA channel,
#     QEMU acks it, but the resulting bulk transfer silently returns no
#     data, so even sector 0 (the partition table) reads back empty and
#     boot panics with "VFS: Unable to mount root fs" despite the card
#     itself probing fine (this is a known QEMU limitation, not a guest
#     bug: "DMA support isn't configured in QEMU's bcm2835_peripherals.c
#     for the SDHC"). bcm2835.c falls back to plain PIO whenever
#     dma_request_chan() fails to find a provider ("Ignore errors to fall
#     back to PIO mode") — so simply not building the DMA engine driver
#     forces that fallback and sidesteps the bug entirely.

# --- USB host controller: the SoC's DWC2 OTG controller, in host mode, behind the micro-USB port
#     marked USB. Its devicetree node names a no-op transceiver, whose driver it waits for. Inert
#     until a capability turns USB on. ---
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_NOP_USB_XCEIV=y

# --- Watchdog / PM: poweroff routes through the BCM2835 watchdog block ---
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# --- FAT: the Pi image layout has a FAT boot partition mounted at /boot ---
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
