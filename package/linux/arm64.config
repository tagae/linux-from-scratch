# Kernel configuration specific to ARM64 hardware.

# --- Clock framework (required by drivers) ---
CONFIG_COMMON_CLK=y

# --- Interrupt controller ---
CONFIG_IRQCHIP=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y

# --- System timer ---
CONFIG_ARM_ARCH_TIMER=y

# --- Power / reset via firmware ---
CONFIG_ARM_PSCI_FW=y
CONFIG_HAVE_ARM_SMCCC=y

# --- AMBA bus (the PL011 UART and the PL031 RTC are on it) ---
CONFIG_ARM_AMBA=y

# --- PCI host (QEMU's virt machine describes its PCI Express root in the device tree) ---
# Machines without PCI drop these.
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_HOST_GENERIC=y

# --- RTC (QEMU's virt machine models a PL031) ---
# Without this the guest clock starts at systemd's build epoch, which breaks
# TLS certificate validity checks in the guest ("not yet valid").
# HCTOSYS sets the system clock from the RTC at boot; QEMU seeds the RTC
# from the host clock by default (-rtc base=utc).
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y
