# Kernel configuration specific to ARM64 hardware.

# --- Clock framework (required by drivers) ---
CONFIG_COMMON_CLK=y

# --- Interrupt controller ---
CONFIG_IRQCHIP=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y

# --- System timer ---
CONFIG_ARM_ARCH_TIMER=y

# --- Power / reset via firmware ---
CONFIG_ARM_PSCI_FW=y
CONFIG_HAVE_ARM_SMCCC=y

# --- AMBA bus (required for PL011 UART) ---
CONFIG_ARM_AMBA=y
