# Supplemental kernel config for Raspberry Pi platforms, appended after defconfig.
# Ensures options needed by systemd and the image layout are built-in.

# FAT filesystem for the boot partition
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Root filesystem
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# systemd requirements
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_CONFIGFS_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BINFMT_MISC=y
CONFIG_DEBUG_FS=y
