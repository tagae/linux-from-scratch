# Kernel configuration specific to the QEMU raspi4b machine (Raspberry Pi 4,
# BCM2711). Minimal set — just enough to boot to a serial console with the
# btrfs root on the emulated SD card. Pared down from bcm2711_defconfig to
# what QEMU's raspi4b actually models (it disables PCIe, RNG, thermal, genet,
# etc.), so we skip the mass of downstream drivers that only spew probe
# errors under emulation.

# --- SoC / board support ---
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y

# --- PL011 UART (ttyAMA, our serial console) ---
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- GPIO + pin control (UART / SD pin muxing) ---
CONFIG_GPIOLIB=y
CONFIG_PINCTRL_BCM2835=y

# --- VideoCore firmware mailbox + clocks: the SD (emmc2) block's clock and
#     power come from the firmware, so these gate the SD controller coming up ---
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_CLK_BCM2835=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_RESET_CONTROLLER=y
CONFIG_BCM2835_POWER=y

# --- SD / MMC: root is the 2nd partition of the emmc2 card (-> mmcblk1p2).
#     emmc2 is driven by sdhci-iproc (brcm,bcm2711-emmc2). ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y

# --- DMA (used by the SD controller) ---
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y

# --- Watchdog / PM: poweroff routes through the BCM2835 watchdog block, so a
#     clean shutdown actually makes QEMU exit ---
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# --- FAT: the Pi image layout has a FAT boot partition (kernel.img/config.txt
#     /DTB for real-hardware boot), which systemd mounts at /boot ---
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
