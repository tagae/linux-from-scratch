# Kernel configuration specific to the QEMU arm64 virt machine.

# --- PCI subsystem (QEMU virt uses PCIe for virtio devices) ---
CONFIG_PCI=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y
CONFIG_BLK_MQ_PCI=y

# --- Virtio device framework ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLK_MQ_VIRTIO=y

# --- Virtio devices ---
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- PL011 UART (serial console on QEMU virt at 0x9000000) ---
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- RTC (QEMU virt models a PL031) ---
# Without this the guest clock starts at systemd's build-epoch (or 1970 on
# busybox-init), which breaks TLS certificate validity checks in the guest
# ("not yet valid") — found during the hkps keyserver verification.
# HCTOSYS sets the system clock from the RTC at boot; QEMU seeds the RTC
# from the host clock by default (-rtc base=utc).
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y
