# Kernel configuration specific to the QEMU arm64 virt machine.
# Merged with base.config via KCONFIG_ALLCONFIG during prepare().
# Only contains settings specific to this platform; optional features
# (networking, BPF, seccomp) are not included.

# --- Clock framework (required by ARM64 hardware drivers) ---
CONFIG_COMMON_CLK=y

# --- ARM64 hardware: interrupt controller ---
CONFIG_IRQCHIP=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y

# --- ARM64 hardware: system timer ---
CONFIG_ARM_ARCH_TIMER=y

# --- ARM64 hardware: power / reset via firmware ---
CONFIG_ARM_PSCI_FW=y
CONFIG_HAVE_ARM_SMCCC=y

# --- ARM64 hardware: AMBA bus (required for PL011 UART) ---
CONFIG_ARM_AMBA=y

# --- ARM64 hardware: PL011 UART (serial console on QEMU virt at 0x9000000) ---
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- PCI subsystem (QEMU virt uses PCIe for virtio devices) ---
CONFIG_PCI=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y
CONFIG_BLK_MQ_PCI=y

# --- Virtio device framework ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLK_MQ_VIRTIO=y

# --- Virtio devices ---
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
