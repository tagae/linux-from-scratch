# Kernel configuration for running as a QEMU virtual machine, on any architecture: virtio devices
# on a PCI Express bus. What depends on the architecture (its PCI host, console and clock) is in the
# architecture's layer.

# --- PCI subsystem (QEMU puts the virtio devices on PCIe) ---
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# --- Virtio device framework ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y

# --- Virtio devices ---
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
