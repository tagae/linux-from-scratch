# Kernel configuration for overlay file systems: a directory of a read-only root shown writable,
# with what is written to it kept in another file system, such as a tmpfs. The marks of what is
# deleted or replaced underneath are trusted extended attributes of the upper file system, which
# tmpfs has (TMPFS_XATTR, in base.config).

# --- Overlay file system ---
CONFIG_OVERLAY_FS=y
