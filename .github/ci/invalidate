#!/bin/sh
#
# Deletes the package archives that a change makes stale, before a build that reuses the archives of
# an earlier one (the cache of the CI pipeline).
#
# Archives are named by package, variant and version (lib/package.sh), not by the content of the
# recipe, kernel fragment or framework file that built them: an edit that keeps the version would
# have the build reuse them. So the archives record the commit they were built from, in
# archive/.commit, and what changed since decides which of them to drop. The packages built against
# one that changed are not dropped with it: the rules below name the package alone.
#
# Layout: archive/<key>/<package>[-<variant>]-<version>[-<revision>][-<component>].tar.xz, next to
# a .tar.xz.sha256. <package> is the path of the recipe under package/ without .sh, so that
# python/click is archive/<key>/python/click-<version>.tar.xz. The key is the platform and the
# init system (pi0-systemd) for the toolchain and the features that the platform and the init bring,
# extended by +<fragment> for the kernel, and by +<feature> for each other feature in turn. The key
# is tools for the build tools, which every platform shares (-bootstrap- and -tools- in the name),
# except those that a feature installs, which are filed under the key of its system.
#
# Only the inputs of the build can make an archive stale: lfs, Makefile, lib/, package/, feature/
# and platform/. Every other path (documentation, .github/, .claude/, the Dockerfiles,
# docker-compose.yaml, test, ...) has no effect. With --docker, for the archives of the build
# through Docker Compose, Dockerfile.bootstrap, Dockerfile.scratch and docker-compose.yaml are
# inputs too, which drop every archive, as they make the machines that every package is built on.
# Every input path that changed between archive/.commit and HEAD is mapped by the first rule that
# fits:
#
#    1  lib/image.sh, lib/qemu.sh and lib/sbom.sh: no effect (nothing in them goes into an archive).
#    2  package/<path>: the archive/*/<recipe>-* of the recipe that the path belongs to. That is
#       the path itself when it is a recipe, existing or deleted (package/python/cffi.sh is
#       python/cffi, not python), else the longest directory of the path that has a recipe at HEAD
#       (package/python/yubikey-manager/usr/bin/ykman is python/yubikey-manager, and
#       package/linux/usb.config is linux, the kernel). A path that belongs to no recipe falls to
#       rule 9.
#    3  feature/<f>.sh: every archive under a key with +<f> as one of its items (+usb is not
#       +usb-storage). A feature that a platform or an init brings is in no key, and every
#       later package is built against what it installs: every archive but the build tools.
#    4  lib/<c>.sh, the helpers of a package category <c> (a directory of package/ that holds
#       recipes at HEAD): everything under archive/*/<c>/.
#    5  lib/meson.sh: rule 2 for each recipe at HEAD that calls meson_cross_file.
#    6  lib/system.sh: every archive but the build tools (-bootstrap- and -tools- in the name).
#    7  Makefile: archive/*/system-files-*, as its LFS_RELEASE ends up in os-release.
#    8  platform/<p>.sh: everything under archive/<p>-*/.
#    9  Any other input (lfs, lib/base.sh, lib/package.sh, lib/components.sh, lib/tools.sh, other
#       paths of feature/, platform/ and lib/): every archive, which makes a build from scratch.
#
# A pattern like archive/*/make-* also drops make-ca-*, as a rebuild of a few archives too many is
# cheaper than a stale one. download/ is never touched, as what it holds is checked by hash.
#
# Without archive/.commit, or with one that names a commit that this clone lacks (a shallow clone,
# or rewritten history), nothing says what the archives were built from: they all go. A CI checkout
# therefore fetches the whole history. Leftover *.tmp files of an interrupted archive step go in
# any case. The script ends by recording HEAD in archive/.commit, for the next run.

set -o errexit -o nounset

# Usage: invalidate [--docker]
docker=
case ${1:-} in
    --docker) docker=yes ;;
    '') ;;
    *) echo "Usage: $0 [--docker]" >&2; exit 2 ;;
esac

# The paths of git and of the rules are those of the repository, wherever the script is run from.
cd "$(dirname "$0")/../.."

readonly archive_dir=archive
readonly commit_file=$archive_dir/.commit

# The archives to delete, as lines of "<kind> <argument>" that stale() reads: all, package <recipe>,
# category <name>, platform <name>, feature <name> and system.
selectors=
removed=0

# Runs a command on each line of the standard input, with the line as its last argument. The input
# comes from a here-document, as the commands run in this shell and set variables: both sides of a
# pipe run in a subshell.
each() {
    local line
    while read -r line; do
        [ -z "$line" ] || "$@" "$line"
    done
}

# Adds a selection of archives, with the reason for it.
select_archives() {
    echo "$1"
    selectors="$selectors
$2 ${3:-}"
}

# Deletes a file.
remove() {
    echo "    delete $1"
    rm -f -- "$1"
    removed=$((removed + 1))
}

# Succeeds when the selection includes the file at the given path, relative to the archive
# directory.
stale() {
    local key="${1%%/*}" name="${1#*/}" kind arg
    while read -r kind arg; do
        case $kind in
        all)
            return 0
            ;;
        package)
            # The name is anchored: the package python/cffi leaves python-* alone, and python leaves
            # python/cffi-* alone.
            case $name in "$arg"-*) return 0 ;; esac
            ;;
        category)
            case $name in "$arg"/*) return 0 ;; esac
            ;;
        platform)
            case $key in "$arg"-*) return 0 ;; esac
            ;;
        feature)
            # The key lists its features after the init, each preceded by a +.
            case $key in *"+$arg"|*"+$arg+"*) return 0 ;; esac
            ;;
        system)
            case ${name##*/} in
            *-bootstrap-*|*-tools-*) ;;
            *) return 0 ;;
            esac
            ;;
        esac
    done <<EOF
$selectors
EOF
    return 1
}

remove_if_stale() {
    if stale "${1#"$archive_dir"/}"; then
        remove "$1"
    fi
}

# Prints the recipe that a path under package/ belongs to, or nothing. A file with the suffix .sh
# is a recipe, as the files that packages ship have none.
recipe_of() {
    local rel="${1#package/}" dir
    case $rel in
    *.sh)
        echo "${rel%.sh}"
        return
        ;;
    esac
    dir=$rel
    while [ "$dir" != "${dir%/*}" ]; do
        dir=${dir%/*}
        if git cat-file -e "HEAD:package/$dir.sh" 2>/dev/null; then
            echo "$dir"
            return
        fi
    done
}

# Succeeds when a name is a package category: a directory of package/ that holds recipes at HEAD.
is_category() {
    git ls-tree --name-only HEAD "package/$1/" 2>/dev/null | grep -q '\.sh$'
}

# Adds to `brought` the features that a file at HEAD requires, and those that they require in
# turn.
add_required_features() {
    local name
    for name in $(git show "HEAD:$1" 2>/dev/null | sed -n 's/^# Requires://p'); do
        case " $brought " in
        *" $name "*) continue ;;
        esac
        if git cat-file -e "HEAD:feature/$name.sh" 2>/dev/null; then
            brought="$brought $name"
            add_required_features "feature/$name.sh"
        fi
    done
}

# Sets `brought` to the features that a platform or an init brings, for rule 3: what the platforms
# require, and the init of each key under the archive directory, with what it requires.
find_brought_features() {
    local path dir init
    brought=
    for path in $(git ls-tree --name-only HEAD platform/); do
        add_required_features "$path"
    done
    for dir in $(find "$archive_dir" -mindepth 1 -maxdepth 1 -type d ! -name tools); do
        init=${dir##*/}
        init=${init%%+*}
        init=${init#*-}
        brought="$brought $init"
        add_required_features "feature/$init.sh"
    done
}

# Rule 5, for a line of the output of git grep.
select_meson_recipe() {
    local recipe
    recipe=$(recipe_of "${1#HEAD:}")
    [ -z "$recipe" ] \
        || select_archives "lib/meson.sh: rule 5, archives of $recipe" package "$recipe"
}

# Maps a path that changed to the archives that it makes stale.
select_changed() {
    local path=$1 name callers
    case $path in
    lib/image.sh|lib/qemu.sh|lib/sbom.sh)
        echo "$path: rule 1, no effect"
        ;;
    package/*)
        name=$(recipe_of "$path")
        if [ -n "$name" ]; then
            select_archives "$path: rule 2, archives of $name" package "$name"
        else
            select_archives "$path: rule 9, in no recipe: every archive" all
        fi
        ;;
    feature/[!/]*.sh)
        name=${path#feature/}
        name=${name%.sh}
        case " $brought " in
        *" $name "*)
            select_archives \
                "$path: rule 3, brought by a platform or an init: all but the build tools" system
            ;;
        *)
            select_archives "$path: rule 3, archives of the feature $name" feature "$name"
            ;;
        esac
        ;;
    lib/meson.sh)
        # git grep fails when nothing matches.
        callers=$(git grep -l -F meson_cross_file HEAD -- package || true)
        each select_meson_recipe <<EOF
$callers
EOF
        ;;
    lib/system.sh)
        select_archives "$path: rule 6, every archive but the build tools" system
        ;;
    Makefile)
        select_archives "$path: rule 7, the system files" package system-files
        ;;
    platform/[!/]*.sh)
        name=${path#platform/}
        name=${name%.sh}
        select_archives "$path: rule 8, archives of the platform $name" platform "$name"
        ;;
    lib/[!/]*.sh)
        name=${path#lib/}
        name=${name%.sh}
        if is_category "$name"; then
            select_archives "$path: rule 4, archives of the category $name" category "$name"
        else
            select_archives "$path: rule 9, every archive" all
        fi
        ;;
    lfs|lib/*|feature/*|platform/*)
        select_archives "$path: rule 9, every archive" all
        ;;
    Dockerfile.bootstrap|Dockerfile.scratch|docker-compose.yaml)
        if [ -n "$docker" ]; then
            select_archives "$path: the build's containers, every archive" all
        else
            echo "$path: no effect"
        fi
        ;;
    *)
        # Not an input of the build.
        echo "$path: no effect"
        ;;
    esac
}

head_commit=$(git rev-parse HEAD)
files=

if [ -d "$archive_dir" ]; then
    # Left by an archive step that was interrupted before it moved the archive into place.
    leftovers=$(find "$archive_dir" -type f -name '*.tmp' | sort)
    each remove <<EOF
$leftovers
EOF
    files=$(find "$archive_dir" -type f \( -name '*.tar.xz' -o -name '*.tar.xz.sha256' \) | sort)
fi

if [ -z "$files" ]; then
    echo "$archive_dir holds no archive"
else
    built=
    [ ! -f "$commit_file" ] || built=$(cat "$commit_file")
    case $built in
    '')
        select_archives "$commit_file is missing: every archive" all
        ;;
    *[!0-9a-f]*)
        select_archives "$commit_file does not hold a commit: every archive" all
        ;;
    *)
        if git rev-parse --verify --quiet "$built^{commit}" >/dev/null; then
            echo "archives built from $built, HEAD is $head_commit"
            # Without renames, both the old and the new path of a moved file show.
            changed=$(git diff --no-renames --name-only "$built" HEAD)
            find_brought_features
            each select_changed <<EOF
$changed
EOF
        else
            select_archives "$commit_file names $built, not in this clone: every archive" all
        fi
        ;;
    esac
    if [ -n "$selectors" ]; then
        each remove_if_stale <<EOF
$files
EOF
    fi
fi

echo "deleted $removed files"

mkdir -p "$archive_dir"
echo "$head_commit" > "$commit_file"
