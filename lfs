#!/bin/sh

set -o errexit -o nounset
umask 022


#===[ Framework ]===

readonly project_dir=$(dirname $(realpath "$0"))
readonly lib_dir=$project_dir/lib
readonly package_dir=$project_dir/package
readonly profile_dir=$project_dir/profile

. $lib_dir/base.sh
. $lib_dir/package.sh
. $lib_dir/components.sh
. $lib_dir/meson.sh
. $lib_dir/tools.sh
. $lib_dir/sbom.sh
. $lib_dir/system.sh
. $lib_dir/image.sh
. $lib_dir/qemu.sh


#===[ Environment ]===

# Override if you wish to store artefacts in a custom dir.
: ${LFS_STATE_DIR:=$project_dir}

# Mutable build state.
: ${LFS_WORK_DIR:=$LFS_STATE_DIR/work}

# Fetched artefacts. Allows offline work once all needed artefacts have been fetched.
: ${LFS_DOWNLOAD_DIR:=$LFS_STATE_DIR/download}

# Build toolchains.
: ${LFS_TOOL_DIR:=$LFS_STATE_DIR/tools}

# Built package archives.
: ${LFS_ARCHIVE_DIR:=$LFS_STATE_DIR/archive}

# Built images to be used on actual hardware, or emulators.
: ${LFS_IMAGE_DIR:=$LFS_STATE_DIR/image}

readonly LFS_STATE_DIR LFS_WORK_DIR LFS_DOWNLOAD_DIR LFS_TOOL_DIR LFS_ARCHIVE_DIR LFS_IMAGE_DIR

# Start anew with the same arguments in an environment that holds only allowed variables.
if ! ${LFS_CLEAN_ENV:-false}; then
    # Standard variables (first line).
    # Shell variables (second line).
    # LFS API variables (remaining lines).
    # Nothing else from the caller (CFLAGS, PKG_CONFIG_PATH, PYTHONPATH, etc.) is passed.
    exec env - \
         "PATH=$PATH" "TMPDIR=${TMPDIR:-$LFS_WORK_DIR/tmp}" "HOME=$LFS_WORK_DIR" \
         "PWD=$PWD" "OLDPWD=${OLDPWD:-}" \
         "LFS_STATE_DIR=${LFS_STATE_DIR:-}" "LFS_WORK_DIR=${LFS_WORK_DIR:-}" \
         "LFS_DOWNLOAD_DIR=${LFS_DOWNLOAD_DIR:-}" "LFS_TOOL_DIR=${LFS_TOOL_DIR:-}" \
         "LFS_ARCHIVE_DIR=${LFS_ARCHIVE_DIR:-}" "LFS_IMAGE_DIR=${LFS_IMAGE_DIR:-}" \
         "LFS_PROFILE=${LFS_PROFILE:-}" "LFS_MACHINE=${LFS_MACHINE:-}" \
         "LFS_TIMEZONE=${LFS_TIMEZONE:-}" "LFS_USER=${LFS_USER:-}" "LFS_PASSWORD=${LFS_PASSWORD:-}" \
         "LFS_ROOT_PASSWORD=${LFS_ROOT_PASSWORD:-}" \
         "LFS_RELEASE=${LFS_RELEASE:-}" "LFS_VERSION_CODENAME=${LFS_VERSION_CODENAME:-}" \
         "LFS_RELEASE_TYPE=${LFS_RELEASE_TYPE:-}" "LFS_DISTRIB_CODENAME=${LFS_DISTRIB_CODENAME:-}" \
         "LFS_DISTRIB_DESCRIPTION=${LFS_DISTRIB_DESCRIPTION:-}" \
         "LFS_ERASE=${LFS_ERASE:-}" \
         "LFS_QEMU_EXTRA=${LFS_QEMU_EXTRA:-}" \
         LFS_CLEAN_ENV=true \
         "$0" "$@"
fi

mkdir -p $TMPDIR

#===[ System Characteristics ]===

#-- Profile: the whole system to build.

if [ -z "${LFS_PROFILE:-}" ] && [ "${1:-}" = qemu ] && [ $# -ge 2 ]; then
    _image=${2##*/}
    [ ! -f $profile_dir/${_image%.img}.sh ] || LFS_PROFILE=${_image%.img}
    unset _image
fi

: ${LFS_PROFILE:=virt}

[ -f $profile_dir/$LFS_PROFILE.sh ] || bail "Unknown profile '$LFS_PROFILE'"

readonly LFS_PROFILE

#-- Platform: hardware on which the built system will run.

readonly platform=${LFS_PROFILE%%-*}

[ -f $project_dir/platform/$platform.sh ] || bail "
Unsupported platform '$platform' in profile '$LFS_PROFILE'.
A profile is named <platform>[-<name>]"

. $project_dir/platform/$platform.sh

#-- Package key: the key under which the system's packages are archived.

package_key=$LFS_PROFILE

#-- System tree: the root tree of the system, which the system step builds and the image step reads.

readonly system_dir=$LFS_WORK_DIR/$LFS_PROFILE/system


#===[ Compilation ]===

# The target triplet is <arch>-<vendor>-<kernel>-<abi>, whose ABI is the C library the profile
# chooses (lfs_system_toolchain), followed by the platform's EABI, if it has one (target_eabi).
: ${target_vendor:=scratch}
: ${target_kernel:=linux}
readonly target_arch target_vendor target_kernel

export LC_ALL=POSIX
readonly LC_ALL

if command -v nproc >/dev/null 2>&1; then
    export MAKEFLAGS=-j$(nproc)
    readonly MAKEFLAGS
fi


#===[ Installation ]===

# BTRFS subvolume name to use as root filesystem.
readonly root_volume=1


#===[ Command Execution ]===

if [ "${1:-} ${2:-}" = "tools bootstrap" ]; then
    # The bootstrap builds a minimal tool set using the host toolchain.
    # During bootstrap, the host toolchain has precedence over the tools under construction.
    export PATH=$LFS_TOOL_DIR/bin:$PATH:$LFS_TOOL_DIR/usr/bin:$LFS_TOOL_DIR/usr/sbin
    readonly PATH
elif [ "${1:-} ${2:-}" = "tools build" ] || [ "${1:-}" = "system" ] || [ "${1:-}" = "image" ]; then
    # Once the tools are bootstrapped, everything else runs on our tools exclusively, the image
    # step among them: the scratch container holds nothing but the tools to run its mkfs.fat and
    # sfdisk.
    export PATH=$LFS_TOOL_DIR/bin:$LFS_TOOL_DIR/usr/bin:$LFS_TOOL_DIR/usr/sbin
    readonly PATH
    # OpenSSL looks in the host's /etc/ssl, unless told otherwise.
    export SSL_CERT_FILE=$LFS_TOOL_DIR/etc/ssl/cert.pem SSL_CERT_DIR=$LFS_TOOL_DIR/etc/ssl/certs
    readonly SSL_CERT_FILE
fi

case "${1:-help}" in
    fetch)
        [ $# -eq 1 ] || usage "$1"
        # A recipe may leave files in its source directory while it fetches: it is a directory of
        # its own, which lfs_fetch_all removes.
        source_dir=$(mktemp -d)
        readonly source_dir
        lfs_fetch_all
        ;;

    tools)
        shift
        readonly source_dir=$LFS_WORK_DIR/$tools_key/source
        case "${1:-help}" in
            bootstrap)
                shift
                lfs_tools_bootstrap
                ;;
            build)
                shift
                lfs_tools_build
                ;;
            help)
                echo "Usage: $(basename "$0") tools <bootstrap|build>"
                if [ $# -eq 1 ]; then exit 0; else exit 1; fi ;;
            *)
                bail "Unknown tools command '$1'" ;;
        esac
        ;;

    system)
        shift
        # Sources are unpacked and patched in place, and possibly, in parallel.
        # so each profile has a source directory of its own.
        readonly source_dir=$LFS_WORK_DIR/$package_key/source
        case "${1:-help}" in
            build)
                shift
                lfs_system_build
                ;;
            help)
                echo "Usage: $(basename "$0") system <build>"
                if [ $# -eq 1 ]; then exit 0; else exit 1; fi ;;
            *)
                bail "Unknown system command '$1'" ;;
        esac
        ;;

    image)
        shift
        case "${1:-help}" in
            build)
                shift
                lfs_build_image "$@"
                ;;
            help)
                echo "Usage: $(basename "$0") image <subcommand>"
                if [ $# -eq 1 ]; then exit 0; else exit 1; fi ;;
            *)
                bail "Unknown image command '$1'" ;;
        esac
        ;;

    qemu)
        shift
        qemu "$@"
        ;;

    help)
        echo "Usage: $(basename "$0") (fetch|tools|system|image|qemu)"
        echo ""
        echo "Commands:"
        echo "  fetch            Download the sources of every package, for the profile's platform"
        echo "  tools            Build the build tools"
        echo "  system build     Build the system for the platform"
        echo "  image build [IMAGE|DEVICE]"
        echo "                   Create a bootable disk image, with its SBOM and file manifests, or"
        echo "                   format a block device, from the built system"
        echo "  qemu [IMAGE]     Boot the built kernel + image in QEMU (LFS_PROFILE: that of"
        echo "                   <profile>.img)"
        echo ""
        echo "Environment:"
        echo "  LFS_PROFILE      The system to build, as profile/<profile>.sh lists it; virt by default"
        echo "  LFS_TIMEZONE     The image's time zone, as named in the tz database; UTC by default"
        echo "  LFS_USER         The name of the regular account of the profiles that have one"
        echo "  LFS_PASSWORD     That account's password; its name by default"
        echo "  LFS_ROOT_PASSWORD"
        echo "                   root's password; root by default"
        echo "  LFS_ERASE        The block device that image build may erase; the same path as the"
        echo "                   DEVICE argument. A device is never erased without it"
        echo "  LFS_MACHINE      The kernel's default host name; none by default"
        echo "  LFS_RELEASE      The release the image is made as, in os-release and the SBOM"
        echo "  LFS_VERSION_CODENAME, LFS_RELEASE_TYPE"
        echo "                   os-release's VERSION_CODENAME (local) and RELEASE_TYPE (development)"
        echo "  LFS_DISTRIB_CODENAME, LFS_DISTRIB_DESCRIPTION"
        echo "                   lsb-release's DISTRIB_CODENAME (local) and DISTRIB_DESCRIPTION"
        echo "                   (Linux From Scratch)"
        echo "  LFS_QEMU_EXTRA   More arguments for qemu's command line (-device usb-ccid)"
        if [ $# -eq 1 ]; then exit 0; else exit 1; fi
        ;;
    *)
        bail "Unknown command '$1'"
        ;;
esac
