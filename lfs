#!/bin/sh

set -o errexit -o nounset
umask 022

readonly PROJECT_DIR=$(dirname $(realpath "$0"))
readonly PACKAGE_DIR=$PROJECT_DIR/package

. $PROJECT_DIR/lib/base.sh
. $PROJECT_DIR/lib/package.sh
. $PROJECT_DIR/lib/tools.sh
. $PROJECT_DIR/lib/system.sh
. $PROJECT_DIR/lib/image.sh

#--[ Command line ]

CMD_ARGS=$(getopt "p:d:h" "$@")
[ $? -eq 0 ] || bail "Could not parse options"

eval set -- "$CMD_ARGS"

while [ $# -gt 0 ]; do
    case "${1:-}" in
        -p)
            [ $? -eq 0 ] || bail "Invalid platform: $2"
            PLATFORM="$2"
            shift 2
            ;;
        -d)
            [ $? -eq 0 ] || bail "Invalid destination: $2"
            DESTINATION="$2"
            shift 2
            ;;
        -h)
            eval set -- help
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            bail "BUG"
            ;;
    esac
done

#--[ Project ]

: ${OUTPUT_DIR:=$PROJECT_DIR}
: ${DOWNLOAD_DIR:=$OUTPUT_DIR/download}
: ${SOURCE_DIR:=$OUTPUT_DIR/source}
: ${WORK_DIR:=$OUTPUT_DIR/work}
: ${TOOL_DIR:=$OUTPUT_DIR/tools}
: ${INSTALL_DIR:=$OUTPUT_DIR/install}
: ${ARCHIVE_DIR:=$OUTPUT_DIR/archive}
: ${IMAGE_DIR:=$OUTPUT_DIR/image}
# Small bind-mounted staging area for the one file Dockerfile.scratch
# needs at build time (see tools_bootstrap). TOOL_DIR itself is a named
# volume, which `docker build` can't see at all.
: ${SCRATCH_INIT_DIR:=$OUTPUT_DIR/scratch-init}

readonly DOWNLOAD_DIR SOURCE_DIR WORK_DIR TOOL_DIR INSTALL_DIR ARCHIVE_DIR IMAGE_DIR SCRATCH_INIT_DIR

#--[ Target platform ]

: ${PLATFORM:=virt}
[ -f $PROJECT_DIR/lib/platform/$PLATFORM.sh ] || bail "Unsupported platform '$PLATFORM'"

readonly PLATFORM

. $PROJECT_DIR/lib/platform/$PLATFORM.sh

#--[ Compilation ]

export LC_ALL=POSIX
export MAKEFLAGS=-j$(nproc)

readonly LC_ALL MAKEFLAGS

# Bootstrap phase: cross-compiler bin + host tools. Do NOT put toolchain usr/bin
# first — once glibc-linked binaries are installed there they shadow host tools
# and fail (wrong ELF interpreter). Scratch phase: toolchain only, no host PATH.
if [ "${LFS_PHASE:-bootstrap}" = scratch ]; then
    PATH=$TOOL_DIR/usr/bin:$TOOL_DIR/bin
else
    PATH=$TOOL_DIR/bin:$PATH
fi

readonly PATH
export PATH

#--[ Installation ]

readonly ROOT_VOLUME=${ROOT_VOLUME:-1}

trap cleanup EXIT

#--[ Command ]

case "${1:-help}" in
    version)
        shift
        version "$@"
        ;;

    fetch)
        shift
        fetch "$@"
        ;;

    tools)
        shift
        tools "$@"
        ;;

    system)
        shift
        system "$@"
        ;;

    install)
        shift
        install "$@"
        ;;

    image)
        [ $# -le 2 ] || usage "$1 [IMAGE]"
        IMAGE="${2:-$IMAGE_DIR/$PLATFORM.img}"
        image
        populate_image
        ;;

    qemu)
        [ $# -le 2 ] || usage "$1 [IMAGE]"
        _image="${2:-$IMAGE_DIR/$PLATFORM.img}"

        if [ ! -f "$_image" ]; then
            IMAGE="$_image" image
            populate_image
            unmount_all
        fi

        _kernel="$INSTALL_DIR/boot/kernel.img"
        [ -f "$_kernel" ] || bail "Kernel not found: $_kernel (run './lfs system' first)"

        _dtb="${DTB:+$INSTALL_DIR/boot/$DTB}"
        if [ -f "$INSTALL_DIR/boot/cmdline.txt" ]; then
            _append="$(cat $INSTALL_DIR/boot/cmdline.txt)"
        elif [ "$PLATFORM" = virt ]; then
            _append="console=hvc0 root=/dev/vda1 rootfstype=btrfs rootflags=subvol=root/$ROOT_VOLUME rw rootwait"
        else
            _append="earlycon=pl011,0x20201000 console=ttyAMA0,115200 root=/dev/mmcblk0p2 rootfstype=btrfs rootflags=subvol=root/$ROOT_VOLUME rw rootwait rootdelay=5 initcall_blacklist=bcm2835_pm_driver_init"
        fi

        set -- -M $QEMU_MACHINE -nodefaults -no-user-config ${QEMU_FLAGS:-} -no-reboot -kernel "$_kernel"
        [ -n "$_dtb" ] && [ -f "$_dtb" ] && set -- "$@" -dtb "$_dtb"
        set -- "$@" -drive "file=$_image,format=raw,if=${QEMU_DISK_IF:-sd}" -append "$_append"
        exec $QEMU "$@"
        ;;

    help)
        echo "Usage: $(basename "$0") [-p PLATFORM] (tools|system|install|image|qemu)"
        echo ""
        echo "Commands:"
        echo "  tools            Build cross-compilation toolchain"
        echo "  system           Build all final system packages"
        echo "  install <PKG>... Install one or more packages"
        echo "  image [FILE]     Create bootable disk image"
        echo "  qemu [FILE]      Boot image in QEMU (creates image if needed)"
        echo ""
        echo "Options:"
        echo "  -p PLATFORM      Target platform (pi0, pi4, pi5)"
        echo "  -d DESTINATION   Install destination (dir, device, or .img file)"
        if [ $# -eq 1 ]; then exit 0; else exit 1; fi
        ;;

    *)
        bail "Unknown command '$1'"
esac
