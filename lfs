#!/bin/sh

set -o errexit -o nounset
umask 022

readonly PROJECT_DIR=$(dirname $(realpath "$0"))
readonly PACKAGE_DIR=$PROJECT_DIR/package

. $PROJECT_DIR/lib/base.sh
. $PROJECT_DIR/lib/package.sh
. $PROJECT_DIR/lib/tools.sh
. $PROJECT_DIR/lib/system.sh
. $PROJECT_DIR/lib/image.sh

#--[ Command line ]

while getopts ":p:d:h" opt; do
    case "$opt" in
        p) PLATFORM="$OPTARG" ;;
        d) DESTINATION="$OPTARG" ;;
        h) set -- help; break ;;
        :) bail "Option -$OPTARG requires an argument" ;;
        \?) bail "Could not parse options" ;;
    esac
done

[ "${1:-}" = help ] || shift $((OPTIND - 1))

#--[ Project ]

# Guest phase (LFS_PHASE=guest, see SELF-HOST.md M2): heavy build state is
# guest-LOCAL, not the 9p share — mirrors how docker-compose keeps the
# I/O-hot dirs (source/work/tools/install) in named volumes instead of the
# bind-mounted project tree, since compiling over 9p would be painfully
# slow. Deliberately NOT ARCHIVE_DIR=$PROJECT_DIR/archive: the guest's own
# natively-built tarballs must not collide with/overwrite the cross-built
# ones already shared there (a later reproducibility comparison between
# the two is a feature, not a bug). Checked here, ahead of the generic `:
# ${VAR:=...}` defaults below, so those become no-ops for these three vars
# in guest phase (first assignment wins) and untouched everywhere else.
# DOWNLOAD_DIR is deliberately NOT overridden: it stays PROJECT_DIR-
# relative even in guest phase (=/mnt/lfs/download, since PROJECT_DIR IS
# /mnt/lfs when run from the guest's 9p mount) — the shared, hash-verified
# source cache is exactly what a guest build wants to reuse, offline.
# INSTALL_DIR/IMAGE_DIR join the three above for the same reason (SELF-HOST.md
# M4): `system build`/`image build` need somewhere guest-local to stage the
# system tree and the .img file while building — INSTALL_DIR is a full
# native-built system tree (~GBs of churn), and the not-yet-finished .img
# under IMAGE_DIR is actively attached to a loop device mid-build, neither
# of which belongs on the 9p share. M5 copies the *finished* artifacts back
# out to the shared image/ and work/boot/ explicitly (see SELF-HOST.md).
if [ "${LFS_PHASE:-bootstrap}" = guest ]; then
    : ${SOURCE_DIR:=/var/lfs/source}
    : ${WORK_DIR:=/var/lfs/work}
    : ${ARCHIVE_DIR:=/var/lfs/archive}
    : ${INSTALL_DIR:=/var/lfs/install}
    : ${IMAGE_DIR:=/var/lfs/image}
fi

: ${DOWNLOAD_DIR:=$PROJECT_DIR/download}
: ${SOURCE_DIR:=$PROJECT_DIR/source}
: ${WORK_DIR:=$PROJECT_DIR/work}
: ${TOOL_DIR:=$PROJECT_DIR/tools}
: ${INSTALL_DIR:=$PROJECT_DIR/install}
: ${ARCHIVE_DIR:=$PROJECT_DIR/archive}
: ${IMAGE_DIR:=$PROJECT_DIR/image}

# Small bind-mounted staging area for the few files Dockerfile.scratch needs at build time.
: ${SCRATCH_INIT_DIR:=$WORK_DIR/scratch-init}

readonly DOWNLOAD_DIR SOURCE_DIR WORK_DIR TOOL_DIR \
         INSTALL_DIR ARCHIVE_DIR IMAGE_DIR SCRATCH_INIT_DIR

#--[ Target platform ]

: ${PLATFORM:=virt}

[ -f $PROJECT_DIR/lib/platform/$PLATFORM.sh ] || bail "Unsupported platform '$PLATFORM'"

readonly PLATFORM

. $PROJECT_DIR/lib/platform/$PLATFORM.sh

#--[ Init flavor ]

# Which init/unit system the built system uses. Selects the umbrella
# package installed by `system build` (bootable-$INIT), and — via
# SYSTEM_KEY below — keeps each flavor's install tree, stamps, boot files
# and disk image separate so they coexist without clobbering (same
# reasoning as the per-PLATFORM keying; see feedback-cross-platform-stamp-
# contamination).
: ${INIT:=systemd}

[ -f $PROJECT_DIR/package/bootable-$INIT.sh ] || bail "Unsupported init '$INIT'"

# The default (systemd) keeps the bare $PLATFORM key so existing builds,
# stamps and images are unaffected; other flavors get an $INIT- prefix.
case $INIT in
    systemd) SYSTEM_KEY=$PLATFORM ;;
    *)       SYSTEM_KEY=$INIT-$PLATFORM ;;
esac

#--[ Capabilities ]

# Opt-in features layered on top of the base system (space-separated,
# e.g. CAPS="network 9p"). Each capability <cap> names a kernel config
# fragment (package/linux/<cap>.config, folded into the kernel build by
# package/linux.sh's prepare()) plus, optionally, packages the bootable-*
# umbrellas require() when enabled (see network-config.sh/9p-config.sh) and
# QEMU flags (see the qemu case below). Empty by default, so a build with
# CAPS unset is byte-for-byte what existed before capabilities were added —
# this project's own network-less Pi Zero depends on that staying true.
: ${CAPS:=}

for cap in $CAPS; do
    [ -f $PROJECT_DIR/package/linux/$cap.config ] || bail "Unknown capability '$cap' (no package/linux/$cap.config)"
done

# Sorted + de-duplicated so any ordering of the same set of caps (e.g.
# "9p network" vs "network 9p") lands on the identical SYSTEM_KEY below —
# same install tree, stamps and image either way.
CAPS=$(printf '%s\n' $CAPS | sort -u | xargs)

# Folded into SYSTEM_KEY so each capability combination gets its own
# install tree, stamps, boot dir and image — same reasoning as the
# PLATFORM/INIT keying above. CRITICAL: with CAPS empty (the default) this
# loop doesn't execute, so SYSTEM_KEY — and every existing build, stamp and
# image for the no-caps case — is untouched.
for cap in $CAPS; do
    SYSTEM_KEY=$SYSTEM_KEY+$cap
done

readonly INIT SYSTEM_KEY CAPS

#--[ Compilation ]

export LC_ALL=POSIX

# Support both Linux (nproc) and macOS (sysctl).
export MAKEFLAGS=-j$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)

readonly LC_ALL MAKEFLAGS

# Bootstrap phase: cross-compiler bin + host tools + toolchain usr/bin
# LAST. Do NOT put toolchain usr/bin first — once glibc-linked binaries are
# installed there they shadow host tools and fail (wrong ELF interpreter).
# It still needs to be on PATH somewhere, though: build-time tools that
# only the toolchain itself provides (e.g. pkgconf, needed by wget's own
# configure) aren't on the host at all, so they're only found as a
# fallback after host tools are checked first.
# Scratch phase: toolchain only, no host PATH.
# Guest phase: PATH untouched, on purpose — there is no TOOL_DIR here at
# all; the booted system's own /usr/bin already has everything a native
# build needs (see native-toolchain.sh / SELF-HOST.md M1-M2).
if [ "${LFS_PHASE:-bootstrap}" = scratch ]; then
    PATH=$TOOL_DIR/usr/bin:$TOOL_DIR/usr/sbin:$TOOL_DIR/bin
elif [ "${LFS_PHASE:-bootstrap}" = guest ]; then
    :
else
    PATH=$TOOL_DIR/bin:$PATH:$TOOL_DIR/usr/bin:$TOOL_DIR/usr/sbin
fi

readonly PATH
export PATH

# CA bundle used to verify TLS on source downloads (see fetch_url in
# lib/base.sh). Bootstrap runs in Debian, which ships one at the standard
# path. The scratch container is FROM scratch: it verifies against OUR OWN
# bundle, generated from Mozilla's certdata.txt by the ca-certificates
# package and staged to $WORK_DIR/certs during bootstrap_tools (see there) —
# present before the very first scratch download, so fetch_url always
# verifies and never falls back to unverified transport. $WORK_DIR is the
# shared `work` volume, so the bundle bootstrap staged is visible here.
# Guest phase falls into the same "else" branch as bootstrap: the booted
# system already has its own from-scratch bundle at the standard path
# (installed target-side by the ca-certificates package — see
# bootable-systemd.sh), so no override is needed; this only matters at all
# on a download cache miss, since download/ is normally fully populated.
if [ "${LFS_PHASE:-bootstrap}" = scratch ]; then
    : ${SSL_CERT_FILE:=$WORK_DIR/certs/ca-certificates.crt}
else
    : ${SSL_CERT_FILE:=/etc/ssl/certs/ca-certificates.crt}
fi
export SSL_CERT_FILE

#--[ Installation ]

readonly ROOT_VOLUME=${ROOT_VOLUME:-1}

trap image_cleanup EXIT

#--[ Command ]

case "${1:-help}" in
    version)
        shift
        version "$@"
        ;;

    fetch)
        shift
        fetch "$@"
        ;;

    tools)
        shift
        tools "$@"
        ;;

    system)
        shift
        system "$@"
        ;;

    install)
        shift
        install "$@"
        ;;

    unarchive)
        shift
        [ $# -ge 1 ] || usage "unarchive FILE [DEST]"
        unarchive "$@"
        ;;

    image)
        shift
        image "$@"
        ;;

    qemu)
        [ $# -le 2 ] || usage "$1 [IMAGE]"
        IMAGE="${2:-$IMAGE_DIR/$SYSTEM_KEY.img}"
        _kernel="$WORK_DIR/boot/$SYSTEM_KEY/kernel.img"
        [ -f "$_kernel" ] || bail "Kernel not found: $_kernel (run './lfs system build' first)"
        set -- -kernel "$_kernel"
        if [ -n "${DTB:-}" ]; then
            _dtb="$WORK_DIR/boot/$SYSTEM_KEY/$DTB"
            [ -f "$_dtb" ] || bail "DTB not found: $_dtb (run './lfs system build' first)"
            set -- "$@" -dtb "$_dtb"
        fi
        # Capability-gated QEMU devices. Both are virtio-pci, so they only
        # make sense where there's a PCI bus (virt); the Pi machine models
        # have none — real hardware support for these capabilities is
        # separate future work, not something to guard against here.
        case " $CAPS " in
            *" network "*)
                set -- "$@" -netdev user,id=net0 -device virtio-net-pci,netdev=net0
                ;;
        esac
        case " $CAPS " in
            *" 9p "*)
                set -- "$@" \
                    -fsdev local,id=lfs,path=$PROJECT_DIR,security_model=mapped-xattr \
                    -device virtio-9p-pci,fsdev=lfs,mount_tag=lfs
                ;;
        esac
        # Removable USB stick for the air-gapped GPG key-persist workflow
        # (see SELF-HOST.md, package/gpg-genkey.sh). virt/xhci form only —
        # pi0's dwc2 attach (real hardware has no PCI bus for qemu-xhci) is
        # a later increment, out of scope here. USB_DISK must already exist
        # (e.g. a blank vfat image created on the host); unset/empty is a
        # no-op, so a usb-capable build with no stick attached still boots
        # (just with no USB device present, same as the network/9p caps
        # above only wiring up when the guarding env var/CAPS conditions
        # hold). The virt root disk itself is virtio-blk (/dev/vda, see
        # QEMU_DISK_IF above) — this stick therefore enumerates in the
        # guest as the first SCSI/USB-storage disk, /dev/sda.
        case " $CAPS " in
            *" usb "*)
                if [ -n "${USB_DISK:-}" ]; then
                    [ -f "$USB_DISK" ] || bail "USB_DISK not found: $USB_DISK"
                    # cache=writethrough: every guest write is committed to
                    # $USB_DISK on the host as soon as the guest's own
                    # sync()/umount() say it's durable, rather than trusting
                    # QEMU's own write-back cache to still be intact by the
                    # time this same file is read back later (e.g. the host-
                    # side verification step, or a later boot with a fresh
                    # guest that never issues its own flush). This stick
                    # models removable media a guest can yank at any time
                    # (that's the whole point of the appliance — see
                    # gpg-genkey.sh): its persistence contract should rest on
                    # the guest's own explicit sync, not on however cleanly
                    # this particular QEMU process happens to exit afterward.
                    set -- "$@" \
                        -drive if=none,id=usbstick,format=raw,file=$USB_DISK,cache=writethrough \
                        -device qemu-xhci,id=xhci \
                        -device usb-storage,bus=xhci.0,drive=usbstick
                fi
                ;;
        esac
        # Cap-conditional read-only root (CAPS=amnesia — increment #2 of the
        # air-gapped GPG appliance, see SELF-HOST.md and
        # package/amnesia-config.sh). Sets ROOTFLAGS's own DEFAULT here,
        # rather than touching the "${ROOTFLAGS:-...}" fallback in the
        # -append line below, so: (a) ROOTFLAGS's existing override contract
        # (any caller can still set it directly) is untouched, and (b) the
        # no-amnesia fallback text below stays byte-identical to what it was
        # before this capability existed. nologreplay: btrfs replays its
        # crash-consistency log tree at mount time even under `ro` — that
        # replay writes to the device — so without this a "read-only" mount
        # would still, occasionally, touch the boot medium; nologreplay is
        # what actually makes the hash-identical proof (SELF-HOST.md) hold.
        case " $CAPS " in
            *" amnesia "*)
                : ${ROOTFLAGS:=rootfstype=btrfs rootflags=subvol=root/$ROOT_VOLUME,nologreplay ro rootwait}
                ;;
        esac
        # QEMU_EXTRA last: QEMU's own "last flag wins" rule for repeated
        # options (-smp/-m/...) lets this override QEMU_FLAGS's defaults
        # (e.g. the self-host builder guest needs more than virt's default
        # -smp 1 -m 512 to build a whole system natively — see SELF-HOST.md
        # M4) without editing the platform file itself. Empty by default,
        # so an unset QEMU_EXTRA changes nothing.
        exec $QEMU -nodefaults -no-user-config ${QEMU_FLAGS:-} \
            -no-reboot \
            "$@" \
            -append "${QEMU_APPEND:-} ${ROOTFLAGS:-rootfstype=btrfs rootflags=subvol=root/$ROOT_VOLUME rw rootwait}" \
            -drive "file=$IMAGE,format=raw,if=${QEMU_DISK_IF:-sd}" \
            ${QEMU_EXTRA:-}
        ;;

    help)
        echo "Usage: $(basename "$0") [-p PLATFORM] (tools|system|install|image|qemu)"
        echo ""
        echo "Commands:"
        echo "  tools            Build cross-compilation toolchain"
        echo "  system           Build all final system packages"
        echo "  install <PKG>... Install one or more packages"
        echo "  unarchive FILE [DEST]"
        echo "                   Extract a package tarball (DEST defaults to"
        echo "                   this system key's merged tree, e.g. / in a guest)"
        echo "  image [FILE]     Create bootable disk image"
        echo "  qemu [FILE]      Boot image in QEMU (creates image if needed)"
        echo ""
        echo "Options:"
        echo "  -p PLATFORM      Target platform (pi0, pi4, pi5)"
        echo "  -d DESTINATION   Install destination (dir, device, or .img file)"
        if [ $# -eq 1 ]; then exit 0; else exit 1; fi
        ;;

    *)
        bail "Unknown command '$1'"
esac
