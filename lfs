#!/bin/sh

set -o errexit -o nounset
umask 022

#===[ Framework ]===

readonly lfs_version=13.1

readonly project_dir=$(dirname $(realpath "$0"))
readonly package_dir=$project_dir/package

. $project_dir/lib/base.sh
. $project_dir/lib/package.sh
. $project_dir/lib/tools.sh
. $project_dir/lib/image.sh
. $project_dir/lib/qemu.sh

#===[ State Storage ]===

# Override if you wish to store artefacts in a custom dir.
: ${STATE_DIR:=$project_dir}

# Contains fetched archives. Allows offline work once all needed artefacts have been fetched.
: ${DOWNLOAD_DIR:=$STATE_DIR/download}

# Contains unarchived package sources.
: ${SOURCE_DIR:=$STATE_DIR/source}

# Build state.
: ${WORK_DIR:=$STATE_DIR/work}

# Build toolchains.
: ${TOOL_DIR:=$STATE_DIR/tools}

# Root filesystem being built.
: ${INSTALL_DIR:=$STATE_DIR/install}

# Built package archives.
: ${ARCHIVE_DIR:=$STATE_DIR/archive}

# Built images to be used on actual hardware, or emulators.
: ${IMAGE_DIR:=$STATE_DIR/image}

# Artefacts produced by bootstrap, needed to build a system from scratch.
: ${BOOTSTRAP_DIR:=$WORK_DIR/bootstrap}

readonly STATE_DIR DOWNLOAD_DIR SOURCE_DIR WORK_DIR TOOL_DIR \
         INSTALL_DIR ARCHIVE_DIR IMAGE_DIR BOOTSTRAP_DIR

#===[ System Characteristics ]===

# Parse the given system key, when provided.
if [ -n "${SYSTEM_KEY:-}" ]; then
    _platform_userland=${SYSTEM_KEY%%+*}
    _platform=${_platform_userland%%-*}
    _plus_caps=${SYSTEM_KEY#"$_platform_userland"} # "" or "+cap1+cap2..."
    : ${PLATFORM:=$_platform}
    if [ "$_platform" != "$_platform_userland" ]; then
        : ${USERLAND:=${_platform_userland#*-}}
    fi
    : ${CAPS=$(echo "$_plus_caps" | tr '+' ' ')}
    unset _platform_userland _platform _plus_caps
fi

#-- Platform: machine on which the built system will run.

: ${PLATFORM:=virt}

[ -f $project_dir/lib/platform/$PLATFORM.sh ] || bail "Unsupported platform '$PLATFORM'"

readonly PLATFORM

. $project_dir/lib/platform/$PLATFORM.sh

#-- Userland: init system and toolset.

: ${USERLAND:=systemd-gnu}

readonly USERLAND

#-- Capabilities: set of opt-in features layered on top of the base system.

readonly CAPS=$(printf '%s\n' ${CAPS:-} | sort -u | xargs)

#-- System key: canonical marker for the platform/userland/caps combination.

readonly SYSTEM_KEY=$PLATFORM-$USERLAND${CAPS:++$(set -- $CAPS; IFS=+; echo "$*")}

#===[ Compilation ]===

: ${build_vendor:=scratch}
: ${build_kernel:=linux}
if [ -n "${build_arch:-}" ]; then
    : ${build_abi:=gnu}
    readonly build_arch build_vendor build_kernel build_abi
    readonly build_triplet=$build_arch-$build_vendor-$build_kernel-$build_abi
fi

: ${target_vendor:=$build_vendor}
: ${target_kernel:=$build_kernel}
if [ -n "${target_arch:-}" ]; then
    : ${target_abi:=$build_abi}
    readonly target_arch target_vendor target_kernel target_abi
    readonly target_triplet=$target_arch-$target_vendor-$target_kernel-$target_abi
fi

export LC_ALL=POSIX
readonly LC_ALL

if command -v nproc >/dev/null 2>&1; then
    export MAKEFLAGS=-j$(nproc)
    readonly MAKEFLAGS
fi

# Toolchain usr/bin LAST. Do NOT put toolchain usr/bin first: once glibc-linked binaries are
# installed there they shadow host tools and fail (wrong ELF interpreter).  It still needs to be on
# PATH somewhere, though: build-time tools that only the toolchain itself provides (e.g. pkgconf)
# aren't on the host at all, so they're only found as a fallback after host tools are checked
# first.
export PATH=$TOOL_DIR/bin:$PATH:$TOOL_DIR/usr/bin:$TOOL_DIR/usr/sbin
readonly PATH

# Bison bakes the m4 path its configure found. Wherever a real /usr/bin/m4 exists, prefer it.
if [ -x /usr/bin/m4 ]; then
    : ${M4:=/usr/bin/m4}
    export M4
fi

#===[ Installation ]===

# BTRFS subvolume name to use as root filesystem.
readonly ROOT_VOLUME=${ROOT_VOLUME:-1}

trap unmount_all EXIT

# DESTINATION picks an install location.
if [ -n "${DESTINATION:-}" ]; then
    if [ -d "$DESTINATION" ]; then
        package_install_dir=$(realpath "$DESTINATION")
    elif [ -f "$DESTINATION" ]; then
        IMAGE="$DESTINATION" image
        package_install_dir=$ROOT_DIR
    elif [ -b "$DESTINATION" ]; then
        DEVICE="$DESTINATION" device
        package_install_dir=$ROOT_DIR
    elif [ "${DESTINATION%.img}" != "$DESTINATION" ]; then
        IMAGE="$DESTINATION" image
        package_install_dir=$ROOT_DIR
    else
        mkdir -pv "$DESTINATION"
        package_install_dir=$(realpath "$DESTINATION")
    fi
fi
unset DESTINATION

#===[ Command Execution ]===

case "${1:-help}" in
    pack)
        [ $# -eq 2 ] || usage "$1 <PACKAGE>"
        lfs_archive_package "$2"
        ;;

    install)
        [ $# -eq 2 ] || usage "$1 <PACKAGE>"
        lfs_install_package "$2"
        ;;

    tools)
        shift
        lfs_tools "$@"
        ;;

    image)
        shift
        image "$@"
        ;;

    qemu)
        shift
        qemu "$@"
        ;;

    help)
        echo "Usage: $(basename "$0") [-d DESTINATION] (tools|pack|install|image|qemu)"
        echo ""
        echo "Commands:"
        echo "  tools            Build cross-compilation toolchain"
        echo "  pack <PKG>       Build a package's archive"
        echo "  install <PKG>    Install a package"
        echo "  image build [IMAGE]"
        echo "                   Create bootable disk image from the built system"
        echo "  qemu [IMAGE]     Boot the built kernel + image in QEMU"
        echo ""
        echo "Options:"
        echo "  -d DESTINATION   Install destination (dir, device, or .img file)"
        echo ""
        echo "Environment:"
        echo "  PLATFORM         Target platform"
        echo "  USERLAND         Userland flavor, init system included"
        echo "  CAPS             Capability set"
        if [ $# -eq 1 ]; then exit 0; else exit 1; fi
        ;;

    *)
        bail "Unknown command '$1'"
esac
