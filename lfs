#!/bin/sh

set -o errexit -o nounset
umask 022

#===[ Framework ]===

readonly project_dir=$(dirname $(realpath "$0"))
readonly lib_dir=$project_dir/lib
readonly package_dir=$project_dir/package
readonly profile_dir=$project_dir/profile

. $lib_dir/base.sh
. $lib_dir/package.sh
. $lib_dir/components.sh
. $lib_dir/meson.sh
. $lib_dir/tools.sh
. $lib_dir/sbom.sh
. $lib_dir/check.sh
. $lib_dir/system.sh
. $lib_dir/image.sh
. $lib_dir/qemu.sh

#===[ Environment ]===

# The variables that builds see of the environment lfs is started in: its external API, PATH and
# TMPDIR. As in a container, nothing else of the caller's comes in, such as what steers compilers,
# pkg-config or interpreters (CFLAGS, PKG_CONFIG_PATH, PYTHONPATH...). QEMU runs in the caller's.
readonly lfs_environment="LFS_PROFILE LFS_TIMEZONE LFS_ERASE \
    LFS_MACHINE LFS_RELEASE LFS_VERSION_CODENAME LFS_RELEASE_TYPE LFS_DISTRIB_CODENAME \
    LFS_DISTRIB_DESCRIPTION LFS_ROOT_VOLUME \
    LFS_STATE_DIR LFS_DOWNLOAD_DIR LFS_SOURCE_DIR LFS_WORK_DIR LFS_TOOL_DIR LFS_INSTALL_DIR \
    LFS_ARCHIVE_DIR LFS_IMAGE_DIR LFS_BOOTSTRAP_DIR PATH TMPDIR"

# Starts lfs anew with the same arguments in an environment that holds those variables alone,
# unless it holds no other already. PWD, OLDPWD, SHLVL and _ are the shell's own. The names come
# from env, which prints the environment as it is: gawk's ENVIRON adds AWKPATH and AWKLIBPATH,
# which would have lfs start anew without end.
lfs_clean_environment() {
    local name
    for name in $(env | sed -n 's/=.*//p'); do
        case " $lfs_environment PWD OLDPWD SHLVL _ " in
            *" $name "*) ;;
            *)
                set -- "$project_dir/lfs" "$@"
                for name in $lfs_environment; do
                    eval "[ -z \"\${$name+set}\" ] || set -- \"$name=\$$name\" \"\$@\""
                done
                exec env -i "$@"
                ;;
        esac
    done
}

case "${1:-help}" in
    qemu|help) ;;
    *) lfs_clean_environment "$@" ;;
esac

# git behaves the same whatever the user's configuration. Set after the environment is cleaned, which
# would start lfs anew for these variables, as they are not its own.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

#===[ State Storage ]===

# Override if you wish to store artefacts in a custom dir.
: ${LFS_STATE_DIR:=$project_dir}

# Contains fetched archives. Allows offline work once all needed artefacts have been fetched.
: ${LFS_DOWNLOAD_DIR:=$LFS_STATE_DIR/download}

# Contains unarchived package sources.
: ${LFS_SOURCE_DIR:=$LFS_STATE_DIR/source}

# Build state.
: ${LFS_WORK_DIR:=$LFS_STATE_DIR/work}

# Build toolchains.
: ${LFS_TOOL_DIR:=$LFS_STATE_DIR/tools}

# Root filesystem being built.
: ${LFS_INSTALL_DIR:=$LFS_STATE_DIR/install}

# Built package archives.
: ${LFS_ARCHIVE_DIR:=$LFS_STATE_DIR/archive}

# Built images to be used on actual hardware, or emulators.
: ${LFS_IMAGE_DIR:=$LFS_STATE_DIR/image}

# Artefacts produced by bootstrap, needed to build a system from scratch.
: ${LFS_BOOTSTRAP_DIR:=$LFS_WORK_DIR/bootstrap}

# LFS_SOURCE_DIR is made read-only below, once the key of what unpacks there is known.
readonly LFS_STATE_DIR LFS_DOWNLOAD_DIR LFS_WORK_DIR LFS_TOOL_DIR \
         LFS_INSTALL_DIR LFS_ARCHIVE_DIR LFS_IMAGE_DIR LFS_BOOTSTRAP_DIR

#===[ System Characteristics ]===

#-- Profile: the whole system to build, as the list of packages in profile/<profile>.sh. Its name is
#   the key of everything the build makes: the packages' archives, the install tree, the sysroot, the
#   kernel in LFS_WORK_DIR/boot and the image.

# `qemu IMAGE` boots the image of the profile that its name, <profile>.img, gives, unless
# LFS_PROFILE says otherwise.
if [ -z "${LFS_PROFILE:-}" ] && [ "${1:-}" = qemu ] && [ $# -ge 2 ]; then
    _image=${2##*/}
    [ ! -f $profile_dir/${_image%.img}.sh ] || LFS_PROFILE=${_image%.img}
    unset _image
fi

: ${LFS_PROFILE:=virt}

[ -f $profile_dir/$LFS_PROFILE.sh ] || bail "Unknown profile '$LFS_PROFILE'"

readonly LFS_PROFILE

#-- Platform: hardware on which the built system will run, the start of the profile's name, up to its
#   first `-`: `pi0` for `pi0-pgp`, `virt` for `virt`.

readonly platform=${LFS_PROFILE%%-*}

[ -f $project_dir/platform/$platform.sh ] \
    || bail "Unsupported platform '$platform': a profile is named <platform>[-<name>]" \
            "('$LFS_PROFILE')"

. $project_dir/platform/$platform.sh

#-- Package key: the key under which the system's packages are archived.

package_key=$LFS_PROFILE

#-- Source directory: sources are unpacked and patched in place, so the tools and each profile have a
#   directory of their own in LFS_SOURCE_DIR. Builds of different profiles run at once, and one
#   would patch, or discard after a failed patch, the source that another compiles. Downloads are
#   shared, as they are written whole and checked by hash.

case "${1:-help}" in
    tools) readonly LFS_SOURCE_DIR=$LFS_SOURCE_DIR/$tools_key ;;
    fetch) readonly LFS_SOURCE_DIR=$(mktemp -d) ;;
    *)     readonly LFS_SOURCE_DIR=$LFS_SOURCE_DIR/$package_key ;;
esac

#===[ Compilation ]===

: ${build_vendor:=scratch}
: ${build_kernel:=linux}
: ${build_abi:=gnu}
if [ -n "${build_arch:-}" ]; then
    readonly build_arch build_vendor build_kernel build_abi
    readonly build_triplet=$build_arch-$build_vendor-$build_kernel-$build_abi
fi

: ${target_vendor:=$build_vendor}
: ${target_kernel:=$build_kernel}
if [ -n "${target_arch:-}" ]; then
    : ${target_abi:=$build_abi}
    readonly target_arch target_vendor target_kernel target_abi
    readonly target_triplet=$target_arch-$target_vendor-$target_kernel-$target_abi
fi

export LC_ALL=POSIX
readonly LC_ALL

if command -v nproc >/dev/null 2>&1; then
    export MAKEFLAGS=-j$(nproc)
    readonly MAKEFLAGS
fi

# The bootstrap builds the first tools with the host's, fetching downloads and unpacks with them, and
# QEMU runs on the host. Every other command builds with the tools alone, as the scratch container
# does, so that nothing of the host's (a program, a config script, an interpreter, a trust store)
# finds its way into a build.
case "${1:-help} ${2:-}" in
    'tools bootstrap'|fetch\ *|qemu\ *|help\ *)
        export PATH=$LFS_TOOL_DIR/bin:$PATH:$LFS_TOOL_DIR/usr/bin:$LFS_TOOL_DIR/usr/sbin
        # Bison bakes the m4 path its configure found. Wherever a real /usr/bin/m4 exists, prefer
        # it.
        if [ -x /usr/bin/m4 ]; then
            : ${M4:=/usr/bin/m4}
            export M4
        fi
        ;;
    *)
        export PATH=$LFS_TOOL_DIR/bin:$LFS_TOOL_DIR/usr/bin:$LFS_TOOL_DIR/usr/sbin
        # The tools' openssl looks in the host's /etc/ssl, unless told otherwise.
        export SSL_CERT_FILE=$LFS_TOOL_DIR/etc/ssl/cert.pem SSL_CERT_DIR=$LFS_TOOL_DIR/etc/ssl/certs
        ;;
esac
readonly PATH

# A home of the build's own, rather than the user's, with its configuration files.
case "${1:-help}" in
    qemu|help) ;;
    *) export HOME=$LFS_WORK_DIR ;;
esac

#===[ Installation ]===

# BTRFS subvolume name to use as root filesystem.
readonly LFS_ROOT_VOLUME=${LFS_ROOT_VOLUME:-1}

#===[ Command Execution ]===

case "${1:-help}" in
    fetch)
        [ $# -eq 1 ] || usage "$1"
        lfs_fetch
        ;;

    pack)
        [ $# -eq 2 ] || usage "$1 <PACKAGE>"
        lfs_archive_package "$2"
        ;;

    check)
        [ $# -le 2 ] || usage "$1 [PACKAGE]"
        shift
        lfs_check "$@"
        ;;

    tools)
        shift
        lfs_tools "$@"
        ;;

    system)
        shift
        lfs_system "$@"
        ;;

    image)
        shift
        image "$@"
        ;;

    qemu)
        shift
        qemu "$@"
        ;;

    help)
        echo "Usage: $(basename "$0") (fetch|tools|system|pack|check|image|qemu)"
        echo ""
        echo "Commands:"
        echo "  fetch            Download the sources of every package, for the profile's platform"
        echo "  tools            Build the build tools"
        echo "  system build     Build the system for the platform"
        echo "  pack <PKG>       Build a package's archive"
        echo "  check [PKG]      Check the built system, or what the package put in it"
        echo "  image build [IMAGE|DEVICE]"
        echo "                   Create a bootable disk image, with its SBOM, or format a block"
        echo "                   device, from the built system"
        echo "  qemu [IMAGE]     Boot the built kernel + image in QEMU (LFS_PROFILE: that of"
        echo "                   <profile>.img)"
        echo ""
        echo "Environment:"
        echo "  LFS_PROFILE      The system to build, as profile/<profile>.sh lists it; virt by default"
        echo "  LFS_TIMEZONE     The image's time zone, as named in the tz database; UTC by default"
        echo "  LFS_ERASE        The block device that image build may erase; the same path as the"
        echo "                   DEVICE argument. A device is never erased without it"
        if [ $# -eq 1 ]; then exit 0; else exit 1; fi
        ;;

    *)
        bail "Unknown command '$1'"
esac
