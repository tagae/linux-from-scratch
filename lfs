#!/bin/sh

set -o errexit -o nounset
umask 022

readonly PROJECT_DIR=$(dirname $(realpath "$0"))
readonly PACKAGE_DIR=$PROJECT_DIR/package

. $PROJECT_DIR/lib/base.sh
. $PROJECT_DIR/lib/package.sh
. $PROJECT_DIR/lib/tools.sh
. $PROJECT_DIR/lib/image.sh

CMD_ARGS=$(getopt "d:h" "$@")
[ $? -eq 0 ] || bail "Could not parse options"

eval set -- "$CMD_ARGS"

while [ $# -gt 0 ]; do
    case "${1:-}" in
        -d)
            dest=
            [ $? -eq 0 ] || bail "Invalid destination: $2"
            if [ -d "$2" ]; then
                package_install_dir=$(realpath "$2")
            elif [ -f "$2" ]; then
                IMAGE="$2" image
                package_install_dir=$ROOT_DIR
            elif [ -b "$2" ]; then
                DEVICE="$2" device
            elif [[ "$2" == *.img ]]; then
                IMAGE="$2" image
                package_install_dir=$ROOT_DIR
            else
                mkdir -pv "$2"
                package_install_dir=$(realpath $2)
            fi
            shift 2
            ;;
        -h)
            eval set -- help
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            bail "BUG"
            ;;
    esac
done

: ${OUTPUT_DIR:=$PROJECT_DIR}
: ${DOWNLOAD_DIR:=$OUTPUT_DIR/download}
: ${SOURCE_DIR:=$OUTPUT_DIR/source}
: ${WORK_DIR:=$OUTPUT_DIR/work}
: ${TOOL_DIR:=$OUTPUT_DIR/tools}
: ${INSTALL_DIR:=$OUTPUT_DIR/install}
: ${ARCHIVE_DIR:=$OUTPUT_DIR/archive}
: ${IMAGE_DIR:=$OUTPUT_DIR/image}

# Freeze config
readonly DOWNLOAD_DIR SOURCE_DIR WORK_DIR TOOL_DIR INSTALL_DIR ARCHIVE_DIR IMAGE_DIR

trap cleanup EXIT

case "${1:-help}" in
    tools)
        [ $# -eq 2 ] || usage "$1 <PLATFORM>"
        platform "$2"
        tools
        ;;

    base)
        [ $# -eq 2 ] || usage "$1 <PLATFORM>"
        platform "$2"
        package_install_dir=$INSTALL_DIR
        install system-files
        install linux
        ;;

    install)
        [ $# -ge 3 ] || usage "$1 <PLATFORM> <PACKAGE>..."
        platform "$2"
        shift 2
        for pkg in "$@"; do
            install "$pkg"
        done
        ;;

    image)
        [ $# -eq 2 ] || [ $# -eq 3 ] || usage "$1 <PLATFORM> [FILE]"
        platform "$2"
        image "${3:-$IMAGE_DIR/$2.img}"
        ;;

    help)
        echo "Usage: $(basename "$0") (tools|install|image)"
        if [ $# -eq 1 ]; then exit 0; else exit 1; fi
        ;;

    *)
        bail "Unknown command '$1'"
esac
