#!/bin/sh

set -o errexit -o nounset
umask 022

readonly PROJECT_DIR=$(dirname $(realpath "$0"))
readonly PACKAGE_DIR=$PROJECT_DIR/package

. $PROJECT_DIR/lib/base.sh
. $PROJECT_DIR/lib/package.sh
. $PROJECT_DIR/lib/tools.sh
. $PROJECT_DIR/lib/image.sh

#--[ Command line ]

CMD_ARGS=$(getopt "p:d:h" "$@")
[ $? -eq 0 ] || bail "Could not parse options"

eval set -- "$CMD_ARGS"

while [ $# -gt 0 ]; do
    case "${1:-}" in
        -p)
            [ $? -eq 0 ] || bail "Invalid platform: $2"
            PLATFORM="$2"
            shift 2
            ;;
        -d)
            [ $? -eq 0 ] || bail "Invalid destination: $2"
            DESTINATION="$2"
            shift 2
            ;;
        -h)
            eval set -- help
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            bail "BUG"
            ;;
    esac
done

#--[ Project ]

: ${OUTPUT_DIR:=$PROJECT_DIR}
: ${DOWNLOAD_DIR:=$OUTPUT_DIR/download}
: ${SOURCE_DIR:=$OUTPUT_DIR/source}
: ${WORK_DIR:=$OUTPUT_DIR/work}
: ${TOOL_DIR:=$OUTPUT_DIR/tools}
: ${INSTALL_DIR:=$OUTPUT_DIR/install}
: ${ARCHIVE_DIR:=$OUTPUT_DIR/archive}
: ${IMAGE_DIR:=$OUTPUT_DIR/image}

readonly DOWNLOAD_DIR SOURCE_DIR WORK_DIR TOOL_DIR INSTALL_DIR ARCHIVE_DIR IMAGE_DIR

#--[ Target platform ]

[ -n "${PLATFORM:-}" ] || bail "No platform specified"
[ -f $PROJECT_DIR/lib/platform/$PLATFORM.sh ] || bail "Unsupported platform '$PLATFORM'"

readonly PLATFORM

. $PROJECT_DIR/lib/platform/$PLATFORM.sh

#--[ Compilation ]

export LC_ALL=POSIX
export MAKEFLAGS=-j$(nproc)

readonly LC_ALL MAKEFLAGS

PATH=$TOOL_DIR/bin:$TOOL_DIR/usr/bin:$PATH

#-- [ Installation ]

#readonly ROOT_VOLUME=$(date +%Y-%m-%d-%H-%M-%S)
readonly ROOT_VOLUME=${ROOT_VOLUME:-1}

trap cleanup EXIT

#--[ Command ]

case "${1:-help}" in
    tools)
        [ $# -eq 1 ] || usage "$1"
        tools
        ;;

    install)
        [ $# -ge 2 ] || usage "$1 <PACKAGE>..."
        shift

        if [ -z "${DESTINATION:-}" ]; then
            true
        elif [ -d "$DESTINATION" ]; then
            package_install_dir=$(realpath "$DESTINATION")
        elif [ -f "$DESTINATION" ]; then
            IMAGE="$DESTINATION" image
            package_install_dir=$ROOT_DIR
        elif [ -b "$DESTINATION" ]; then
            DEVICE="$DESTINATION" device
            package_install_dir=$ROOT_DIR
        elif [[ "$DESTINATION" == *.img ]]; then
            IMAGE="$DESTINATION" image
            package_install_dir=$ROOT_DIR
        else
            mkdir -pv "$DESTINATION"
            package_install_dir=$(realpath "$DESTINATION")
        fi

        for pkg in "$@"; do
            install "$pkg"
        done
        ;;

    emu)
        [ $# -le 2 ] || usage "$1 [IMAGE]"
        IMAGE="${2:-$IMAGE_DIR/$PLATFORM.img}" image
        qemu-system-arm \
            -nodefaults -no-user-config \
            -M raspi0 -serial stdio \
            -kernel $INSTALL_DIR/boot/vmlinux-6.12.38-pi0+ \
            -append "$(cat $INSTALL_DIR/boot/cmdline.txt)" \
            -hda
        ;;

    help)
        echo "Usage: $(basename "$0") (tools|install|image)"
        if [ $# -eq 1 ]; then exit 0; else exit 1; fi
        ;;

    *)
        bail "Unknown command '$1'"
esac
