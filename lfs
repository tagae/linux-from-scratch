#!/bin/sh

set -o errexit -o nounset
umask 022

#===[ Framework ]===

readonly lfs_version=13.1

readonly project_dir=$(dirname $(realpath "$0"))
readonly lib_dir=$project_dir/lib
readonly package_dir=$project_dir/package
readonly capability_dir=$project_dir/capability
readonly feature_dir=$project_dir/feature

. $lib_dir/base.sh
. $lib_dir/package.sh
. $lib_dir/components.sh
. $lib_dir/meson.sh
. $lib_dir/tools.sh
. $lib_dir/system.sh
. $lib_dir/image.sh
. $lib_dir/qemu.sh

#===[ Environment ]===

# The variables that builds see of the environment lfs is started in: its external API, PATH and
# TMPDIR. As in a container, nothing else of the caller's comes in, such as what steers compilers,
# pkg-config or interpreters (CFLAGS, PKG_CONFIG_PATH, PYTHONPATH...). QEMU runs in the caller's.
readonly lfs_environment="PLATFORM USERLAND CAPS FEATURES SYSTEM_KEY TIMEZONE IMAGE_SIZE ERASE \
    MACHINE LFS_RELEASE VERSION_CODENAME RELEASE_TYPE DISTRIB_CODENAME DISTRIB_DESCRIPTION \
    ROOT_VOLUME STATE_DIR DOWNLOAD_DIR SOURCE_DIR WORK_DIR TOOL_DIR INSTALL_DIR ARCHIVE_DIR \
    IMAGE_DIR BOOTSTRAP_DIR PATH TMPDIR"

# Starts lfs anew with the same arguments in an environment that holds those variables alone,
# unless it holds no other already. PWD, OLDPWD, SHLVL and _ are the shell's own. The names come
# from env, which prints the environment as it is: gawk's ENVIRON adds AWKPATH and AWKLIBPATH,
# which would have lfs start anew without end.
lfs_clean_environment() {
    local name
    for name in $(env | sed -n 's/=.*//p'); do
        case " $lfs_environment PWD OLDPWD SHLVL _ " in
            *" $name "*) ;;
            *)
                set -- "$project_dir/lfs" "$@"
                for name in $lfs_environment; do
                    eval "[ -z \"\${$name+set}\" ] || set -- \"$name=\$$name\" \"\$@\""
                done
                exec env -i "$@"
                ;;
        esac
    done
}

case "${1:-help}" in
    qemu|help) ;;
    *) lfs_clean_environment "$@" ;;
esac

#===[ State Storage ]===

# Override if you wish to store artefacts in a custom dir.
: ${STATE_DIR:=$project_dir}

# Contains fetched archives. Allows offline work once all needed artefacts have been fetched.
: ${DOWNLOAD_DIR:=$STATE_DIR/download}

# Contains unarchived package sources.
: ${SOURCE_DIR:=$STATE_DIR/source}

# Build state.
: ${WORK_DIR:=$STATE_DIR/work}

# Build toolchains.
: ${TOOL_DIR:=$STATE_DIR/tools}

# Root filesystem being built.
: ${INSTALL_DIR:=$STATE_DIR/install}

# Built package archives.
: ${ARCHIVE_DIR:=$STATE_DIR/archive}

# Built images to be used on actual hardware, or emulators.
: ${IMAGE_DIR:=$STATE_DIR/image}

# Artefacts produced by bootstrap, needed to build a system from scratch.
: ${BOOTSTRAP_DIR:=$WORK_DIR/bootstrap}

readonly STATE_DIR DOWNLOAD_DIR SOURCE_DIR WORK_DIR TOOL_DIR \
         INSTALL_DIR ARCHIVE_DIR IMAGE_DIR BOOTSTRAP_DIR

#===[ System Characteristics ]===

# Parse the given system key, when provided.
if [ -n "${SYSTEM_KEY:-}" ]; then
    _platform_userland=${SYSTEM_KEY%%+*}
    _platform=${_platform_userland%%-*}
    : ${PLATFORM:=$_platform}
    if [ "$_platform" != "$_platform_userland" ]; then
        : ${USERLAND:=${_platform_userland#*-}}
    fi
    # The rest is "" or "+item1+item2...", each item a capability or else a feature.
    _caps= _features=
    for _item in $(echo "${SYSTEM_KEY#"$_platform_userland"}" | tr '+' ' '); do
        if [ -f $capability_dir/$_item.config ]; then
            _caps="$_caps $_item"
        else
            _features="$_features $_item"
        fi
    done
    : ${CAPS=$_caps} ${FEATURES=$_features}
    unset _platform_userland _platform _item _caps _features
fi

#-- Platform: machine on which the built system will run.

: ${PLATFORM:=virt}

[ -f $project_dir/platform/$PLATFORM.sh ] || bail "Unsupported platform '$PLATFORM'"

readonly PLATFORM

. $project_dir/platform/$PLATFORM.sh

#-- Userland: init system and toolset.

: ${USERLAND:=systemd-gnu}

readonly USERLAND

#-- Capabilities: what the system supports, such as USB devices, as kernel configuration. Features:
#   tool sets for the system's users, which rely on capabilities. Both are opt-in, and layered on
#   top of the base system.

readonly CAPS=$(printf '%s\n' ${CAPS:-} | sort -u | xargs)
readonly FEATURES=$(printf '%s\n' ${FEATURES:-} | sort -u | xargs)

# The capabilities that come with the given ones and with the features. A system has a single key,
# which leaves them out.
capabilities=
# The userland's own kernel support comes with it.
lfs_add_capability $USERLAND
for cap in $CAPS; do
    [ -f $capability_dir/$cap.config ] || bail "Unknown capability '$cap'"
    for required in $(lfs_requires $capability_dir/$cap.config); do
        lfs_add_capability $required
    done
done
for feature in $FEATURES; do
    [ -f $feature_dir/$feature.sh ] || bail "Unknown feature '$feature'"
    for required in $(lfs_requires $feature_dir/$feature.sh); do
        lfs_add_capability $required
    done
done
for cap in $CAPS; do
    case " $capabilities " in
        *" $cap "*) bail "Capability '$cap' comes with the others: leave it out" ;;
    esac
done

# All the system's capabilities, in alphabetical order, so that systems with the same capabilities
# share their archives.
readonly capabilities=$(printf '%s\n' $capabilities $CAPS | sort | xargs)
readonly features=$FEATURES

#-- System key: canonical marker for the platform/userland/capabilities/features combination.

_all=$(printf '%s\n' $CAPS $FEATURES | sort | xargs)
readonly SYSTEM_KEY=$PLATFORM-$USERLAND${_all:++$(set -- $_all; IFS=+; echo "$*")}
unset cap feature required _all

#-- Package key: the system key of the system as it stands when a package is built, under which
#   the package is archived. Capabilities, then features, are added one by one, each extending it,
#   so that systems share the archives of what they have in common.

package_key=$PLATFORM-$USERLAND

#===[ Compilation ]===

: ${build_vendor:=scratch}
: ${build_kernel:=linux}
: ${build_abi:=gnu}
if [ -n "${build_arch:-}" ]; then
    readonly build_arch build_vendor build_kernel build_abi
    readonly build_triplet=$build_arch-$build_vendor-$build_kernel-$build_abi
fi

: ${target_vendor:=$build_vendor}
: ${target_kernel:=$build_kernel}
if [ -n "${target_arch:-}" ]; then
    : ${target_abi:=$build_abi}
    readonly target_arch target_vendor target_kernel target_abi
    readonly target_triplet=$target_arch-$target_vendor-$target_kernel-$target_abi
fi

export LC_ALL=POSIX
readonly LC_ALL

if command -v nproc >/dev/null 2>&1; then
    export MAKEFLAGS=-j$(nproc)
    readonly MAKEFLAGS
fi

# The bootstrap builds the first tools with the host's, and QEMU runs on the host. Every other
# command builds with the tools alone, as the scratch container does, so that nothing of the
# host's (a program, a config script, an interpreter, a trust store) finds its way into a build.
case "${1:-help} ${2:-}" in
    'tools bootstrap'|qemu\ *|help\ *)
        export PATH=$TOOL_DIR/bin:$PATH:$TOOL_DIR/usr/bin:$TOOL_DIR/usr/sbin
        # Bison bakes the m4 path its configure found. Wherever a real /usr/bin/m4 exists, prefer
        # it.
        if [ -x /usr/bin/m4 ]; then
            : ${M4:=/usr/bin/m4}
            export M4
        fi
        ;;
    *)
        export PATH=$TOOL_DIR/bin:$TOOL_DIR/usr/bin:$TOOL_DIR/usr/sbin
        # The tools' openssl looks in the host's /etc/ssl, unless told otherwise.
        export SSL_CERT_FILE=$TOOL_DIR/etc/ssl/cert.pem SSL_CERT_DIR=$TOOL_DIR/etc/ssl/certs
        ;;
esac
readonly PATH

# A home of the build's own, rather than the user's, with its configuration files.
case "${1:-help}" in
    qemu|help) ;;
    *) export HOME=$WORK_DIR ;;
esac

#===[ Installation ]===

# BTRFS subvolume name to use as root filesystem.
readonly ROOT_VOLUME=${ROOT_VOLUME:-1}

#===[ Command Execution ]===

case "${1:-help}" in
    pack)
        [ $# -eq 2 ] || usage "$1 <PACKAGE>"
        lfs_archive_package "$2"
        ;;

    tools)
        shift
        lfs_tools "$@"
        ;;

    system)
        shift
        lfs_system "$@"
        ;;

    image)
        shift
        image "$@"
        ;;

    qemu)
        shift
        qemu "$@"
        ;;

    help)
        echo "Usage: $(basename "$0") (tools|system|pack|image|qemu)"
        echo ""
        echo "Commands:"
        echo "  tools            Build the build tools"
        echo "  system build     Build the system for the platform"
        echo "  pack <PKG>       Build a package's archive"
        echo "  image build [IMAGE|DEVICE]"
        echo "                   Create a bootable disk image, or format a block device, from the"
        echo "                   built system"
        echo "  qemu [IMAGE]     Boot the built kernel + image in QEMU"
        echo ""
        echo "Environment:"
        echo "  PLATFORM         Target platform"
        echo "  USERLAND         Userland flavor, init system included"
        echo "  CAPS             Capabilities, such as USB devices, beyond those that come with the"
        echo "                   features"
        echo "  FEATURES         Features: tool sets, such as GnuPG"
        echo "  TIMEZONE         The image's time zone, as named in the tz database; UTC by default"
        echo "  IMAGE_SIZE       The image file's size, as truncate takes it (512M), with the root"
        echo "                   file system filling it; by default as small as the system allows"
        echo "  ERASE            The block device that image build may erase; the same path as the"
        echo "                   DEVICE argument. A device is never erased without it"
        if [ $# -eq 1 ]; then exit 0; else exit 1; fi
        ;;

    *)
        bail "Unknown command '$1'"
esac
