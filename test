#!/usr/bin/expect -f

# Boot the image in QEMU, log in as root, and power off.
#
# Exits 0 on success, 1 on any failure.
#
# Usage: [TEST_TIMEOUT=seconds] ./test [PROFILE]

if {[llength $argv] > 0} {
    set env(PROFILE) [lindex $argv 0]
}

# TEST_TIMEOUT overrides the default per-phase timeout.
set timeout [expr {[info exists env(TEST_TIMEOUT)] ? $env(TEST_TIMEOUT) : 120}]

# Don't mirror the spawned process's raw output to our controlling terminal. The guest sends escape
# queries like cursor-position/window-size requests over the serial console; with logging on, those
# reach the real terminal, which answers them —but by the time the reply arrives the guest/qemu are
# already gone, so it's left sitting as garbage input at the next shell prompt.
log_user 0

spawn ./lfs qemu

expect {
    "login:" { }
    timeout   { puts "\nFAIL: timed out waiting for login prompt"; exit 1 }
    eof       { puts "\nFAIL: QEMU exited before login prompt"; exit 1 }
}

send "root\r"

expect {
    "Password:" {
        send "root\r"
        expect {
            -re {[#$] $} { }
            timeout { puts "\nFAIL: timed out after password"; exit 1 }
            eof     { puts "\nFAIL: QEMU exited after password"; exit 1 }
        }
    }
    -re {[#$] $} { }
    timeout { puts "\nFAIL: timed out after username"; exit 1 }
    eof     { puts "\nFAIL: QEMU exited after username"; exit 1 }
}

send "poweroff\r"

expect {
    eof     { }
    timeout { puts "\nFAIL: timed out waiting for QEMU to exit after poweroff"; exit 1 }
}

lassign [wait] _ _ _ exit_code
if {$exit_code == 0} {
    puts "PASS: booted, logged in as root, powered off cleanly"
    exit 0
} else {
    puts "FAIL: QEMU exited with code $exit_code"
    exit 1
}
