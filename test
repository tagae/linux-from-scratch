#!/usr/bin/expect -f
# Boot the platform image in QEMU, log in as root, and poweroff.
# Exits 0 on success, 1 on any failure.
# Usage: [TEST_TIMEOUT=seconds] ./test [PLATFORM] [INIT]
#
# PLATFORM (virt/pi0/pi4) and the optional INIT flavor (systemd/busybox)
# are passed through as env vars, the same convention the Makefile uses, so
# ./lfs qemu picks the matching kernel and image. The login/prompt/poweroff
# flow below is identical for both flavors (busybox getty/login/ash present
# the same "login:"/"Password:"/shell-prompt sequence as systemd's).

if {[llength $argv] > 0} {
    set env(PLATFORM) [lindex $argv 0]
}
if {[llength $argv] > 1} {
    set env(INIT) [lindex $argv 1]
}

# TEST_TIMEOUT overrides the default per-phase timeout.
set timeout [expr {[info exists env(TEST_TIMEOUT)] ? $env(TEST_TIMEOUT) : 120}]

# Don't mirror the spawned process's raw output to our controlling
# terminal. The guest (systemd's console-size probing, bash on login) sends
# escape queries like cursor-position/window-size requests over the serial
# console; with logging on, those reach the real terminal, which answers
# them — but by the time the reply arrives the guest/qemu are already gone,
# so it's left sitting as garbage input at the next shell prompt. Pattern
# matching below still sees the full raw stream regardless of log_user.
log_user 0

spawn ./lfs qemu

expect {
    "login:" { }
    timeout   { puts "\nFAIL: timed out waiting for login prompt"; exit 1 }
    eof       { puts "\nFAIL: QEMU exited before login prompt"; exit 1 }
}

send "root\r"

expect {
    "Password:" {
        send "root\r"
        expect {
            -re {[#$] $} { }
            timeout { puts "\nFAIL: timed out after password"; exit 1 }
            eof     { puts "\nFAIL: QEMU exited after password"; exit 1 }
        }
    }
    -re {[#$] $} { }
    timeout { puts "\nFAIL: timed out after username"; exit 1 }
    eof     { puts "\nFAIL: QEMU exited after username"; exit 1 }
}

send "poweroff\r"

expect {
    eof     { }
    timeout { puts "\nFAIL: timed out waiting for QEMU to exit after poweroff"; exit 1 }
}

lassign [wait] _ _ _ exit_code
if {$exit_code == 0} {
    puts "PASS: booted, logged in as root, powered off cleanly"
    exit 0
} else {
    puts "FAIL: QEMU exited with code $exit_code"
    exit 1
}
