{
  "$schema": "https://opencode.ai/config.json",
  "model": "mlx/qwen3-coder-30b-a3b-6bit",
  "compaction": {
    "auto": true,
    "buffer": 2048,
    "keep": {
      "tokens": 8192
    }
  },
  "providers": {
    "mlx": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "MLX (local)",
      "settings": {
        "baseURL": "http://host.docker.internal:8080/v1"
      },
      "models": {
        "qwen3.8-27b-4bit": {
          "name": "Qwen 3.8 27B 4-bit (MLX)",
          "modelID": "mlx-community/Qwen3.8-27B-4bit",
          "limit": {
            "context": 65536,
            "output": 4096
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen3-coder-30b-a3b-4bit": {
          "name": "Qwen3-Coder 30B-A3B Instruct 4-bit (MLX)",
          "modelID": "mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen3-coder-30b-a3b-6bit": {
          "name": "Qwen3-Coder 30B-A3B Instruct 6-bit (MLX)",
          "modelID": "mlx-community/Qwen3-Coder-30B-A3B-Instruct-6bit",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "gemma-4-31b-4bit": {
          "name": "Gemma 4 31B 4-bit (MLX)",
          "modelID": "mlx-community/gemma-4-31b-4bit",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen3.8-27b-4bit": {
          "name": "Qwen 38 27B 4bit Rapid MLX",
          "modelID": "qwen3.8-27b-4bit",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
