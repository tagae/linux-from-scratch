FROM busybox:1.37.0-musl

ARG HOST_UID
ARG HOST_GID
RUN addgroup -g $HOST_GID lfs && adduser -D -H -u $HOST_UID -G lfs lfs

RUN mkdir -pv /var/lfs/tools /var/lfs/source /var/lfs/work /var/lfs/install
RUN chown lfs:lfs /var/lfs /var/lfs/tools /var/lfs/source /var/lfs/work /var/lfs/install

WORKDIR /var/lfs

USER lfs
