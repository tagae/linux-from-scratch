FROM alpine:3.23.4

RUN delgroup dialout # conflicts with macOS

RUN apk update
RUN apk add build-base git rsync bison gawk python3 patchelf # grep file

ARG HOST_UID
ARG HOST_GID
RUN addgroup -g $HOST_GID lfs
RUN adduser -D -h /mnt/lfs -u $HOST_UID -G lfs lfs

RUN mkdir -pv \
    /mnt/lfs/download \
    /mnt/lfs/image \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

RUN chown lfs:lfs \
    /mnt/lfs \
    /mnt/lfs/download \
    /mnt/lfs/image \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

USER lfs
WORKDIR /mnt/lfs
