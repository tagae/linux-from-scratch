# Kernel configuration for the hidraw capability: HID devices on USB, such as the FIDO2 interface of
# a security key, read and written through /dev/hidraw*.

# Requires: usb

# --- HID devices on USB, exposed raw ---
CONFIG_INPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
CONFIG_USB_HID=y
