# The key procedure of the profile: gpg-genkey makes a key in memory and exports it to the stick.
# QEMU has no YubiKey to add randomness to the Pi's, which gpg-genkey warns of.

login user
set output [run_ok {gpg-genkey -n 'Test User' -e test@example.org -p 'a passphrase'}]
expect_match $output {no YubiKey answered} "the warning that the keys rest on the Pi's generator"
expect_match $output {done} "gpg-genkey"
run_ok {[ ! -e /run/gnupg/card-random ]}
run_ok {[ -s /mnt/keys/test@example.org-secret.asc ] && [ -s /mnt/keys/test@example.org-public.asc ] && [ -s /mnt/keys/test@example.org-revoke.asc ]}
expect_match [run_ok {gpg --list-secret-keys}] {test@example\.org} "the key, which stays in memory"
logout
