# The GnuPG home of the regular account is its own, in its home directory, which is memory that never
# swaps (the overlay of /home), and gpg makes it for the account alone.

login user
run_ok {gpg --list-keys}
expect_equal [run_ok {stat -c '%U:%G %a' ~/.gnupg}] "$env(LFS_USER):users 700" "the owner of ~/.gnupg"
run_ok {touch ~/.gnupg/probe && rm ~/.gnupg/probe}
logout
