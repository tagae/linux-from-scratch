# The clock, which the Pi has no battery for, goes on from the last minute's save (timesyncd) when the
# machine restarts: a time set, and a minute later, a restart.

login root
run_ok {date -u -s '2031-01-02 03:04:05'}
logout
sleep 65
login user
set before [run_ok {cat /proc/sys/kernel/random/boot_id}]
restart
expect_silence 15 "after the restart"
login root
set after [run_ok {cat /proc/sys/kernel/random/boot_id}]
if {$after eq $before} { fail "the machine did not restart: its boot ID is still $before" }
expect_equal [run_ok {date -u +%Y}] 2031 "the year after the restart"
logout
