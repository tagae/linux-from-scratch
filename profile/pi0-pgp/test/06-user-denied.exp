# The regular account changes nothing else than powering off and restarting: polkit says no, and the
# service stays as it was.

login user
lassign [run {systemctl restart systemd-timesyncd}] output status
expect_match $output {Access denied} "restarting a service"
if {$status == 0} { fail "restarting a service succeeded" }
expect_equal [run_ok {systemctl is-active systemd-timesyncd}] active "the service that was left alone"
logout
