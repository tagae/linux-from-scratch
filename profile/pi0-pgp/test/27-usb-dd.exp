# The kernel refuses to open a mounted partition for writing, even for root's dd. The regular
# account then copies with dd: a file to that partition of the drive, unmounted, whatever it held,
# and the beginning of the stick to another partition. Each copy is read back from its device, past
# the cache, and compared.

login root
run_ok {mount --mkdir -o nosuid,nodev,noexec /dev/sdb1 /tmp/fat}
# count=0 opens the partition and writes nothing, which leaves its file system whole even where the
# kernel allows the opening.
expect_match [run_ok {dd if=/dev/zero of=/dev/sdb1 count=0} 1] {Device or resource busy} \
    "writing to a mounted partition"
run_ok {umount /tmp/fat}
logout

login user
run_ok {dd if=/dev/urandom of=/tmp/data bs=1M count=4 status=none}
set sum [run_ok {sha256sum < /tmp/data}]
run_ok {dd if=/tmp/data of=/dev/sdb1 bs=1M conv=fsync status=none}
expect_equal [run_ok {dd if=/dev/sdb1 bs=1M count=4 iflag=direct status=none | sha256sum}] $sum "the copy of the file"

run_ok {dd if=/dev/sda of=/dev/sdb2 bs=1M count=4 iflag=direct oflag=direct status=none}
set stick [run_ok {dd if=/dev/sda bs=1M count=4 iflag=direct status=none | sha256sum}]
expect_equal [run_ok {dd if=/dev/sdb2 bs=1M count=4 iflag=direct status=none | sha256sum}] $stick "the copy of the stick"
run_ok {rm /tmp/data}
logout
