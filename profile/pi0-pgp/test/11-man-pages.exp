# The manual pages are there, and so is the index that finds them: the page of the system, which the
# message of the day names, among them.

login user
expect_match [run_ok {man ls | head -n 3}] {LS\(1\)} "the page of ls"
expect_match [run_ok {man -w gpg}] {/gpg\.1$} "the file of the page of gpg"
expect_match [run_ok {man -w sfdisk}] {/sfdisk\.8$} "the file of the page of sfdisk"
expect_match [run_ok {man -w mkfs.ext4}] {/mke2fs\.8$} "the file of the page of mkfs.ext4"
expect_match [run_ok {whatis ls}] {ls\(1\) - list directory contents} "whatis"
expect_match [run_ok {apropos pcscd}] {pcscd\(8\) - PC/SC Smart Card Daemon} "apropos"
expect_match [run_ok {cat /etc/motd}] {man pi0-pgp$} "the page that the message of the day names"
# man finds a page that the index lacks as well, with a warning, which the exact output rules out.
expect_equal [run_ok {man -w pi0-pgp}] /usr/share/man/man7/pi0-pgp.7 "the file of the page of the system"
expect_match [run_ok {man pi0-pgp | head -n 3}] {PI0-PGP\(7\)} "the page of the system"
expect_match [run_ok {whatis pi0-pgp}] {pi0-pgp\(7\) - air-gapped system} "whatis of the page of the system"
expect_match [run_ok {apropos OpenPGP | grep '^pi0-pgp'}] {pi0-pgp\(7\)} "apropos of the page of the system"
# Every command has a manual page, but those that no project documents under that name.
expect_equal [run_ok {for f in /usr/bin/* /usr/sbin/*; do n=${f##*/}; set -- /usr/share/man/man[18]/"$n".[18]*; [ -e "$1" ] || printf '%s ' "$n"; done}] {[ awk egrep fgrep getconf gpg-error pinentry pinentry-tty sh} "the commands without a manual page"
# The Linux man-pages are indexed, those of the files of /etc and of the subsections among them.
expect_equal [run_ok {for p in 2:open 3:malloc 3type:size_t 4:null 5:group 5:hosts 5:shells 5:issue 5:motd 5:rpc 7:signal 8:ldconfig; do man -w -s "${p%:*}" "${p#*:}" > /dev/null || echo "$p"; done}] "" "the pages that are missing"
logout
