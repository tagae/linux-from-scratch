#!/bin/sh
# Makes an OpenPGP key, and exports it to a USB stick.
#
# The key is made for a security key such as a YubiKey: a primary key that only certifies, and
# subkeys to sign, to encrypt and to authenticate. The secret key material lives in memory only:
# GnuPG's home is /run/gnupg, a tmpfs that no other user opens and that never swaps
# (run-gnupg.mount). The keys stay in it after the script ends, for `gpg` to list and to edit (to
# move the subkeys to the YubiKey, say), until the Pi powers off. The secret key leaves only on
# the stick, protected by the passphrase.
#
# The stick is the one whose file system has the label KEYS, a FAT file system that systemd mounts
# on /mnt/keys when the script first reads it, and unmounts when it has not been used for a while.
#
# Usage: gpg-genkey -n NAME -e EMAIL [-a ALGO] -p PASSPHRASE
#   -n NAME        Real name of the key's user ID                 ($NAME)
#   -e EMAIL       Email address of the key's user ID             ($EMAIL)
#   -a ALGO        ed25519 (the default; the encryption subkey is cv25519), or an
#                  RSA size such as rsa4096, for every key         ($ALGO)
#   -p PASSPHRASE  Passphrase that protects the secret key         ($PASSPHRASE)
#
# Options can also be given as the environment variables shown, which keeps a passphrase out of
# the process list. Options win over variables.
#
# On success the root of the stick holds:
#   EMAIL-secret.asc   secret key, protected by the passphrase
#   EMAIL-public.asc   public key
#   EMAIL-revoke.asc   revocation certificate
set -eu

ALGO=${ALGO:-ed25519}
KEYS_MOUNT=/mnt/keys

usage() {
    echo "Usage: $(basename "$0") -n NAME -e EMAIL [-a ALGO] -p PASSPHRASE" >&2
    exit 1
}

while getopts ":n:e:a:p:h" opt; do
    case "$opt" in
        n) NAME=$OPTARG ;;
        e) EMAIL=$OPTARG ;;
        a) ALGO=$OPTARG ;;
        p) PASSPHRASE=$OPTARG ;;
        h) usage ;;
        :) echo "gpg-genkey: option -$OPTARG requires an argument" >&2; usage ;;
        \?) echo "gpg-genkey: unknown option -$OPTARG" >&2; usage ;;
    esac
done

: ${NAME:?"gpg-genkey: -n NAME (or \$NAME) is required"}
: ${EMAIL:?"gpg-genkey: -e EMAIL (or \$EMAIL) is required"}
: ${PASSPHRASE:?"gpg-genkey: -p PASSPHRASE (or \$PASSPHRASE) is required"}

# Elliptic curve keys encrypt with Curve25519, whose keys are made apart from the signing ones.
case $ALGO in
    ed25519) ENCR_ALGO=cv25519 ;;
    *)       ENCR_ALGO=$ALGO ;;
esac

# Reading the directory has systemd mount the stick, or fail when there is none.
ls "$KEYS_MOUNT" > /dev/null 2>&1 || {
    echo "gpg-genkey: no USB stick with a FAT file system labelled KEYS" >&2
    exit 1
}
echo "gpg-genkey: stick mounted on $KEYS_MOUNT"

# Everything GnuPG writes is under GNUPGHOME: the keyring, the random pool, the revocation
# certificate. It must be that mount, a tmpfs mounted noswap, and not a directory of a file system
# that can swap: the field after the file system's type and source in /proc/self/mountinfo holds
# the options that `noswap` is among.
GNUPGHOME=/run/gnupg
awk -v root="$GNUPGHOME" '
    $5 == root {
        for (i = 6; $i != "-"; i++) ;
        ok = ($(i + 1) == "tmpfs" && ("," $(i + 3) ",") ~ /,noswap,/)
    }
    END { exit !ok }' /proc/self/mountinfo || {
    echo "gpg-genkey: $GNUPGHOME is not a tmpfs mounted noswap (run-gnupg.mount)" >&2
    exit 1
}
export GNUPGHOME
echo "gpg-genkey: GNUPGHOME=$GNUPGHOME (tmpfs, memory only)"

# The agent keeps the passphrase for ten minutes: it quits when the script ends, however it ends,
# and starts again when gpg next needs it. The keys stay.
trap 'gpgconf --kill gpg-agent 2>/dev/null || true' EXIT
trap 'exit 1' INT TERM HUP

# The passphrase reaches gpg on its standard input, out of the process list, and the agent through
# the loopback pinentry. Keys never expire: this GnuPG rejects the expiration "default".
gpg_batch() {
    printf '%s\n' "$PASSPHRASE" | gpg --batch --pinentry-mode loopback --passphrase-fd 0 "$@"
}

# The fingerprint is the one that gpg reports for the key it makes: the keyring can hold other keys
# of the same address.
STATUS=$(gpg_batch --status-fd 1 --quick-generate-key "$NAME <$EMAIL>" "$ALGO" cert 0)
FPR=$(printf '%s\n' "$STATUS" | awk '$2 == "KEY_CREATED" { print $4 }')
[ -n "$FPR" ] || {
    echo "gpg-genkey: gpg did not report the key it made" >&2
    exit 1
}
gpg_batch --quick-add-key "$FPR" "$ALGO" sign 0
gpg_batch --quick-add-key "$FPR" "$ENCR_ALGO" encr 0
gpg_batch --quick-add-key "$FPR" "$ALGO" auth 0
echo "gpg-genkey: key $FPR generated in memory for $EMAIL"

gpg_batch --armor --export-secret-keys "$FPR" > "$KEYS_MOUNT/$EMAIL-secret.asc"
gpg --armor --export "$FPR" > "$KEYS_MOUNT/$EMAIL-public.asc"

# Making the primary key stored a revocation certificate, which is how GnuPG makes one without
# asking questions on a terminal.
cp "$GNUPGHOME/openpgp-revocs.d/$FPR.rev" "$KEYS_MOUNT/$EMAIL-revoke.asc"

sync
echo "gpg-genkey: exported the secret and public keys and the revocation certificate to $KEYS_MOUNT"
echo "gpg-genkey: done: the stick is safe to pull out ten seconds after this"
echo "gpg-genkey: the keys stay in memory, in $GNUPGHOME, until the Pi powers off"
