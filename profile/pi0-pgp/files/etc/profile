# Prompt: user@host:directory, with # for root
PS1='\u@\h:\w\$ '

# The regular account formats sticks with mkfs.fat and blkid, which are in sbin: login gives only
# root a path that has it.
case :$PATH: in *:/usr/sbin:*) ;; *) PATH=$PATH:/usr/sbin ;; esac

# The terminal at the other end of the serial console is taken to speak UTF-8, as the issue does.
# Programs, tmux among them, otherwise take it for one of ASCII.
export LANG=C.UTF-8

# bash's history is longer than its default, and leaves out a line that repeats the one before it or
# starts with a space.
if [ -n "${BASH_VERSION:-}" ]; then
    HISTSIZE=1000
    HISTCONTROL=ignoreboth
fi
