[Unit]
Description=Memory-only home for GnuPG

[Mount]
What=tmpfs
Where=/run/gnupg
Type=tmpfs
# noswap keeps the pages off any swap that the kernel has: a tmpfs without it, /dev/shm and /run
# among them, can write its files to disk. Only the regular account (UID 1000) opens the directory,
# and nothing runs from it. A keyring is a few kilobytes: the size stops a runaway write from taking
# the memory.
Options=noswap,nosuid,nodev,noexec,mode=0700,uid=1000,gid=999,size=8M
