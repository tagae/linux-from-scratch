FROM alpine:3.23.4

RUN delgroup dialout # conflicts with macOS

RUN apk update
RUN apk add build-base git rsync bison gawk python3 # grep file patchelf

ARG HOST_UID
ARG HOST_GID
RUN addgroup -g $HOST_GID lfs
RUN adduser -D -H -u $HOST_UID -G lfs lfs

RUN mkdir -pv \
    /var/lfs/download \
    /var/lfs/image \
    /var/lfs/install \
    /var/lfs/lib \
    /var/lfs/package \
    /var/lfs/source \
    /var/lfs/tools \
    /var/lfs/work

RUN chown lfs:lfs \
    /var/lfs \
    /var/lfs/download \
    /var/lfs/image \
    /var/lfs/install \
    /var/lfs/lib \
    /var/lfs/package \
    /var/lfs/source \
    /var/lfs/tools \
    /var/lfs/work

USER lfs
WORKDIR /var/lfs
