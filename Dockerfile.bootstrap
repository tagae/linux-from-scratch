FROM debian:stable-slim

RUN groupdel dialout # conflicts with macOS

RUN apt update
RUN apt install -y build-essential curl wget rsync gawk bison python3 patchelf ca-certificates \
    # busybox: gives tests/syntax-ash.sh a real ash to parse scripts with
    # (see there) even before any LFS build exists to provide this
    # project's own static one -- Debian's busybox package installs
    # alongside coreutils/dash rather than replacing them, so this is a
    # pure addition, not a behavior change for anything bootstrap already
    # does.
    busybox

ARG HOST_UID
ARG HOST_GID
RUN groupadd --gid $HOST_GID lfs
RUN useradd --uid $HOST_UID --no-user-group --groups lfs --home-dir /mnt/lfs --no-create-home lfs

# State dirs under /var/lfs (the unified layout, see lfs): pre-created
# and owned by the build user so docker's fresh-volume seeding copies
# this ownership into newly created named volumes.
RUN mkdir -pv \
    /var/lfs/source \
    /var/lfs/tools \
    /var/lfs/work \
    /var/lfs/install \
    /mnt/lfs/download \
    /mnt/lfs/image \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

RUN chown lfs:lfs \
    /var/lfs \
    /var/lfs/source \
    /var/lfs/tools \
    /var/lfs/work \
    /var/lfs/install \
    /mnt/lfs \
    /mnt/lfs/download \
    /mnt/lfs/image \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

USER lfs
WORKDIR /mnt/lfs
