FROM debian:bookworm-slim

ARG HOST_UID
ARG HOST_GID

# Provision user.
RUN groupdel dialout # Conflicts with macOS.
RUN groupadd --gid $HOST_GID lfs
RUN useradd --uid $HOST_UID --no-user-group --groups lfs --home-dir /mnt/lfs --no-create-home lfs

# Provision build tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    wget \
    rsync \
    gawk \
    bison \
    python3 \
    patchelf \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create mount points.
RUN mkdir -pv \
    /mnt/lfs/download \
    /mnt/lfs/feature \
    /mnt/lfs/image \
    /mnt/lfs/install \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/platform \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

# Docker copies this ownership into newly created named volumes.
RUN chown lfs:lfs \
    /mnt/lfs \
    /mnt/lfs/download \
    /mnt/lfs/feature \
    /mnt/lfs/image \
    /mnt/lfs/install \
    /mnt/lfs/lib \
    /mnt/lfs/package \
    /mnt/lfs/platform \
    /mnt/lfs/source \
    /mnt/lfs/tools \
    /mnt/lfs/work

USER lfs
WORKDIR /mnt/lfs
